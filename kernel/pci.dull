-- PCI Express through ECAM (configuration space as memory): find a device by its
-- class code and give it an address for its registers. Used on QEMU's virt board
-- (run with highmem=off: ECAM at 0x3F00_0000, a window for devices at 0x1000_0000).
-- On the Pi 5 the firmware sets up the one PCIe link that matters (to RP1).

new ecam u64
new window u64
new window_end u64

to setup (ecam_base u64, window_base u64, window_size u64)
    ecam = ecam_base
    window = window_base
    window_end = window_base + window_size

to config (slot u64, offset u64) gives ptr u32
    give (ecam + (slot << 15) + offset) as ptr u32

-- The `n`th device on bus 0 whose class/subclass/interface is `class` (e.g. 0x0C0330,
-- an xHCI USB controller). Its first BAR gets an address, memory decoding and bus
-- mastering get switched on, and that address is given (0 if there is none).
to find (class u32, n u32) gives u64
    if ecam is 0
        give 0
    new seen u32 = 0
    for each d in 0 until 32 as u64
        new id = deref config(d, 0)
        if id is 0xFFFF_FFFF or id is 0
            skip
        if (deref config(d, 8)) >> 8 is not class
            skip
        if seen is not n
            seen += 1
            skip
        give claim(d)
    give 0

to claim (d u64) gives u64
    new bar = config(d, 0x10)
    new kind = deref bar
    deref bar = 0xFFFF_FFFF
    new mask = (deref bar) & 0xFFFF_FFF0
    new is64 = (kind >> 1) & 3 is 2
    new size = ((mask ^ 0xFFFF_FFFF) as u64 + 1) & 0xFFFF_FFFF
    if size is 0
        give 0
    new address = (window + size - 1) & ((size - 1) ^ 0xFFFF_FFFF_FFFF_FFFF)
    if address + size > window_end
        give 0
    window = address + size
    deref bar = address as u32
    if is64
        deref config(d, 0x14) = 0
    new command = config(d, 4)
    deref command = (deref command) | 0x6           -- memory space, bus master
    give address
