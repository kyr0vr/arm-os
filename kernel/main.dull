-- The ArmOS kernel. Phase 10: USB keyboards and mice.
--
-- Brings the machine up step by step and checks each step: exception level,
-- exceptions, memory, the MMU and caches, interrupts and the timer, all four cores.
-- The boot screen shows it happening (the arrow through the A is the progress bar,
-- and the facts beside it are read from the hardware). Then the first app, the
-- launcher, starts at EL0 and the kernel only answers system calls and interrupts
-- (and shows whichever app is in front) from then on.
-- Builds for the Raspberry Pi 5 (rt/pi5) and QEMU (rt/virt).

use io
use board
use fb
use trap
use pages
use heap
use mmu
use gic
use timer
use smp
use selftest
use text
use fetch
use facts
use tty
use proc
use xhci

elsewhere to arch_drop_to_el1
elsewhere to arch_current_el gives u64
elsewhere to arch_install_vectors
elsewhere to arch_irq_on

new failures u64
new canvas text.canvas
new have_canvas bool
new screen fb.screen

to check (ok bool, what string)
    if ok
        io.print("  ok    ")
    else
        io.print("  FAIL  ")
        failures += 1
    io.line(what)

-- Redraw the boot screen at `permille` progress with `rows` facts showing.
to progress (permille u32, rows u32)
    if not have_canvas
        give
    facts.uptime(fetch.value(3))
    new t0 = timer.now()
    fetch.step(addr of canvas, permille, rows)
    text.present_all(addr of canvas, addr of screen)
    io.print("  boot screen: ")
    io.print_u64(permille as u64 / 10)
    io.print("% drawn in ")
    io.print_u64(timer.micros(t0, timer.now()) / 1000)
    io.line(" ms")

to main
    facts.boot_time = timer.now()
    io.line("")
    io.line("========================================")
    io.line(" ArmOS - a rather mundane operating system")
    io.line(" phase 10: USB input")
    io.line("========================================")

    -- exception level
    new boot_el = arch_current_el()
    arch_drop_to_el1()
    io.print("started at EL")
    io.print_u64(boot_el)
    io.print(", kernel runs at EL")
    io.print_u64(arch_current_el())
    io.line("")
    check(arch_current_el() is 1, "running at EL1")

    -- exceptions
    arch_install_vectors()
    asm "brk #1"
    check(trap.breakpoints is 1, "a test breakpoint was caught and stepped over")

    -- the screen and the board, while firmware calls still see memory directly
    new have_screen = fb.open(1920, 1080, addr of screen)
    board.probe()
    facts.screen_w = screen.width
    facts.screen_h = screen.height
    facts.screen_depth = screen.depth

    -- memory
    board.add_ram()
    io.print("memory: ")
    io.print_u64(pages.available() * 4 / 1024)
    io.line(" MB free for the kernel")
    check(pages.available() > 256, "the page allocator has memory")

    -- the MMU and caches
    new slow = selftest.busy_work()
    if not mmu.build()
        check(false, "page tables built")
        board.idle()
    if have_screen
        mmu.uncached(screen.base as u64, (screen.pitch as u64) * (screen.height as u64))
    mmu.enable()
    new fast = selftest.busy_work()
    io.print("MMU and caches on: a test loop took ")
    io.print_u64(timer.micros(0, slow))
    io.print(" us before, ")
    io.print_u64(timer.micros(0, fast))
    io.line(" us after")
    check(read_sysreg(sctlr_el1) & 5 is 5, "MMU and data cache enabled")

    -- the boot screen: what is known so far
    if have_screen and screen.depth is 32
        have_canvas = text.make(addr of canvas, screen.width, screen.height)
    facts.os(fetch.value(0))
    facts.host(fetch.value(1))
    facts.kernel(fetch.value(2))
    progress(120, 3)

    check(selftest.page_allocator(), "page allocator: alloc, free, reuse")
    check(selftest.heap_allocator(), "heap: 9 sizes, zeroed, no overlaps, reuse")
    progress(300, 4)

    -- interrupts and the timer
    gic.init(board.gic_dist, board.gic_cpu)
    timer.start(100)
    arch_irq_on()
    new t0 = timer.now()
    new deadline = t0 + timer.frequency() * 2
    while timer.ticks < 50 and timer.now() < deadline
        wfi()
    new took = timer.micros(t0, timer.now())
    io.print("timer: ")
    io.print_u64(timer.ticks)
    io.print(" ticks in ")
    io.print_u64(took / 1000)
    io.line(" ms (100 per second)")
    check(timer.ticks >= 50 and took > 400_000 and took < 600_000, "timer interrupts arrive on time")
    progress(480, 4)

    -- the other cores
    new others = smp.start(board.cores, board.psci_smc(boot_el))
    check(others is board.cores - 1, "all four cores running")
    facts.cpu(fetch.value(4))
    facts.gpu(fetch.value(5))
    progress(660, 6)

    -- USB keyboards and mice
    new found = 0 as u64
    repeat
        new base = board.usb_controller(found)
        if base is 0
            stop
        board.usb_prepare(base)
        xhci.add(base)
        found += 1
    io.print("usb: ")
    io.print_u64(xhci.keyboards as u64)
    io.print(" keyboard(s), ")
    io.print_u64(xhci.mice as u64)
    io.line(" mouse/mice")

    facts.memory(fetch.value(6))
    facts.display(fetch.value(7))
    progress(840, 8)

    facts.lang(fetch.value(8))
    facts.shell_name(fetch.value(9))
    progress(1000, 10)

    if failures is 0
        io.line("kernel core: all checks passed")
    else
        io.print("kernel core: ")
        io.print_u64(failures)
        io.line(" check(s) failed")

    board.save_screen(addr of screen, 0)
    tty.start(addr of canvas, addr of screen, have_canvas)
    io.line("")
    proc.start("launcher")
