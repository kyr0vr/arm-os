-- ArmOS phase 1: say hello over the debug UART and paint the screen.

use io
use fb
use board

to main
    io.line("")
    io.line("========================================")
    io.line(" ArmOS - a rather mundane operating system")
    io.line(" phase 1: DULL running on a Raspberry Pi 5")
    io.line("========================================")
    io.print("exception level: EL")
    io.print_u64(read_sysreg(CurrentEL) >> 2)
    io.line("")

    new s fb.screen
    if not fb.open(1920, 1080, addr of s)
        io.print("framebuffer: the firmware refused (reply ")
        io.print_hex(fb.last_reply as u64)
        io.print(", address ")
        io.print_hex(fb.last_addr as u64)
        io.line(") - is HDMI plugged in?")
        board.idle()
    io.print("framebuffer: ")
    io.print_u64(s.width as u64)
    io.print(" x ")
    io.print_u64(s.height as u64)
    io.print(", pitch ")
    io.print_u64(s.pitch as u64)
    io.print(", order ")
    io.print_u64(s.order as u64)
    io.print(", depth ")
    io.print_u64(s.depth as u64)
    io.print(", at ")
    io.print_hex(s.base as u64)
    io.line("")

    if s.depth is not 32
        io.line("framebuffer: not 32 bits per pixel - check framebuffer_depth in config.txt")
        board.idle()
    new red = fb.color(addr of s, 255, 0, 0)
    new green = fb.color(addr of s, 0, 255, 0)
    new blue = fb.color(addr of s, 0, 0, 255)
    new third = s.width / 3
    fb.fill_rect(addr of s, 0, 0, third, s.height, red)
    fb.fill_rect(addr of s, third, 0, third, s.height, green)
    fb.fill_rect(addr of s, third * 2, 0, s.width - third * 2, s.height, blue)
    io.line("screen painted: red | green | blue")
    io.line("ArmOS is alive.")
    board.idle()
