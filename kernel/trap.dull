-- Exceptions: every one lands in `handle`, called from kernel/arch.s with the saved
-- registers (`frame`: x0..x30, then ELR, SPSR and SP_EL0) and the vector table entry
-- number. `handle` gives the frame to resume: the same one, or another process's.

use io
use board
use gic
use timer
use proc
use syscall
use gui
use helper

fixed elr_slot u64 = 31
fixed brk_class u64 = 0x3C
fixed svc_class u64 = 0x15

fixed kinds   [4] string = ["sync", "IRQ", "FIQ", "SError"]
fixed sources [4] string = ["EL1 with SP0", "EL1", "EL0 (64-bit)", "EL0 (32-bit)"]

new breakpoints u64       -- `brk` instructions caught and stepped over (the self-test uses one)

to handle (frame ptr u64, entry u64) gives ptr u64
    new which = read_sysreg(tpidr_el1)
    if which is not 0
        give helper.trap(which, frame, entry)
    if entry is 5 or entry is 9           -- an interrupt (in the kernel, or in an app)
        new iar = gic.ack()
        new id = iar & 0x3FF
        new is_timer = id is timer.irq
        if is_timer
            timer.tick()
        if id < 1020
            gic.done(iar)
        if is_timer and proc.running
            give gui.settle(proc.tick(frame))
        give frame
    new esr = read_sysreg(esr_el1)
    if entry is 8                         -- an app: a system call, or a fault
        if esr[31:26] is svc_class
            give gui.settle(syscall.handle(frame))
        give gui.settle(proc.crashed(frame, esr, read_sysreg(far_el1)))
    if entry is 4 and esr[31:26] is brk_class
        breakpoints += 1
        frame[elr_slot] = frame[elr_slot] + 4
        give frame
    io.line("")
    io.print("exception: ")
    io.print(kinds[entry % 4])
    io.print(" from ")
    io.line(sources[entry / 4])
    io.print("  ESR ")
    io.print_hex(esr)
    io.print("  (class ")
    io.print_hex(esr[31:26])
    io.line(")")
    io.print("  ELR ")
    io.print_hex(frame[elr_slot])
    io.print("  FAR ")
    io.print_hex(read_sysreg(far_el1))
    io.line("")
    io.line("stopped")
    board.idle()
    give frame
