-- expect: found 3
-- expect: missing
-- expect: 42 -1
-- expect: 1 3 5
-- expect: ok 7
-- expect: none

use io

fixed names [4] u32 = [10, 20, 30, 40]

to find (v u32) gives maybe u64
    for each i in 0 until 4
        if names[i] is v
            give i
    give nothing

to report (v u32)
    new i = find(v) else give
    io.print("found ")
    io.print_u64(i)
    io.line("")

to half (v u32) gives maybe u32
    if v % 2 is 1
        give nothing
    give v / 2

to first_ptr (p ptr u8, ok bool) gives maybe ptr u8
    if ok
        give p
    give nothing

to main gives u8
    report(40)
    if find(5) is nothing
        io.line("missing")
    new a i64 = 42
    new m maybe i64 = a
    new z maybe i64 = nothing
    io.print_i64(m else 0)
    io.put(' ')
    io.print_i64(z else -1)
    io.line("")

    new six u32 = 6
    for each v in 1 through six
        new h = half(v + 1) else skip
        io.print_u64(h as u64 * 2 - 1)
        if h < 3
            io.put(' ')
    io.line("")

    new b u8 = 7
    new p = first_ptr(addr of b, true) else give 1
    io.print("ok ")
    io.print_u64(deref p as u64)
    io.line("")
    if first_ptr(addr of b, false) is nothing
        io.line("none")
    give 0
