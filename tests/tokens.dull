-- expect: word new
-- expect: word total
-- expect: word u32
-- expect: sym =
-- expect: num 42
-- expect: sym ->
-- expect: word show
-- expect: 7 tokens

use io

choice kind
    word
    num
    sym

shape token
    kind  kind
    text  string

to is_alpha (c u8) gives bool
    give (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c is '_'

to is_digit (c u8) gives bool
    give c >= '0' and c <= '9'

to next_token (src string, pos ptr u64, out ptr token) gives bool
    new i = deref pos
    while i < src.len and src[i] is ' '
        i += 1
    if i >= src.len
        give false
    new start = i
    new c = src[i]
    if is_alpha(c)
        out.kind = kind.word
        while i < src.len and (is_alpha(src[i]) or is_digit(src[i]))
            i += 1
    else if is_digit(c)
        out.kind = kind.num
        while i < src.len and is_digit(src[i])
            i += 1
    else
        out.kind = kind.sym
        i += 1
        if c is '-' and i < src.len and src[i] is '>'
            i += 1
    out.text = src[start until i]
    deref pos = i
    give true

to kind_name (k kind) gives string
    if k is kind.word
        give "word"
    if k is kind.num
        give "num"
    give "sym"

to main gives u8
    new src string = "new total u32 = 42 -> show"
    new pos u64 = 0
    new t token
    new count u32 = 0
    while next_token(src, addr of pos, addr of t)
        io.print(kind_name(t.kind))
        io.put(' ')
        io.line(t.text)
        count += 1
    io.print_u64(count as u64)
    io.line(" tokens")
    give 0
