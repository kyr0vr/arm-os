-- expect: big
-- expect: 0 1 2 3 4
-- expect: 1 2 3
-- expect: 10 9 8
-- expect: 1 3 5 7 9
-- expect: 15
-- expect: h-e-y
-- expect: 6
-- expect: 3 4 5
-- expect: 255

use io

to main gives u8
    new n u32 = 50
    if n < 10
        io.line("small")
    else if n < 20
        io.line("medium")
    else
        io.line("big")

    for each i in 0 until 5
        io.print_u64(i)
        if i < 4
            io.put(' ')
    io.line("")

    for each i in 1 through 3
        io.print_u64(i)
        io.put(' ')
    io.line("")

    new k i32 = 10
    while k > 7
        io.print_i64(k as i64)
        io.put(' ')
        k -= 1
    io.line("")

    new j u32 = 0
    repeat
        j += 1
        if j > 9
            stop
        if j % 2 is 0
            skip
        io.print_u64(j as u64)
        io.put(' ')
    io.line("")

    new total u8 = 0
    new five u8 = 5
    for each v in 1 through five
        total += v
    io.print_u64(total as u64)
    io.line("")

    new first = true
    for each ch in "hey"
        if not first
            io.put('-')
        first = false
        io.put(ch)
    io.line("")

    new arr [3] u16 = [1, 2, 3]
    new sum u16 = 0
    for each v in arr
        sum += v
    io.print_u64(sum as u64)
    io.line("")

    new lo i8 = 3
    for each i in lo through 5
        io.print_i64(i as i64)
        io.put(' ')
    io.line("")

    new top u8 = 255
    for each i in 250 through top
        total = i
    io.print_u64(total as u64)
    io.line("")
    give 0
