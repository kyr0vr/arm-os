-- Text: the ArmOS text reader. Browse the SD card's folders and .txt files, open
-- one, and read it word-wrapped to the screen, a line or a page at a time.

use sys
use gfx
use keys
use line
use mem
use vec
use ui
use files

-- ---------------------------------------------------------------- reading

fixed body_y u32 = 176
fixed line_h u32 = 34
fixed max_file u64 = 0x200_0000        -- 32 MB

new file ptr u8
new file_size u64
new starts ptr vec.vec         -- where each screen line begins
new top u64
new rows u64
new cols u64

-- Break the file into screen lines: at line ends, and at the last space before
-- the right edge (or anywhere, for a word longer than a line).
to wrap
    starts = vec.make()
    vec.push(starts, 0)
    new col u64 = 0
    new line_start u64 = 0
    new last_space u64 = 0
    new have_space = false
    for each i in 0 until file_size
        new c = file[i]
        if c is '\n'
            vec.push(starts, i + 1)
            line_start = i + 1
            col = 0
            have_space = false
            skip
        if c is '\r'
            skip
        if c is ' ' or c is '\t'
            last_space = i
            have_space = true
        col += 1
        if col > cols
            new next = i
            if have_space and last_space >= line_start
                next = last_space + 1
            vec.push(starts, next)
            line_start = next
            col = i + 1 - next
            have_space = false
    if starts.len > 1 and vec.last(starts) >= file_size
        vec.pop(starts)

to line_count gives u64
    give starts.len

-- Screen line `n` as display text (tabs as spaces, other control bytes as '?').
to screen_line (n u64, into ptr line.line)
    line.clear(into)
    new a = vec.get(starts, n)
    new b = file_size
    if n + 1 < starts.len
        b = vec.get(starts, n + 1)
    for each i in a until b
        new c = file[i]
        if c is '\n' or c is '\r'
            skip
        if c is '\t'
            c = ' '
        if c < 32 or c >= 127
            c = '?'
        line.byte(into, c)

to draw_page (name string)
    -- header: the name, where we are, a progress bar
    ui.title(name, "")
    new last = top + rows
    if last > line_count()
        last = line_count()
    new l line.line
    line.add(addr of l, "lines ")
    line.number(addr of l, top + 1)
    line.byte(addr of l, '-')
    line.number(addr of l, last)
    line.add(addr of l, " of ")
    line.number(addr of l, line_count())
    new t = line.text(addr of l)
    ui.title_right(t, ui.muted)
    new bar_w = gfx.width - ui.margin * 2
    new done = bar_w
    if line_count() > 0
        done = ((bar_w as u64) * last / line_count()) as u32
    gfx.fill(ui.margin, 140, done, 2, ui.amber)
    -- the text
    gfx.fill(0, body_y - 20, gfx.width, ui.footer_y - body_y, ui.bg)
    for each r in 0 until rows
        new n = top + r
        if n >= line_count()
            stop
        new s line.line
        screen_line(n, addr of s)
        gfx.text(ui.margin, body_y + (r as u32) * line_h, line.text(addr of s), gfx.regular, ui.putty)
    -- the scroll bar
    new track_x = gfx.width - ui.margin + 40
    new track_h = (rows as u32) * line_h
    gfx.round_rect(track_x, body_y, 8, track_h, 4, ui.slot)
    if line_count() > rows
        new thumb = ((track_h as u64) * rows / line_count()) as u32
        if thumb < 40
            thumb = 40
        new travel = track_h - thumb
        new offset = ((travel as u64) * top / (line_count() - rows)) as u32
        gfx.round_rect(track_x, body_y + offset, 8, thumb, 4, ui.amber)
    else
        gfx.round_rect(track_x, body_y, 8, track_h, 4, ui.dim)
    -- keys
    ui.clear_footer()
    new x = ui.hint(ui.margin, "Up/Down", "line")
    x = ui.hint(x, "Space/b", "page")
    x = ui.hint(x, "g/G", "start/end")
    ui.hint(x, "q", "back to the list")
    gfx.present_all()

to load (path ptr line.line, size u64) gives bool
    if size > max_file
        size = max_file
    file = mem.alloc(size + 1)
    file_size = 0
    while file_size < size
        new want = size - file_size
        if want > 0x10_0000
            want = 0x10_0000
        new n = sys.read(line.text(path), file_size, file + file_size, want)
        if n <= 0
            stop
        file_size += n as u64
    give true

to read (path ptr line.line, size u64)
    if not load(path, size)
        give
    cols = ((gfx.width - ui.margin * 2) / gfx.advance(gfx.regular)) as u64
    rows = ((ui.footer_y - 40 - body_y) / line_h) as u64
    wrap()
    top = 0
    new name string
    name = line.text(path)
    new cut u64 = 0
    for each i in 0 until name.len
        if name[i] is '/'
            cut = i + 1
    name = name[cut until name.len]
    draw_page(name)
    repeat
        new k = keys.next()
        new before = top
        new end_top u64 = 0
        if line_count() > rows
            end_top = line_count() - rows
        if k is keys.pointer_moved or k is keys.left_down or k is keys.left_up or k is keys.right_up
            skip
        if k is keys.wheel_down
            top += 3
        else if k is keys.wheel_up
            if top > 3
                top -= 3
            else
                top = 0
        else if k is keys.right_down
            give
        else if k is keys.down or k is 'j' as u32 or k is keys.enter
            top += 1
        else if k is keys.up or k is 'k' as u32
            if top > 0
                top -= 1
        else if k is keys.page_down or k is ' ' as u32 or k is keys.right
            top += rows
        else if k is keys.page_up or k is 'b' as u32 or k is keys.left
            if top > rows
                top -= rows
            else
                top = 0
        else if k is keys.home or k is 'g' as u32
            top = 0
        else if k is keys.finish or k is 'G' as u32
            top = end_top
        else if k is 'q' as u32 or k is keys.escape or k is keys.backspace
            give
        if top > end_top
            top = end_top
        if top is not before
            draw_page(name)

-- ---------------------------------------------------------------- start

to main gives u64
    if not gfx.open()
        sys.print("text: no screen\n")
        give 1
    sys.want_pointer(true)
    files.setup("Text", ".txt")
    new path line.line
    new size u64 = 0
    while files.browse(addr of path, addr of size)
        read(addr of path, size)
    give 0
