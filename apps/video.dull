-- Video: the ArmOS video player. Choose an .mp4 file (H.264 video, AAC sound) on the
-- SD card and it plays full screen, the sound keeping time.
--
-- `video play <file>` plays one file and ends. `video bench <file> [frames]` decodes
-- a file (or its first frames) as fast as it can, without sound or waiting, and
-- prints how fast that was and a checksum of the pictures (to the serial console);
-- `video bench1` does the same on this core alone.

use sys
use gfx
use keys
use line
use mem
use ui
use files
use mp4
use h264
use h264state
use aac
use h264par
use helpers

new handle i64
new movie ptr mp4.movie
new vt ptr mp4.track
new at_track ptr mp4.track
new vd ptr h264state.decoder
new ad ptr aac.decoder
new vnext u64                  -- next video sample to decode
new anext u64                  -- next audio sample
new sample ptr u8              -- a buffer for one sample
new sample_cap u64
new pcm [2048] i16
new packed [1024] u32
new have_sound bool
new rate u32
new audio_frames u64           -- sound frames handed to the kernel since the start (or seek)
new audio_base_ms u64          -- the movie time those frames start at
new paused bool
new ended bool
-- presentation times (ms) of decoded pictures not shown yet, smallest first
new pending [64] u64
new npending u64
-- the picture converted into the surface, waiting for its time
new ready bool
new ready_ms u64
-- statistics
new decoded u64
new last_pic ptr h264state.picture       -- the picture next_picture found
new use_helpers bool                     -- rebuild pictures on helper cores (bench1: not)
new shown u64
new dropped u64
new skipped u64
new decode_ms u64
new convert_ms u64
new present_ms u64                      -- putting pictures on the screen
new converting bool                     -- the lanes are turning a picture into pixels
new first_late i64                      -- how late the first picture was (ms; negative: early)
new worst_late u64
new sound_ms u64                        -- decoding and queueing sound
new message line.line
new name line.line
new overlay_until u64
-- where the picture goes on the screen
new dst_x u32
new dst_y u32
new dst_w u32
new dst_h u32
new bt709 bool
new placed bool

-- ---------------------------------------------------------------- the file

to read_at (offset u64, into ptr u8, count u64) gives bool
    give sys.read_open(handle, offset, into, count) is count as i64

to be32 (p ptr u8) gives u64
    give mp4.be32(p) as u64

-- Open `path`, find its moov box, the tracks and set up the decoders.
to load (path ptr line.line) gives bool
    line.clear(addr of message)
    handle = sys.open(line.text(path))
    if handle < 0
        line.add(addr of message, "Cannot open the file.")
        give false
    new size = sys.file_size(handle)
    new head [16] u8
    new pos u64 = 0
    new moov = 0 as ptr u8
    new moov_size u64 = 0
    while pos + 8 <= size
        if not read_at(pos, addr of head[0], 16)
            stop
        new box = be32(addr of head[0])
        new hlen u64 = 8
        if box is 1
            box = mp4.be64(addr of head[8])
            hlen = 16
        else if box is 0
            box = size - pos
        if box < hlen
            stop
        if mp4.named(addr of head[4], "moov")
            moov_size = box - hlen
            moov = mem.alloc(moov_size + 8)
            if not read_at(pos + hlen, moov, moov_size)
                moov = 0 as ptr u8
            stop
        pos += box
    if moov as u64 is 0
        line.add(addr of message, "Not an MP4 file (no moov box).")
        give false
    movie = mp4.make()
    if not mp4.parse(movie, moov, moov_size)
        line.add(addr of message, "This MP4 file could not be read.")
        give false
    vt = 0 as ptr mp4.track
    at_track = 0 as ptr mp4.track
    for each i in 0 until movie.ntracks
        new t = addr of movie.tracks[i]
        if t.kind is mp4.video and vt as u64 is 0
            vt = t
        if t.kind is mp4.audio and at_track as u64 is 0 and t.config as u64 is not 0
            at_track = t
    if vt as u64 is 0
        line.add(addr of message, "No H.264 video in this file.")
        give false
    if vd as u64 is not 0
        h264par.stop_lanes(vd)
    vd = h264.make()
    -- two helper cores rebuild pictures while this one parses
    new started u64 = 0
    if use_helpers
        for each i in 0 until 2
            if helpers.start(h264par.lane_function(), h264par.lane_arg(vd, started)) is not 0
                started += 1
    h264par.use_lanes(vd, started)
    new c = vt.config
    new p u64 = 6
    for each k in 0 until (c[5] & 31) as u64
        new len = mp4.be16(c + p) as u64
        h264.nal(vd, c + p + 2, len)
        p += 2 + len
    new npps = c[p] as u64
    p += 1
    for each k in 0 until npps
        new len = mp4.be16(c + p) as u64
        h264.nal(vd, c + p + 2, len)
        p += 2 + len
    have_sound = false
    if at_track as u64 is not 0
        ad = aac.make()
        if aac.configure(ad, at_track.config, at_track.config_size)
            rate = ad.rate
            have_sound = sys.audio_start(rate)
    vnext = 0
    anext = 0
    audio_frames = 0
    audio_base_ms = 0
    npending = 0
    ready = false
    ended = false
    decoded = 0
    shown = 0
    dropped = 0
    skipped = 0
    decode_ms = 0
    convert_ms = 0
    present_ms = 0
    sound_ms = 0
    give true

to fetch (t ptr mp4.track, i u64) gives ptr u8
    new size = t.sizes[i] as u64
    if size + 16 > sample_cap
        sample_cap = size + 65536
        sample = mem.alloc(sample_cap)
    if not read_at(t.offsets[i], sample, size)
        give 0 as ptr u8
    give sample

to ms_of (t ptr mp4.track, time u64) gives u64
    give time * 1000 / (t.timescale as u64)

-- ---------------------------------------------------------------- sound

-- The movie time now (ms): from the sound that has been played, or the clock.
new wall_start u64

to now_ms gives u64
    if have_sound
        new q = sys.audio_queued()
        new played u64 = 0
        if audio_frames > q
            played = audio_frames - q
        give audio_base_ms + played * 1000 / (rate as u64)
    give sys.time() - wall_start

to feed_audio
    if not have_sound or paused
        give
    new want = (rate as u64) * 300 / 1000
    while sys.audio_queued() < want and anext < at_track.count
        new data = fetch(at_track, anext)
        anext += 1
        if data as u64 is 0
            skip
        new n = aac.frame(ad, data, at_track.sizes[anext - 1] as u64, addr of pcm[0])
        for each i in 0 until n
            packed[i] = ((pcm[i * 2] as u32) & 0xFFFF) | (((pcm[i * 2 + 1] as u32) & 0xFFFF) << 16)
        new sent u64 = 0
        while sent < n
            new took = sys.audio_write(addr of packed[sent], n - sent)
            sent += took
            if took is 0
                sys.sleep(5)
        audio_frames += n

-- ---------------------------------------------------------------- pictures

to push_pending (ms u64)
    if npending >= 64
        give
    new i = npending
    while i > 0 and pending[i - 1] > ms
        pending[i] = pending[i - 1]
        i -= 1
    pending[i] = ms
    npending += 1

to pop_pending gives u64
    if npending is 0
        give 0
    new v = pending[0]
    for each i in 1 until npending
        pending[i - 1] = pending[i]
    npending -= 1
    give v

to place
    new w = h264.width(vd)
    new h = h264.height(vd)
    -- fit the screen, keeping the shape
    dst_w = gfx.width
    dst_h = ((h as u64) * (gfx.width as u64) / (w as u64)) as u32
    if dst_h > gfx.height
        dst_h = gfx.height
        dst_w = ((w as u64) * (gfx.height as u64) / (h as u64)) as u32
    dst_x = (gfx.width - dst_w) / 2
    dst_y = (gfx.height - dst_h) / 2
    bt709 = h > 576
    tables()

-- Colour conversion tables (set up by `place`): each Y, U and V value's share of R,
-- G and B, pre-scaled by 256 (Y's with 320 added), and `level` turning a sum >> 8 into
-- 0..255. With them a pixel is a few lookups and adds.
new ty [256] i32
new tr [256] i32
new tgu [256] i32
new tgv [256] i32
new tb [256] i32
new level [1024] u32
new xmap ptr u32                        -- source column of each screen column
new xmap_len u64
new rowbufs [3] u64                     -- per conversion part: one source row in RGB
new rowbuf_len u64

to tables
    new kr i32 = 409
    new kgu i32 = 100
    new kgv i32 = 208
    new kb i32 = 516
    if bt709
        kr = 459
        kgu = 55
        kgv = 136
        kb = 541
    for each i in 0 until 256
        new v = i as i32 - 128
        ty[i] = 298 * (i as i32 - 16) + 128 + 320 * 256        -- offset: every sum >> 8 is 30 or more
        tr[i] = kr * v
        tgu[i] = 0 - kgu * v
        tgv[i] = 0 - kgv * v
        tb[i] = kb * v
    for each i in 0 until 1024
        new v = i as i32 - 320
        if v < 0
            v = 0
        else if v > 255
            v = 255
        level[i] = v as u32
    new w = h264.width(vd) as u64
    if dst_w as u64 > xmap_len
        xmap = mem.alloc((dst_w as u64) * 4) as ptr u32
        xmap_len = dst_w as u64
    for each ox in 0 until dst_w as u64
        xmap[ox] = (ox * w / (dst_w as u64)) as u32
    if w > rowbuf_len
        for each k in 0 until 3
            rowbufs[k] = mem.alloc(w * 4) as u64
        rowbuf_len = w

-- YUV 4:2:0 -> RGB into the surface, scaled to the video rectangle: by the decoder's
-- lanes, while this core goes on (`converted` waits for them).
to convert (pic ptr h264state.picture)
    new f u64 = 0
    asm
        "adrp {f}, video.convert_part"
        "add {f}, {f}, :lo12:video.convert_part"
    h264par.start_job(vd, f, pic as u64)
    converting = true

to converted
    if converting
        h264par.end_job(vd)
        converting = false

-- Rows part * dst_h / parts .. (part + 1) * dst_h / parts of `convert`.
to convert_part (arg u64, part u64, parts u64)
    new pic = arg as ptr h264state.picture
    new h = h264.height(vd) as u64
    new w = h264.width(vd) as u64
    new cx = h264.crop_x(vd) as u64
    new cy = h264.crop_y(vd) as u64
    new lv = addr of level[0]
    new first = part * (dst_h as u64) / parts
    new last_sy u64 = 0
    for each oy in first until (part + 1) * (dst_h as u64) / parts
        new sy = oy * h / (dst_h as u64)
        new yrow = pic.y + (cy + sy) * pic.stride + cx
        new urow = pic.u + ((cy + sy) / 2) * pic.cstride + cx / 2
        new vrow = pic.v + ((cy + sy) / 2) * pic.cstride + cx / 2
        new out = gfx.pixels + ((dst_y as u64) + oy) * (gfx.width as u64) + dst_x as u64
        if dst_w as u64 is w and cx % 2 is 0
            -- one to one: two pixels share their chroma
            for each p in 0 until w / 2
                new u = urow[p] as u64
                new v = vrow[p] as u64
                new rv = tr[v]
                new guv = tgu[u] + tgv[v]
                new bu = tb[u]
                new c0 = ty[yrow[p * 2] as u64]
                new c1 = ty[yrow[p * 2 + 1] as u64]
                out[p * 2] = (lv[((c0 + rv) >> 8) as u64] << 16) | (lv[((c0 + guv) >> 8) as u64] << 8) | lv[((c0 + bu) >> 8) as u64]
                out[p * 2 + 1] = (lv[((c1 + rv) >> 8) as u64] << 16) | (lv[((c1 + guv) >> 8) as u64] << 8) | lv[((c1 + bu) >> 8) as u64]
        else if oy > first and sy is last_sy
            -- the same source row as the screen row above: copy it
            new above = out - gfx.width as u64
            for each ox in 0 until dst_w as u64
                out[ox] = above[ox]
        else
            -- each source pixel once, then stretched across the screen row
            new rb = rowbufs[part] as ptr u32
            for each p in 0 until w / 2
                new u = urow[p] as u64
                new v = vrow[p] as u64
                new rv = tr[v]
                new guv = tgu[u] + tgv[v]
                new bu = tb[u]
                new c0 = ty[yrow[p * 2] as u64]
                new c1 = ty[yrow[p * 2 + 1] as u64]
                rb[p * 2] = (lv[((c0 + rv) >> 8) as u64] << 16) | (lv[((c0 + guv) >> 8) as u64] << 8) | lv[((c0 + bu) >> 8) as u64]
                rb[p * 2 + 1] = (lv[((c1 + rv) >> 8) as u64] << 16) | (lv[((c1 + guv) >> 8) as u64] << 8) | lv[((c1 + bu) >> 8) as u64]
            for each ox in 0 until dst_w as u64
                out[ox] = rb[xmap[ox] as u64]
        last_sy = sy

-- Is the slice NAL in this sample a non-reference one (safe to skip)?
to droppable (data ptr u8, size u64) gives bool
    new ls = mp4.nal_length_size(vt)
    new q u64 = 0
    while q + ls < size
        new len u64 = 0
        for each k in 0 until ls
            len = (len << 8) | data[q + k] as u64
        q += ls
        if q + len > size or len is 0
            give false
        new kind = data[q] & 31
        if kind is 1 or kind is 5
            give (data[q] >> 5) & 3 is 0 and kind is 1
        q += len
    give false

-- Decode video samples until a picture comes out; it is converted into the surface
-- (unless it is already too late) and waits in `ready`. Gives false at the end.
to next_picture (late_ms u64, bench bool) gives bool
    repeat
        new pic = h264.frame(vd, vnext >= vt.count)
        if pic as u64 is not 0
            new pts = pop_pending()
            if not bench
                new lateness = now_ms() as i64 - pts as i64
                if decoded + skipped <= 1 + npending
                    first_late = lateness
                if lateness > 0 and lateness as u64 > worst_late
                    worst_late = lateness as u64
            if not bench and pts + 100 < now_ms()
                dropped += 1
                skip
            new t0 = sys.time()
            if not placed
                place()
                placed = true
            if not bench
                convert(pic)
            convert_ms += sys.time() - t0
            ready = true
            last_pic = pic
            ready_ms = pts
            give true
        if not decode_one(late_ms, bench)
            give false

-- Decode the next video sample (or skip it when late and nothing needs it). False
-- when there are no more.
to decode_one (late_ms u64, bench bool) gives bool
    if vnext >= vt.count
        give false
    new i = vnext
    vnext += 1
    new data = fetch(vt, i)
    if data as u64 is 0
        give true
    new size = vt.sizes[i] as u64
    if not bench and late_ms > 100 and droppable(data, size)
        skipped += 1
        give true
    push_pending(ms_of(vt, vt.times[i] + vt.shift[i] as u64))
    new t0 = sys.time()
    new ls = mp4.nal_length_size(vt)
    new q u64 = 0
    while q + ls <= size
        new len u64 = 0
        for each k in 0 until ls
            len = (len << 8) | data[q + k] as u64
        q += ls
        if q + len > size
            stop
        h264.nal(vd, data + q, len)
        q += len
    decode_ms += sys.time() - t0
    decoded += 1
    give true

-- ---------------------------------------------------------------- the overlay

to time_text (ms u64, into ptr line.line)
    new s = ms / 1000
    if s >= 3600
        line.number(into, s / 3600)
        line.byte(into, ':')
        if (s / 60) % 60 < 10
            line.byte(into, '0')
    line.number(into, (s / 60) % 60)
    line.byte(into, ':')
    if s % 60 < 10
        line.byte(into, '0')
    line.number(into, s % 60)

to length_ms gives u64
    if vt.timescale is 0
        give 0
    give vt.duration * 1000 / (vt.timescale as u64)

fixed bar_h u32 = 120

to draw_overlay
    converted()                         -- the lanes may be writing the surface
    new y = gfx.height - bar_h
    gfx.fill(0, y, gfx.width, bar_h, ui.bg)
    new total = length_ms()
    new pos = now_ms()
    if pos > total
        pos = total
    new left = ui.margin
    new right = gfx.width - ui.margin
    gfx.round_rect(left, y + 30, right - left, 8, 4, ui.slot)
    new done u32 = 0
    if total > 0
        done = (((right - left) as u64) * pos / total) as u32
    if done > 0
        gfx.round_rect(left, y + 30, done, 8, 4, ui.amber)
    gfx.disc(left + done, y + 34, 10, 0, ui.amber_soft)
    new t line.line
    time_text(pos, addr of t)
    line.add(addr of t, " / ")
    time_text(total, addr of t)
    gfx.text(left, y + 60, line.text(addr of t), gfx.regular, ui.putty)
    new title = line.text(addr of name)
    gfx.text(left + 300, y + 60, title, gfx.regular, ui.muted)
    new hint = "Space pause   < > 10 s   q back"
    if paused
        hint = "paused - Space to go on   < > 10 s   q back"
    gfx.text(right - gfx.text_width(hint, gfx.small), y + 62, hint, gfx.small, ui.dim)
    gfx.present(0, y, gfx.width, bar_h)

to hide_overlay
    -- the picture is back on the next frame; until then clear the bar
    gfx.fill(0, gfx.height - bar_h, gfx.width, bar_h, 0)
    gfx.present(0, gfx.height - bar_h, gfx.width, bar_h)

-- ---------------------------------------------------------------- seeking

-- Jump to the key frame at or before `target` ms.
to seek (target u64)
    converted()
    new best u64 = 0
    for each i in 0 until vt.count
        if vt.sync[i] is 1 and ms_of(vt, vt.times[i]) <= target
            best = i
    vnext = best
    h264.reset(vd)
    npending = 0
    ready = false
    new start = ms_of(vt, vt.times[best])
    if have_sound
        sys.audio_drop()
        anext = 0
        while anext < at_track.count and ms_of(at_track, at_track.times[anext]) < start
            anext += 1
        audio_base_ms = start
        audio_frames = 0
    wall_start = sys.time() - start

-- ---------------------------------------------------------------- playing

to report (label string)
    new l line.line
    line.add(addr of l, label)
    line.add(addr of l, ": ")
    line.number(addr of l, decoded)
    line.add(addr of l, " decoded, ")
    line.number(addr of l, shown)
    line.add(addr of l, " shown, ")
    line.number(addr of l, dropped)
    line.add(addr of l, " late, ")
    line.number(addr of l, skipped)
    line.add(addr of l, " skipped; sound ")
    line.number(addr of l, audio_frames)
    line.add(addr of l, " frames from ")
    line.number(addr of l, anext)
    line.add(addr of l, " packets")
    line.byte(addr of l, 10)
    sys.write(line.text(addr of l), sys.muted)
    -- where the time went, per frame
    line.clear(addr of l)
    line.add(addr of l, label)
    line.add(addr of l, ": ms per frame: decode ")
    if decoded > 0
        line.number(addr of l, decode_ms / decoded)
    if shown > 0
        line.add(addr of l, ", convert ")
        line.number(addr of l, convert_ms / shown)
        line.add(addr of l, ", present ")
        line.number(addr of l, present_ms / shown)
    if decoded > 0
        line.add(addr of l, ", sound ")
        line.number(addr of l, sound_ms / decoded)
    line.add(addr of l, "; first picture ")
    if first_late < 0
        line.byte(addr of l, '-')
        line.number(addr of l, (0 - first_late) as u64)
    else
        line.number(addr of l, first_late as u64)
    line.add(addr of l, " ms late, worst ")
    line.number(addr of l, worst_late)
    line.byte(addr of l, 10)
    sys.write(line.text(addr of l), sys.muted)

to play (path ptr line.line)
    line.clear(addr of name)
    new p = line.text(path)
    new cut u64 = 0
    for each i in 0 until p.len
        if p[i] is '/'
            cut = i + 1
    line.add(addr of name, p[cut until p.len])
    if not load(path)
        give
    gfx.fill(0, 0, gfx.width, gfx.height, 0)
    gfx.present_all()
    placed = false
    paused = false
    -- the first picture before any sound, so the two start together
    next_picture(0, false)
    wall_start = sys.time()
    overlay_until = sys.time() + 3000
    repeat
        new a0 = sys.time()
        feed_audio()
        sound_ms += sys.time() - a0
        -- a key, without waiting long while there is decoding to do
        new wait_ms u64 = 2
        if not ready or (npending < 4 and vnext < vt.count)
            wait_ms = 0
        new k = keys.within(wait_ms)
        if k is ' ' as u32 or k is keys.enter or k is keys.left_down
            paused = not paused
            if paused
                sys.audio_drop()
                -- resume from where the picture is
                audio_base_ms = ready_ms
                audio_frames = 0
                seek(ready_ms)
            else
                wall_start = sys.time() - audio_base_ms
            overlay_until = sys.time() + 3000
            draw_overlay()
        else if k is keys.right or k is keys.left
            new now = now_ms()
            new target = now + 10_000
            if k is keys.left
                target = 0
                if now > 10_000
                    target = now - 10_000
            seek(target)
            overlay_until = sys.time() + 3000
        else if k is 'q' as u32 or k is keys.escape or k is keys.backspace or k is keys.right_down
            stop
        else if k is keys.pointer_moved
            overlay_until = sys.time() + 3000
        if paused
            skip
        -- the picture
        new now = now_ms()
        if not ready
            new late u64 = 0
            if npending > 0 and pending[0] < now
                late = now - pending[0]
            if not next_picture(late, false)
                if not have_sound or sys.audio_queued() is 0
                    ended = true
                    stop
                skip
        else if ready and npending < 4 and vnext < vt.count
            -- while the next picture waits for its time, decode ahead (the
            -- lanes are turning it into pixels meanwhile)
            new per u64 = 20
            if decoded > 0
                per = decode_ms / decoded + 2
            if ready_ms > now_ms() + per
                decode_one(0, false)
        if ready and ready_ms <= now_ms()
            if sys.time() < overlay_until
                draw_overlay()
            new p0 = sys.time()
            converted()
            gfx.present(dst_x, dst_y, dst_w, dst_h)
            present_ms += sys.time() - p0
            shown += 1
            ready = false
    converted()
    sys.audio_drop()
    sys.close(handle)
    report("video")

to bench (args string) gives u64
    -- an optional frame count after the file name
    new path_len = args.len
    new limit u64 = 0
    new k = args.len
    while k > 0 and args[k - 1] >= '0' and args[k - 1] <= '9'
        k -= 1
    if k > 1 and k < args.len and args[k - 1] is ' '
        for each i in k until args.len
            limit = limit * 10 + (args[i] - '0') as u64
        path_len = k - 1
    new l line.line
    line.add(addr of l, args[0 until path_len])
    if not load(addr of l)
        sys.write(line.text(addr of message), sys.deep)
        sys.print("\n")
        give 1
    have_sound = false
    sys.profile_start()
    new t0 = sys.time()
    new sum u64 = 0
    new summing u64 = 0                 -- ms spent on the checksum, left out
    while next_picture(0, true)
        shown += 1
        new s0 = sys.time()
        sum = checksum(sum, last_pic)
        summing += sys.time() - s0
        if limit > 0 and decoded >= limit
            stop
    new took = sys.time() - t0 - summing
    sys.profile_stop()
    new out line.line
    line.add(addr of out, "bench: ")
    line.number(addr of out, h264.width(vd) as u64)
    line.byte(addr of out, 'x')
    line.number(addr of out, h264.height(vd) as u64)
    line.add(addr of out, ", ")
    line.number(addr of out, decoded)
    line.add(addr of out, " frames in ")
    line.number(addr of out, took)
    line.add(addr of out, " ms = ")
    if took > 0
        line.number(addr of out, decoded * 1000 / took)
        line.byte(addr of out, '.')
        line.number(addr of out, (decoded * 10000 / took) % 10)
    line.add(addr of out, " frames per second, ")
    line.number(addr of out, vd.lane_count)
    line.add(addr of out, " helper cores, pictures ")
    line.hex(addr of out, sum)
    line.byte(addr of out, 10)
    sys.print(line.text(addr of out))
    sys.close(handle)
    give 0

-- A checksum of every sample of a picture (the shown part), added to `sum`.
to checksum (sum u64, p ptr h264state.picture) gives u64
    new w = h264.width(vd) as u64
    new h = h264.height(vd) as u64
    new s = sum
    for each y in 0 until h
        new r = p.y + y * p.stride
        for each x in 0 until w
            s = (s ^ r[x] as u64) *% 0x100_0000_01B3
    for each y in 0 until h / 2
        new u = p.u + y * p.cstride
        new v = p.v + y * p.cstride
        for each x in 0 until w / 2
            s = (s ^ u[x] as u64) *% 0x100_0000_01B3
            s = (s ^ v[x] as u64) *% 0x100_0000_01B3
    give s

to main gives u64
    new a line.line
    a.len = sys.args(addr of a.bytes[0], 160)
    new args = line.text(addr of a)
    use_helpers = true
    if args.len > 6 and files.same(args[0 until 6], "bench ")
        give bench(args[6 until args.len])
    if args.len > 7 and files.same(args[0 until 7], "bench1 ")
        use_helpers = false
        give bench(args[7 until args.len])
    if not gfx.open()
        sys.print("video: no screen\n")
        give 1
    sys.want_pointer(true)
    if args.len > 5 and files.same(args[0 until 5], "play ")
        -- one file, straight away (the report goes to the serial console)
        new one line.line
        line.add(addr of one, args[5 until args.len])
        play(addr of one)
        give 0
    files.setup("Video", ".mp4")
    new path line.line
    new size u64 = 0
    while files.browse(addr of path, addr of size)
        play(addr of path)
    give 0
