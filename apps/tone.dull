-- Plays a short chime (three rising notes, then a chord) at 48 kHz: a test of the
-- sound output that needs no music files. `tone 440` plays one note instead.

use sys
use line

fixed rate u64 = 48000
-- sin(pi/2 x i/64) x 32767, i = 0..64
fixed quarter [65] i32 = [0, 804, 1608, 2410, 3212, 4011, 4808, 5602, 6393, 7179, 7962, 8739, 9512, 10278,
    11039, 11793, 12539, 13279, 14010, 14732, 15446, 16151, 16846, 17530, 18204, 18868, 19519, 20159, 20787,
    21403, 22005, 22594, 23170, 23731, 24279, 24811, 25329, 25832, 26319, 26790, 27245, 27683, 28105, 28510,
    28898, 29268, 29621, 29956, 30273, 30571, 30852, 31113, 31356, 31580, 31785, 31971, 32137, 32285, 32412,
    32521, 32609, 32678, 32728, 32757, 32767]

-- sin(2 pi x phase / 2^32), as -32767 .. 32767.
to sine (phase u32) gives i64
    new i = (phase >> 24) as u64                    -- 0 .. 255
    new q = i & 63
    new v = quarter[q] as i64
    if i & 64 is not 0
        v = quarter[64 - q] as i64
    if i & 128 is not 0
        v = 0 - v
    give v

new phases [3] u32
new frames [480] u32

-- Play `ms` milliseconds of up to three notes (Hz; 0 = none) at once, fading out.
to notes (a u64, b u64, c u64, ms u64)
    new hz [3] u64
    hz[0] = a
    hz[1] = b
    hz[2] = c
    new total = rate * ms / 1000
    new done u64 = 0
    while done < total
        for each i in 0 until 480
            new t = done + i
            new fade = 1000 * (total - t) / total            -- 1000 .. 0
            if t * 50 < total
                fade = fade * t * 50 / total                  -- a soft start
            new mix i64 = 0
            for each k in 0 until 3
                if hz[k] is not 0
                    phases[k] = phases[k] +% ((hz[k] * 0x1_0000_0000 / rate) as u32)
                    mix += sine(phases[k])
            new s = mix * fade as i64 / 4000
            frames[i] = ((s as u32) & 0xFFFF) | (((s as u32) & 0xFFFF) << 16)
        new sent u64 = 0
        while sent < 480
            sent += sys.audio_write(addr of frames[sent], 480 - sent)
            if sent < 480
                sys.sleep(5)
        done += 480

to number (s string) gives u64
    new v u64 = 0
    for each c in s
        if c < '0' or c > '9'
            stop
        v = v * 10 + (c - '0') as u64
    give v

to main gives u64
    if not sys.audio_start(rate as u32)
        sys.write("tone: no sound output\n", sys.deep)
        give 1
    new l line.line
    l.len = sys.args(addr of l.bytes[0], 160)
    new hz = number(line.text(addr of l))
    if hz > 0
        notes(hz, 0, 0, 2000)
    else
        notes(523, 0, 0, 220)                               -- C
        notes(659, 0, 0, 220)                               -- E
        notes(784, 0, 0, 220)                               -- G
        notes(523, 659, 1047, 1400)                         -- C major
    while sys.audio_queued() > 0
        sys.sleep(20)
    give 0
