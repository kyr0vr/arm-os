-- The ArmOS launcher: the first thing on the screen. Four tiles - Text, Music,
-- Video, Console - chosen with the arrow keys (or 1-4) and opened with Enter.

use sys
use gfx
use keys
use line

fixed bg u32 = 0x12_12_11
fixed slot u32 = 0x22_21_1F
fixed slot_lit u32 = 0x30_2E_29
fixed edge u32 = 0x3A_37_31
fixed putty u32 = 0xE6_DB_C1
fixed amber u32 = 0xFF_9A_1F
fixed amber_soft u32 = 0xFF_C2_66
fixed muted u32 = 0x8C_84_6F
fixed dim u32 = 0x5A_55_4A

fixed tiles u32 = 4
fixed tile_w u32 = 360
fixed tile_h u32 = 420
fixed gap u32 = 48
fixed tile_y u32 = 300

fixed titles [4] string = ["Text", "Music", "Video", "Console"]
fixed blurbs [4] string = ["read .txt files", "play .mp3 files", "play .mp4 files", "the ArmOS shell"]
fixed apps [4] string = ["text", "music", "video", "shell"]
fixed later [4] string = ["", "", "", ""]

new chosen u32
new note line.line             -- a message under the tiles ("arrives in phase 11")

to tile_x (i u32) gives u32
    new total = tiles * tile_w + (tiles - 1) * gap
    give (gfx.width - total) / 2 + i * (tile_w + gap)

-- ---------------------------------------------------------------- icons

to icon_text (cx u32, cy u32, color u32, back u32)
    -- a page with a folded corner and lines of text
    new x = cx - 52
    new y = cy - 66
    gfx.round_rect(x, y, 104, 132, 10, color)
    gfx.round_rect(x + 6, y + 6, 92, 120, 6, back)
    gfx.triangle((x + 70) as i64, y as i64, (x + 104) as i64, y as i64, (x + 104) as i64, (y + 34) as i64, back)
    gfx.triangle((x + 70) as i64, y as i64, (x + 70) as i64, (y + 34) as i64, (x + 104) as i64, (y + 34) as i64, color)
    for each k in 0 until 5 as u32
        new w u32 = 64
        if k is 4
            w = 38
        gfx.round_rect(x + 20, y + 50 + k * 15, w, 6, 3, color)

to icon_music (cx u32, cy u32, color u32, back u32)
    -- two beamed notes
    gfx.disc(cx - 34, cy + 40, 20, 0, color)
    gfx.disc(cx + 38, cy + 26, 20, 0, color)
    gfx.fill(cx - 18, cy - 50, 9, 92, color)
    gfx.fill(cx + 54, cy - 64, 9, 92, color)
    new beam [8] i64
    beam[0] = (cx - 18) as i64
    beam[1] = (cy - 50) as i64
    beam[2] = (cx + 63) as i64
    beam[3] = (cy - 64) as i64
    beam[4] = (cx + 63) as i64
    beam[5] = (cy - 44) as i64
    beam[6] = (cx - 18) as i64
    beam[7] = (cy - 30) as i64
    gfx.quad(addr of beam[0], color)

to icon_video (cx u32, cy u32, color u32, back u32)
    -- a screen with a play button
    gfx.round_rect(cx - 80, cy - 54, 160, 108, 14, color)
    gfx.round_rect(cx - 72, cy - 46, 144, 92, 9, back)
    gfx.triangle((cx - 18) as i64, (cy - 28) as i64, (cx - 18) as i64, (cy + 28) as i64, (cx + 30) as i64, cy as i64, color)
    gfx.round_rect(cx - 40, cy + 64, 80, 8, 4, color)

to icon_console (cx u32, cy u32, color u32, back u32)
    -- a terminal window with a prompt
    gfx.round_rect(cx - 80, cy - 58, 160, 116, 14, color)
    gfx.round_rect(cx - 72, cy - 34, 144, 84, 8, back)
    gfx.disc(cx - 62, cy - 46, 4, 0, back)
    gfx.disc(cx - 48, cy - 46, 4, 0, back)
    gfx.disc(cx - 34, cy - 46, 4, 0, back)
    gfx.triangle((cx - 52) as i64, (cy - 16) as i64, (cx - 22) as i64, (cy + 2) as i64, (cx - 52) as i64, (cy + 20) as i64, color)
    gfx.triangle((cx - 52) as i64, (cy - 4) as i64, (cx - 36) as i64, (cy + 2) as i64, (cx - 52) as i64, (cy + 8) as i64, back)
    gfx.fill(cx - 14, cy + 18, 40, 8, color)

-- ---------------------------------------------------------------- drawing

to draw_tile (i u32)
    new x = tile_x(i)
    new y = tile_y
    new lit = i is chosen
    -- clear the area around the tile (the frame of the chosen one sticks out)
    gfx.fill(x - 8, y - 8, tile_w + 16, tile_h + 16, bg)
    new fill_color = slot
    new ink = muted
    new title_color = putty
    if lit
        fill_color = slot_lit
        ink = amber
        title_color = amber
        gfx.round_rect(x - 6, y - 6, tile_w + 12, tile_h + 12, 30, amber)
        gfx.round_rect(x - 1, y - 1, tile_w + 2, tile_h + 2, 25, bg)
    else
        gfx.round_rect(x - 1, y - 1, tile_w + 2, tile_h + 2, 25, edge)
    gfx.round_rect(x, y, tile_w, tile_h, 24, fill_color)
    -- number in the corner
    new digit [1] u8
    digit[0] = '1' + i as u8
    new d string
    d.ptr = addr of digit[0]
    d.len = 1
    gfx.text(x + 24, y + 20, d, gfx.small, dim)
    -- icon, title, line under it
    new cx = x + tile_w / 2
    new cy = y + 150
    if i is 0
        icon_text(cx, cy, ink, fill_color)
    else if i is 1
        icon_music(cx, cy, ink, fill_color)
    else if i is 2
        icon_video(cx, cy, ink, fill_color)
    else
        icon_console(cx, cy, ink, fill_color)
    gfx.text_centered(cx, y + 262, titles[i], gfx.large, title_color)
    gfx.text_centered(cx, y + 330, blurbs[i], gfx.small, muted)
    if later[i].len > 0
        new w = gfx.text_width(later[i], gfx.small) + 32
        gfx.round_rect(cx - w / 2, y + 368, w, 34, 17, bg)
        gfx.text_centered(cx, y + 372, later[i], gfx.small, dim)

to draw_header
    gfx.fill(0, 0, gfx.width, 200, bg)
    new x = gfx.text(120, 96, "ArmOS", gfx.large, amber)
    gfx.text(x + 24, 112, "a rather mundane operating system", gfx.regular, muted)
    draw_clock()

-- Uptime, top right.
to draw_clock
    new l line.line
    line.add(addr of l, "up ")
    new s = sys.time() / 1000
    if s >= 3600
        line.number(addr of l, s / 3600)
        line.add(addr of l, "h ")
    line.number(addr of l, (s / 60) % 60)
    line.add(addr of l, "m ")
    line.number(addr of l, s % 60)
    line.add(addr of l, "s")
    new t = line.text(addr of l)
    new right = gfx.width - 120
    gfx.fill(right - 400, 110, 400, 36, bg)
    gfx.text(right - gfx.text_width(t, gfx.regular), 112, t, gfx.regular, muted)

to key_cap (x u32, y u32, label string) gives u32
    new w = gfx.text_width(label, gfx.small) + 28
    gfx.round_rect(x, y, w, 40, 10, edge)
    gfx.round_rect(x + 2, y + 2, w - 4, 36, 8, slot)
    gfx.text(x + 14, y + 6, label, gfx.small, putty)
    give x + w

to draw_footer
    gfx.fill(0, 940, gfx.width, 140, bg)
    new x = 120 as u32
    x = key_cap(x, 980, "<")
    x = key_cap(x + 8, 980, ">")
    x = gfx.text(x + 16, 986, "choose", gfx.small, muted)
    x = key_cap(x + 48, 980, "Enter")
    x = gfx.text(x + 16, 986, "open", gfx.small, muted)
    x = key_cap(x + 48, 980, "1-4")
    x = gfx.text(x + 16, 986, "jump", gfx.small, muted)
    gfx.text(x + 48, 986, "or point and click", gfx.small, dim)
    new v = "ArmOS 0.12"
    gfx.text(gfx.width - 120 - gfx.text_width(v, gfx.small), 986, v, gfx.small, dim)

to draw_note
    gfx.fill(0, tile_y + tile_h + 20, gfx.width, 100, bg)
    if note.len > 0
        gfx.text_centered(gfx.width / 2, tile_y + tile_h + 60, line.text(addr of note), gfx.regular, amber_soft)
    gfx.present(0, tile_y + tile_h + 20, gfx.width, 100)

to draw_all
    gfx.fill(0, 0, gfx.width, gfx.height, bg)
    draw_header()
    for each i in 0 until tiles
        draw_tile(i)
    draw_footer()
    draw_note()
    gfx.present_all()

to choose (i u32)
    if i is chosen
        give
    new old = chosen
    chosen = i
    line.clear(addr of note)
    draw_tile(old)
    draw_tile(i)
    new top = tile_y - 8
    gfx.present(0, top, gfx.width, tile_h + 16)
    draw_note()

-- The tile under (x, y), or `tiles` for none.
to tile_at (x u32, y u32) gives u32
    if y < tile_y or y >= tile_y + tile_h
        give tiles
    for each i in 0 until tiles
        if x >= tile_x(i) and x < tile_x(i) + tile_w
            give i
    give tiles

-- ---------------------------------------------------------------- opening

to open (i u32)
    if apps[i].len is 0
        line.clear(addr of note)
        line.add(addr of note, titles[i])
        line.add(addr of note, " ")
        line.add(addr of note, later[i])
        line.add(addr of note, ".")
        draw_note()
        give
    new pid = sys.spawn(apps[i], "", false)
    if pid is 0
        give
    sys.wait(pid)
    -- back in front: the kernel put our picture back; freshen the clock
    draw_clock()
    gfx.present(0, 100, gfx.width, 60)

to main gives u64
    if not gfx.open()
        -- no screen: fall back to the shell
        sys.wait(sys.spawn("shell", "", false))
        give 0
    sys.want_pointer(true)
    draw_all()
    repeat
        new key = keys.within(1000)
        if key is keys.timeout
            draw_clock()
            gfx.present(0, 100, gfx.width, 60)
            skip
        if key is keys.pointer_moved
            new under = tile_at(sys.pointer_x(), sys.pointer_y())
            if under < tiles
                choose(under)
        else if key is keys.left_down
            new under = tile_at(sys.pointer_x(), sys.pointer_y())
            if under < tiles
                choose(under)
                open(under)
        else if key is keys.right or key is keys.down or key is keys.tab or key is 'd' as u32
            choose((chosen + 1) % tiles)
        else if key is keys.left or key is keys.up or key is 'a' as u32
            choose((chosen + tiles - 1) % tiles)
        else if key is keys.home
            choose(0)
        else if key is keys.finish
            choose(tiles - 1)
        else if key >= '1' as u32 and key <= '4' as u32
            choose(key - '1' as u32)
            open(chosen)
        else if key is keys.enter or key is ' ' as u32
            open(chosen)
    give 0
