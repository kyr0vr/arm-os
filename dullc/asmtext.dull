-- Text handling for the assembler: comments, operands, strings, expressions.
-- A port of the helpers in stage0/aa64/assembler.py.

use mem
use text
use buf
use vec
use map

-- The current line's file and number, for error messages.
new file string
new lineno u64

use diag

to fail (message string)
    diag.fail(file, lineno, message)

to fail2 (a string, b string)
    new m buf.buf
    buf.add(addr of m, a)
    buf.add(addr of m, b)
    fail(buf.text(addr of m))

to lower (s string) gives string
    new out string
    out.ptr = mem.alloc(s.len + 1)
    out.len = s.len
    for each i in 0 until s.len
        new c = s[i]
        if c >= 'A' and c <= 'Z'
            c = c + 32
        out.ptr[i] = c
    give out

to strip (s string) gives string
    new a u64 = 0
    new b = s.len
    while a < b and text.is_space(s[a])
        a += 1
    while b > a and text.is_space(s[b - 1])
        b -= 1
    give s[a until b]

-- Drop a `//` comment (not inside a string) and surrounding spaces.
to strip_comment (line string) gives string
    new in_str = false
    new i u64 = 0
    while i < line.len
        new c = line[i]
        if in_str
            if c is '\\' and i + 1 < line.len
                i += 2
                skip
            if c is '"'
                in_str = false
        else if c is '"'
            in_str = true
        else if c is '/' and i + 1 < line.len and line[i + 1] is '/'
            give strip(line[0 until i])
        i += 1
    give strip(line)

-- Operands split on commas that are not inside [ ], ( ) or a string. A vec of
-- (ptr, len) pairs.
to split_operands (s string) gives ptr vec.vec
    new ops = vec.make()
    new depth u64 = 0
    new in_str = false
    new start u64 = 0
    for each i in 0 until s.len
        new c = s[i]
        if in_str
            if c is '"'
                in_str = false
            skip
        if c is '"'
            in_str = true
        else if c is '[' or c is '('
            depth += 1
        else if c is ']' or c is ')'
            if depth > 0
                depth -= 1
        if c is ',' and depth is 0
            push_op(ops, strip(s[start until i]))
            start = i + 1
    new last = strip(s[start until s.len])
    if last.len > 0
        push_op(ops, last)
    give ops

to push_op (ops ptr vec.vec, s string)
    vec.push(ops, s.ptr as u64)
    vec.push(ops, s.len)

to op (ops ptr vec.vec, i u64) gives string
    new s string
    s.ptr = vec.get(ops, i * 2) as ptr u8
    s.len = vec.get(ops, i * 2 + 1)
    give s

to op_count (ops ptr vec.vec) gives u64
    give ops.len / 2

-- A list of operands with `first` put in front.
to prepend (first string, ops ptr vec.vec) gives ptr vec.vec
    new out = vec.make()
    push_op(out, first)
    for each i in 0 until op_count(ops)
        push_op(out, op(ops, i))
    give out

-- ops[from ..]
to rest (ops ptr vec.vec, from u64) gives ptr vec.vec
    new out = vec.make()
    for each i in from until op_count(ops)
        push_op(out, op(ops, i))
    give out

to hex_digit (c u8) gives maybe u64
    if c >= '0' and c <= '9'
        give (c - '0') as u64
    if c >= 'a' and c <= 'f'
        give (c - 'a' + 10) as u64
    if c >= 'A' and c <= 'F'
        give (c - 'A' + 10) as u64
    give nothing

-- The bytes of a quoted string, with escapes.
to parse_string (t string) gives string
    new s = strip(t)
    if s.len < 2 or s[0] is not '"' or s[s.len - 1] is not '"'
        fail("expected a quoted string")
    new body = s[1 until s.len - 1]
    new out buf.buf
    new i u64 = 0
    while i < body.len
        new c = body[i]
        if c is not '\\'
            buf.byte(addr of out, c)
            i += 1
            skip
        new e = body[i + 1]
        if e is 'x'
            new j = i + 2
            new v u64 = 0
            while j < body.len and hex_digit(body[j]) is not nothing
                v = v * 16 + (hex_digit(body[j]) else 0)
                j += 1
            buf.byte(addr of out, (v & 0xFF) as u8)
            i = j
        else if e >= '0' and e <= '7' and (e is not '0' or (i + 2 < body.len and body[i + 2] >= '0' and body[i + 2] <= '7'))
            new j = i + 1
            new v u64 = 0
            while j < body.len and j < i + 4 and body[j] >= '0' and body[j] <= '7'
                v = v * 8 + (body[j] - '0') as u64
                j += 1
            buf.byte(addr of out, (v & 0xFF) as u8)
            i = j
        else
            buf.byte(addr of out, escape(e))
            i += 2
    give buf.text(addr of out)

to escape (e u8) gives u8
    if e is 'n'
        give 10
    if e is 't'
        give 9
    if e is 'r'
        give 13
    if e is '0'
        give 0
    if e is 'a'
        give 7
    if e is 'b'
        give 8
    if e is 'f'
        give 12
    if e is 'v'
        give 11
    give e

-- ---------------------------------------------------------------- expressions
-- Integers, constants, + - * / % << >> & | ^ ~ ( ) and 'c'. Values are 64-bit.

new consts ptr map.map          -- name -> value (.equ / .set)
new src string
new pos u64

to is_ident_start (c u8) gives bool
    give text.is_alpha(c) or c is '.' or c is '$'

to is_ident (c u8) gives bool
    give text.is_alpha(c) or text.is_digit(c) or c is '.' or c is '$'

to skip_spaces
    while pos < src.len and text.is_space(src[pos])
        pos += 1

to at_end gives bool
    skip_spaces()
    give pos >= src.len

to peek_is (s string) gives bool
    skip_spaces()
    give text.starts_with(src[pos until src.len], s)

-- Evaluate `t` (no `#`). Fails if it is not a constant.
to eval (t string) gives i64
    new saved_src = src
    new saved_pos = pos
    src = t
    pos = 0
    new v = binop(0)
    if not at_end()
        fail2("unexpected text in expression: ", src[pos until src.len])
    src = saved_src
    pos = saved_pos
    give v

-- Like eval, but says no instead of failing when `t` is not a constant.
to try_eval (t string, out ptr i64) gives bool
    if not is_constant(t)
        give false
    deref out = eval(t)
    give true

-- Every name in `t` is a known constant (so it can be evaluated now).
to is_constant (t string) gives bool
    new i u64 = 0
    while i < t.len
        new c = t[i]
        if c is '\''
            i += 3
            skip
        if text.is_digit(c)
            while i < t.len and is_ident(t[i])
                i += 1
            skip
        if is_ident_start(c)
            new j = i
            while j < t.len and is_ident(t[j])
                j += 1
            if not map.has(consts, t[i until j])
                give false
            i = j
            skip
        i += 1
    give true

to level_has (level u64) gives u64
    -- length of the operator at pos for this level, 0 if none
    skip_spaces()
    if pos >= src.len
        give 0
    new c = src[pos]
    if level is 0 and c is '|'
        give 1
    if level is 1 and c is '^'
        give 1
    if level is 2 and c is '&'
        give 1
    if level is 3 and pos + 1 < src.len and ((c is '<' and src[pos + 1] is '<') or (c is '>' and src[pos + 1] is '>'))
        give 2
    if level is 4 and (c is '+' or c is '-')
        give 1
    if level is 5 and (c is '*' or c is '/' or c is '%')
        give 1
    give 0

to binop (level u64) gives i64
    if level is 6
        give unary()
    new v = binop(level + 1)
    repeat
        new width = level_has(level)
        if width is 0
            give v
        new c = src[pos]
        pos += width
        new r = binop(level + 1)
        if c is '|'
            v = v | r
        else if c is '^'
            v = v ^ r
        else if c is '&'
            v = v & r
        else if c is '<'
            v = (v as u64 << (r as u64)) as i64
        else if c is '>'
            v = v >> (r as u64)
        else if c is '+'
            v = v +% r
        else if c is '-'
            v = v -% r
        else if c is '*'
            v = v *% r
        else if c is '/'
            if r is not 0
                v = v / r
            else
                v = 0
        else if c is '%'
            if r is not 0
                v = v % r
            else
                v = 0

to unary gives i64
    skip_spaces()
    if pos >= src.len
        fail("expression ends too early")
    new c = src[pos]
    if c is '-'
        pos += 1
        give 0 -% unary()
    if c is '~'
        pos += 1
        give ~unary()
    if c is '+'
        pos += 1
        give unary()
    if c is '('
        pos += 1
        new v = binop(0)
        skip_spaces()
        if pos >= src.len or src[pos] is not ')'
            fail("missing )")
        pos += 1
        give v
    if c is '\'' and pos + 2 < src.len and src[pos + 2] is '\''
        new v = src[pos + 1] as i64
        pos += 3
        give v
    if text.is_digit(c)
        new base u64 = 10
        if c is '0' and pos + 1 < src.len and (src[pos + 1] is 'x' or src[pos + 1] is 'X')
            base = 16
            pos += 2
        else if c is '0' and pos + 1 < src.len and (src[pos + 1] is 'b' or src[pos + 1] is 'B')
            base = 2
            pos += 2
        new v u64 = 0
        while pos < src.len and (hex_digit(src[pos]) is not nothing or src[pos] is '_')
            if src[pos] is not '_'
                new d = hex_digit(src[pos]) else 0
                if d >= base
                    stop
                v = v *% base +% d
            pos += 1
        give v as i64
    if is_ident_start(c)
        new j = pos
        while j < src.len and is_ident(src[j])
            j += 1
        new name = src[pos until j]
        new found = map.get(consts, name)
        if found is nothing
            fail2(name, " is not a constant")
        pos = j
        give (found else 0) as i64
    fail2("unexpected character in expression: ", src[pos until pos + 1])
    give 0
