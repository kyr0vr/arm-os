-- QEMU `virt` board facts and services for the kernel (the same interface as
-- rt/pi5/board.dull), so the kernel can be tested on the PC.
-- Run with: -M virt,gic-version=2 -cpu cortex-a76 -smp 4 -m 128M

use pages
use line
use fb
use virtio
use pci

elsewhere new __stack_top u8

fixed gic_dist u64 = 0x0800_0000
fixed gic_cpu  u64 = 0x0801_0000
fixed cores u64 = 4
fixed ram_end u64 = 0x4700_0000       -- RAM from 0x4000_0000; the pretend screen sits above this

-- Scripted keys from build/kernel_virt/keys.txt (written by tests/kernel_test.py),
-- read by the apps; once they have run out and nothing is left to do, the run is
-- over. Without that file the run is interactive: keys come from a USB keyboard and
-- it never ends by itself.
new script [16384] u8
new script_len u64
new interactive bool           -- no key file: keys only ever come from USB
new script_pos u64

to probe
    load_script()
    pci.setup(0x3F00_0000, 0x1000_0000, 0x2EFF_0000)

-- USB: xHCI controllers on the PCIe bus (QEMU: -device qemu-xhci).
to usb_controller (n u64) gives u64
    give pci.find(0x0C_0330, n as u32)

to usb_prepare (base u64)
    give

-- Devices see RAM where the CPU does.
to dma_offset gives u64
    give 0

-- F12 on a USB keyboard saves the screen as screen<n>.raw, n = 2, 3, ...
new shots u32 = 2

to snapshot_key
    save_raw(fb.ram_screen, 1920 * 1080 * 4, shots)
    shots += 1

to load_script
    new path string = "build/kernel_virt/keys.txt\0"
    new block [3] u64
    block[0] = path.ptr as u64
    block[1] = 1                      -- "rb"
    block[2] = path.len - 1
    new h = semihost(0x01, addr of block[0])
    if h as i64 < 0
        interactive = true
        give
    block[0] = h
    new size = semihost(0x0C, addr of block[0])
    if size > 16384
        size = 16384
    block[0] = h
    block[1] = (addr of script[0]) as u64
    block[2] = size
    new left = semihost(0x06, addr of block[0])     -- gives the bytes it did not read
    script_len = size - left
    block[0] = h
    semihost(0x02, addr of block[0])

-- The disk: QEMU's virtio block device.
to disk_read (lba u64, count u32, into ptr u8) gives bool
    give virtio.read(lba, count, into)

to disk_sectors gives u64
    if not virtio.init()
        give 0
    give virtio.capacity()

to disk_name (l ptr line.line)
    line.add(l, "virtio disk")

to host_name (l ptr line.line)
    line.add(l, "QEMU virt (emulated)")

to gpu_name (l ptr line.line)
    line.add(l, "none (QEMU)")

to memory_mib gives u64
    give 128

to cpu_mhz gives u64
    give 0

-- One scripted key, but only when an app is waiting for one (`wanted`), so the
-- script runs the same way every time. Bytes 2-7 in the script are not keys: they
-- save the screen as build/kernel_virt/screen<n>.raw at that moment.
to poll_key (wanted bool) gives maybe u8
    if not wanted
        give nothing
    while script_pos < script_len and script[script_pos] >= 2 and script[script_pos] <= 7
        save_raw(fb.ram_screen, 1920 * 1080 * 4, script[script_pos] as u32)
        script_pos += 1
    if script_pos >= script_len
        give nothing
    new k = script[script_pos]
    script_pos += 1
    give k

to input_ended gives bool
    give not interactive and script_pos >= script_len

to core_mpidr (n u64) gives u64
    give n

-- QEMU's built-in PSCI answers `hvc` when the kernel starts at EL1, `smc` when it
-- starts at EL2 (virtualization=on).
to psci_smc (boot_el u64) gives bool
    give boot_el is 2

to memory_kind (g u64) gives u8
    if g is 0
        give 2                        -- devices (GIC, UART) below 1 GB
    if g is 1
        give 1                        -- RAM
    give 0

to add_ram
    pages.add((addr of __stack_top) as u64, ram_end)

-- Semihosting: ask QEMU (on the PC) to do something.
to semihost (op u64, block ptr u64) gives u64
    new r u64 = 0
    asm
        "mov x0, {op}"
        "mov x1, {block}"
        "hlt #0xf000"
        "mov {r}, x0"
    give r

-- Write the screen to build/kernel_virt/screen<which>.raw (BGRA bytes, 1920x1080).
to save_screen (s ptr fb.screen, which u32)
    save_raw(s.base as u64, (s.pitch as u64) * (s.height as u64), which)

to save_raw (base u64, size u64, which u32)
    new path string = "build/kernel_virt/screen0.raw\0"
    path.ptr[24] = '0' + (which as u8)
    new block [3] u64
    block[0] = path.ptr as u64
    block[1] = 5                      -- "wb"
    block[2] = path.len - 1
    new h = semihost(0x01, addr of block[0])
    if h as i64 < 0
        give
    block[0] = h
    block[1] = base
    block[2] = size
    semihost(0x05, addr of block[0])
    block[0] = h
    semihost(0x02, addr of block[0])

-- Stop QEMU with exit status `code` (semihosting).
to exit (code u64)
    new block [2] u64
    block[0] = 0x2_0026               -- ADP_Stopped_ApplicationExit
    block[1] = code
    semihost(0x18, addr of block[0])
    repeat
        wfe()

to reboot
    exit(0)

-- On the PC there is nothing to wait for: finish the run.
to idle
    exit(0)
