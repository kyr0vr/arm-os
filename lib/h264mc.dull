-- Motion compensation (8.4.2): luma at quarter samples with the 6-tap filter,
-- chroma at eighth samples, and weighted prediction (default, explicit, implicit).
-- Reference pictures have padded borders, so block positions are only clamped to
-- stay inside them.

use h264state

to px (p ptr u8, stride u64, x i64, y i64) gives i32
    give ((p as i64 + y * stride as i64 + x) as ptr u8)[0] as i32

to tap (a i32, b i32, c i32, e i32, f i32, g i32) gives i32
    give a - 5 * b + 20 * c + 20 * e - 5 * f + g

-- b1 (half sample right of x), h1 (below y), j1 (both), unclipped.
to half_h (p ptr u8, s u64, x i64, y i64) gives i32
    give tap(px(p, s, x - 2, y), px(p, s, x - 1, y), px(p, s, x, y), px(p, s, x + 1, y), px(p, s, x + 2, y), px(p, s, x + 3, y))

to half_v (p ptr u8, s u64, x i64, y i64) gives i32
    give tap(px(p, s, x, y - 2), px(p, s, x, y - 1), px(p, s, x, y), px(p, s, x, y + 1), px(p, s, x, y + 2), px(p, s, x, y + 3))

to center (p ptr u8, s u64, x i64, y i64) gives i32
    give tap(half_v(p, s, x - 2, y), half_v(p, s, x - 1, y), half_v(p, s, x, y), half_v(p, s, x + 1, y), half_v(p, s, x + 2, y), half_v(p, s, x + 3, y))

to round5 (v i32) gives i32
    give h264state.clip1((v + 16) >> 5)

to avg (a i32, b i32) gives i32
    give (a + b + 1) >> 1

to clampi (v i64, lo i64, hi i64) gives i64
    if v < lo
        give lo
    if v > hi
        give hi
    give v

-- A w x h luma block of `pic` at (x0, y0) moved by (mvx, mvy) quarter samples, into
-- `out` (row stride 16).
to luma (pic ptr h264state.picture, x0 i64, y0 i64, w u64, h u64, mvx i32, mvy i32, out ptr i32)
    new width = (pic.alloc_w as i64) * 16
    new height = (pic.alloc_h as i64) * 16
    new pad = h264state.pad as i64
    new xi = clampi(x0 + (mvx >> 2) as i64, 2 - pad, width + pad - w as i64 - 3)
    new yi = clampi(y0 + (mvy >> 2) as i64, 2 - pad, height + pad - h as i64 - 3)
    new fx = mvx & 3
    new fy = mvy & 3
    new p = pic.y
    new s = pic.stride
    for each i in 0 until h
        for each j in 0 until w
            new x = xi + j as i64
            new y = yi + i as i64
            new v i32 = 0
            if fx is 0 and fy is 0
                v = px(p, s, x, y)
            else if fy is 0
                new b = round5(half_h(p, s, x, y))
                if fx is 1
                    v = avg(px(p, s, x, y), b)
                else if fx is 2
                    v = b
                else
                    v = avg(px(p, s, x + 1, y), b)
            else if fx is 0
                new hh = round5(half_v(p, s, x, y))
                if fy is 1
                    v = avg(px(p, s, x, y), hh)
                else if fy is 2
                    v = hh
                else
                    v = avg(px(p, s, x, y + 1), hh)
            else if fx is 2 or fy is 2
                new j1 = h264state.clip1((center(p, s, x, y) + 512) >> 10)
                if fx is 2 and fy is 2
                    v = j1
                else if fx is 2 and fy is 1
                    v = avg(round5(half_h(p, s, x, y)), j1)
                else if fx is 2
                    v = avg(j1, round5(half_h(p, s, x, y + 1)))
                else if fx is 1
                    v = avg(round5(half_v(p, s, x, y)), j1)
                else
                    v = avg(j1, round5(half_v(p, s, x + 1, y)))
            else
                -- the diagonal quarter positions: average of two half samples
                new bb = round5(half_h(p, s, x, y + (fy / 2) as i64))
                new hh = round5(half_v(p, s, x + (fx / 2) as i64, y))
                if fy is 3
                    bb = round5(half_h(p, s, x, y + 1))
                else
                    bb = round5(half_h(p, s, x, y))
                if fx is 3
                    hh = round5(half_v(p, s, x + 1, y))
                else
                    hh = round5(half_v(p, s, x, y))
                v = avg(bb, hh)
            out[i * 16 + j] = v

-- A w x h chroma block (plane `plane`: 0 Cb, 1 Cr), mv in eighth samples.
-- wh: w | h << 8
to chroma (pic ptr h264state.picture, plane u64, x0 i64, y0 i64, wh u64, mvx i32, mvy i32, out ptr i32)
    new w = wh & 255
    new h = wh >> 8
    new width = (pic.alloc_w as i64) * 8
    new height = (pic.alloc_h as i64) * 8
    new pad = h264state.cpad as i64
    new xi = clampi(x0 + (mvx >> 3) as i64, 0 - pad, width + pad - w as i64 - 1)
    new yi = clampi(y0 + (mvy >> 3) as i64, 0 - pad, height + pad - h as i64 - 1)
    new fx = mvx & 7
    new fy = mvy & 7
    new p = pic.u
    if plane is 1
        p = pic.v
    new s = pic.cstride
    for each i in 0 until h
        for each j in 0 until w
            new x = xi + j as i64
            new y = yi + i as i64
            new v = (8 - fx) * (8 - fy) * px(p, s, x, y) + fx * (8 - fy) * px(p, s, x + 1, y)
            v += (8 - fx) * fy * px(p, s, x, y + 1) + fx * fy * px(p, s, x + 1, y + 1)
            out[i * 16 + j] = (v + 32) >> 6

-- ---------------------------------------------------------------- one partition

to picture_of (d ptr h264state.decoder, lst u64, ref i32) gives ptr h264state.picture
    new slot = d.list[lst * 32 + ref as u64]
    if slot is 0
        give 0 as ptr h264state.picture
    give addr of d.pics[slot - 1]

to cdiv (a i32, b i32) gives i32
    new q = h264state.abs(a) / h264state.abs(b)
    if (a >= 0) is (b >= 0)
        give q
    give 0 - q

-- Implicit bi-prediction weights for refs (r0, r1): w1 in the low half, w0 in the high.
to implicit (d ptr h264state.decoder, r0 i32, r1 i32, w0 ptr i32, w1 ptr i32)
    deref w0 = 32
    deref w1 = 32
    new p0 = picture_of(d, 0, r0)
    new p1 = picture_of(d, 1, r1)
    new tb = h264state.clip(d.poc - p0.poc, -128, 127)
    new td = h264state.clip(p1.poc - p0.poc, -128, 127)
    if td is 0 or p0.ref is 2 or p1.ref is 2
        give
    new tx = cdiv(16384 + h264state.abs(cdiv(td, 2)), td)
    new dsf = h264state.clip((tb * tx + 32) >> 6, -1024, 1023)
    if (dsf >> 2) < -64 or (dsf >> 2) > 128
        give
    deref w1 = dsf >> 2
    deref w0 = 64 - (dsf >> 2)

to one (v i32, w i32, o i32, denom u32) gives i32
    if denom >= 1
        give h264state.clip1(((v * w + ((1 as i32) << (denom - 1))) >> denom) + o)
    give h264state.clip1(v * w + o)

to two (a i32, b i32, w0 i32, w1 i32, o0 i32, o1 i32, denom u32) gives i32
    give h264state.clip1(((a * w0 + b * w1 + ((1 as i32) << denom)) >> (denom + 1)) + ((o0 + o1 + 1) >> 1))

-- Predict the w x h luma block at (x, y) of the current macroblock (and its chroma)
-- from refs[0] / refs[1] (-1 = list not used) with motion vectors mv[0..3].
to predict (d ptr h264state.decoder, x u64, y u64, w u64, h u64, refs ptr i32, mv ptr i32)
    new mode u32 = 0
    if d.stype is 0 and d.p.weighted
        mode = 1
    if d.stype is 1
        mode = d.p.bipred
    new count u64 = 0
    new first u64 = 0
    for each lst in 0 until 2
        if refs[lst] < 0
            skip
        new pic = picture_of(d, lst, refs[lst])
        new base = lst * 256
        luma(pic, (d.mbx + x) as i64, (d.mby + y) as i64, w, h, mv[lst * 2], mv[lst * 2 + 1], addr of d.tmp[base])
        new cwh = (w / 2) | ((h / 2) << 8)
        chroma(pic, 0, ((d.mbx + x) / 2) as i64, ((d.mby + y) / 2) as i64, cwh, mv[lst * 2], mv[lst * 2 + 1], addr of d.tmp[512 + base])
        chroma(pic, 1, ((d.mbx + x) / 2) as i64, ((d.mby + y) / 2) as i64, cwh, mv[lst * 2], mv[lst * 2 + 1], addr of d.tmp[512 + base + 128])
        if count is 0
            first = lst
        count += 1
    if count is 0
        give
    -- weights
    new w0 i32 = 0
    new w1 i32 = 0
    new lw [2] i32
    new lo [2] i32
    new cw [4] i32
    new co [4] i32
    new ld u32 = d.lw_denom
    new cd u32 = d.cw_denom
    if mode is 1
        for each lst in 0 until 2
            if refs[lst] >= 0
                new r = refs[lst] as u64
                lw[lst] = d.w[lst].luma[r * 2]
                lo[lst] = d.w[lst].luma[r * 2 + 1]
                cw[lst * 2] = d.w[lst].cb[r * 2]
                co[lst * 2] = d.w[lst].cb[r * 2 + 1]
                cw[lst * 2 + 1] = d.w[lst].cr[r * 2]
                co[lst * 2 + 1] = d.w[lst].cr[r * 2 + 1]
    else if mode is 2 and count is 2
        implicit(d, refs[0], refs[1], addr of w0, addr of w1)
        lw[0] = w0
        lw[1] = w1
        lo[0] = 0
        lo[1] = 0
        for each k in 0 until 2
            cw[k] = w0
            cw[2 + k] = w1
            co[k] = 0
            co[2 + k] = 0
        ld = 5
        cd = 5
    for each i in 0 until h
        for each j in 0 until w
            new k = i * 16 + j
            new v i32 = 0
            if count is 1
                v = d.tmp[first * 256 + k]
                if mode is 1
                    v = one(v, lw[first], lo[first], ld)
            else if mode is 0 or (mode is 2 and false)
                v = (d.tmp[k] + d.tmp[256 + k] + 1) >> 1
            else
                v = two(d.tmp[k], d.tmp[256 + k], lw[0], lw[1], lo[0], lo[1], ld)
            d.pred_y[(y + i) * 16 + x + j] = v
    for each c in 0 until 2
        for each i in 0 until h / 2
            for each j in 0 until w / 2
                new k = i * 16 + j
                new v i32 = 0
                new t0 = d.tmp[512 + c * 128 + k]
                new t1 = d.tmp[512 + 256 + c * 128 + k]
                if count is 1
                    v = d.tmp[512 + first * 256 + c * 128 + k]
                    if mode is 1
                        v = one(v, cw[first * 2 + c], co[first * 2 + c], cd)
                else if mode is 0
                    v = (t0 + t1 + 1) >> 1
                else
                    v = two(t0, t1, cw[c], cw[2 + c], co[c], co[2 + c], cd)
                d.pred_c[c * 64 + (y / 2 + i) * 8 + x / 2 + j] = v
