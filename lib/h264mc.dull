-- Motion compensation (8.4.2): luma at quarter samples with the 6-tap filter,
-- chroma at eighth samples, and weighted prediction (default, explicit, implicit).
-- Reference pictures have padded borders, so block positions are only clamped to
-- stay inside them. The filters run over whole rows, with no call per sample.

use h264state

to clampi (v i64, lo i64, hi i64) gives i64
    if v < lo
        give lo
    if v > hi
        give hi
    give v

-- A w x h luma block of `pic` at (x0, y0) moved by (mvx, mvy) quarter samples, into
-- `out` (row stride 16); `vbuf` is room for 16 x 21 half samples.
-- wh: w | h << 8
to luma (pic ptr h264state.picture, x0 i64, y0 i64, wh u64, mvx i32, mvy i32, out ptr i32, vbuf ptr i32)
    new w = wh & 255
    new h = wh >> 8
    new width = (pic.alloc_w as i64) * 16
    new height = (pic.alloc_h as i64) * 16
    new pad = h264state.pad as i64
    new xi = clampi(x0 + (mvx >> 2) as i64, 2 - pad, width + pad - w as i64 - 3)
    new yi = clampi(y0 + (mvy >> 2) as i64, 2 - pad, height + pad - h as i64 - 3)
    new fx = mvx & 3
    new fy = mvy & 3
    new s = pic.stride
    new src = (pic.y as i64 + yi * s as i64 + xi) as u64
    if fy is 0
        if fx is 0
            full(src, s, w, h, out)
        else
            across(src, s, w, h, fx, out)
        give
    if fx is 0
        down(src, s, w, h, fy, out)
        give
    if fx is 2 or fy is 2
        middle(src, s, w, h, fx, fy, out, vbuf)
        give
    -- the diagonal quarter positions: average of a horizontal and a vertical half sample
    across(src + (fy / 2) as u64 * s, s, w, h, 2, out)
    down(src + (fx / 2) as u64, s, w, h, 2, vbuf)
    for each i in 0 until h
        new o = out + i * 16
        new q = vbuf + i * 16
        for each j in 0 until w
            o[j] = (o[j] + q[j] + 1) >> 1

-- NEON versions of `across`, `down` and `full` for blocks 16, 8 or 4 wide: `chunks`
-- groups of 8 per row (one for 4 wide, with `half`: only 4 kept), out rows 16 i32s
-- apart. The 6-tap sums fit in 16 bits; a rounding, saturating shift by 5 gives
-- clip((v + 16) >> 5), and urhadd the (a + b + 1) >> 1 average.
to across_neon (src u64, s u64, out u64, chunks u64, h u64, k i32, half u64)
    asm
        "movi v28.8h, #20"
        "movi v29.8h, #5"
        "1:"
        "mov x16, {src}"
        "mov x17, {out}"
        "mov x3, {chunks}"
        "2:"
        "ld1 {v0.16b}, [x16]"
        "add x16, x16, #8"
        "ext v1.16b, v0.16b, v0.16b, #1"
        "ext v2.16b, v0.16b, v0.16b, #2"
        "ext v3.16b, v0.16b, v0.16b, #3"
        "ext v4.16b, v0.16b, v0.16b, #4"
        "ext v5.16b, v0.16b, v0.16b, #5"
        "uaddl v6.8h, v0.8b, v5.8b"
        "uaddl v7.8h, v1.8b, v4.8b"
        "uaddl v8.8h, v2.8b, v3.8b"
        "mla v6.8h, v8.8h, v28.8h"
        "mls v6.8h, v7.8h, v29.8h"
        "sqrshrun v9.8b, v6.8h, #5"
        "cmp {k}, #1"
        "b.ne 3f"
        "urhadd v9.8b, v9.8b, v2.8b"
        "3:"
        "cmp {k}, #3"
        "b.ne 4f"
        "urhadd v9.8b, v9.8b, v3.8b"
        "4:"
        "uxtl v9.8h, v9.8b"
        "uxtl v10.4s, v9.4h"
        "uxtl2 v11.4s, v9.8h"
        "cbnz {half}, 5f"
        "st1 {v10.4s, v11.4s}, [x17], #32"
        "b 6f"
        "5:"
        "st1 {v10.4s}, [x17]"
        "6:"
        "subs x3, x3, #1"
        "b.ne 2b"
        "add {src}, {src}, {s}"
        "add {out}, {out}, #64"
        "subs {h}, {h}, #1"
        "b.ne 1b"

to down_neon (src u64, s u64, out u64, chunks u64, h u64, k i32, half u64)
    asm
        "movi v28.8h, #20"
        "movi v29.8h, #5"
        "1:"
        "mov x4, {src}"
        "mov x17, {out}"
        "mov x3, {chunks}"
        "2:"
        "mov x16, x4"
        "ld1 {v0.8b}, [x16], {s}"
        "ld1 {v1.8b}, [x16], {s}"
        "ld1 {v2.8b}, [x16], {s}"
        "ld1 {v3.8b}, [x16], {s}"
        "ld1 {v4.8b}, [x16], {s}"
        "ld1 {v5.8b}, [x16], {s}"
        "add x4, x4, #8"
        "uaddl v6.8h, v0.8b, v5.8b"
        "uaddl v7.8h, v1.8b, v4.8b"
        "uaddl v8.8h, v2.8b, v3.8b"
        "mla v6.8h, v8.8h, v28.8h"
        "mls v6.8h, v7.8h, v29.8h"
        "sqrshrun v9.8b, v6.8h, #5"
        "cmp {k}, #1"
        "b.ne 3f"
        "urhadd v9.8b, v9.8b, v2.8b"
        "3:"
        "cmp {k}, #3"
        "b.ne 4f"
        "urhadd v9.8b, v9.8b, v3.8b"
        "4:"
        "uxtl v9.8h, v9.8b"
        "uxtl v10.4s, v9.4h"
        "uxtl2 v11.4s, v9.8h"
        "cbnz {half}, 5f"
        "st1 {v10.4s, v11.4s}, [x17], #32"
        "b 6f"
        "5:"
        "st1 {v10.4s}, [x17]"
        "6:"
        "subs x3, x3, #1"
        "b.ne 2b"
        "add {src}, {src}, {s}"
        "add {out}, {out}, #64"
        "subs {h}, {h}, #1"
        "b.ne 1b"

to full_neon (src u64, s u64, out u64, chunks u64, h u64, half u64)
    asm
        "1:"
        "mov x16, {src}"
        "mov x17, {out}"
        "mov x3, {chunks}"
        "2:"
        "ld1 {v9.8b}, [x16]"
        "add x16, x16, #8"
        "uxtl v9.8h, v9.8b"
        "uxtl v10.4s, v9.4h"
        "uxtl2 v11.4s, v9.8h"
        "cbnz {half}, 5f"
        "st1 {v10.4s, v11.4s}, [x17], #32"
        "b 6f"
        "5:"
        "st1 {v10.4s}, [x17]"
        "6:"
        "subs x3, x3, #1"
        "b.ne 2b"
        "add {src}, {src}, {s}"
        "add {out}, {out}, #64"
        "subs {h}, {h}, #1"
        "b.ne 1b"

-- How a block w wide goes through the NEON versions: 8-sample groups per row (0: it
-- does not), and whether only 4 of the last group are kept.
to groups_of (w u64) gives u64
    if w is 16
        give 2
    if w is 8 or w is 4
        give 1
    give 0

-- Whole-sample positions: a copy.
to full (src u64, s u64, w u64, h u64, out ptr i32)
    if groups_of(w) > 0
        full_neon(src, s, out as u64, groups_of(w), h, (w is 4) as u64)
        give
    for each i in 0 until h
        new r = (src + i * s) as ptr u8
        new o = out + i * 16
        for each j in 0 until w
            o[j] = r[j] as i32

-- The horizontal half sample b; fx 1 and 3 average it with the whole sample left or
-- right of it.
to across (src u64, s u64, w u64, h u64, fx i32, out ptr i32)
    if groups_of(w) > 0
        across_neon(src - 2, s, out as u64, groups_of(w), h, fx, (w is 4) as u64)
        give
    for each i in 0 until h
        new r = (src + i * s - 2) as ptr u8
        new o = out + i * 16
        for each j in 0 until w
            new v = (r[j] as i32) + (r[j + 5] as i32) - 5 * ((r[j + 1] as i32) + (r[j + 4] as i32)) + 20 * ((r[j + 2] as i32) + (r[j + 3] as i32))
            v = (v + 16) >> 5
            if v < 0
                v = 0
            else if v > 255
                v = 255
            if fx is 1
                v = (v + (r[j + 2] as i32) + 1) >> 1
            else if fx is 3
                v = (v + (r[j + 3] as i32) + 1) >> 1
            o[j] = v

-- The vertical half sample h; fy 1 and 3 average it with the whole sample above or
-- below it.
to down (src u64, s u64, w u64, h u64, fy i32, out ptr i32)
    if groups_of(w) > 0
        down_neon(src - 2 * s, s, out as u64, groups_of(w), h, fy, (w is 4) as u64)
        give
    for each i in 0 until h
        new r0 = (src + i * s - 2 * s) as ptr u8
        new r1 = r0 + s
        new r2 = r1 + s
        new r3 = r2 + s
        new r4 = r3 + s
        new r5 = r4 + s
        new o = out + i * 16
        for each j in 0 until w
            new v = (r0[j] as i32) + (r5[j] as i32) - 5 * ((r1[j] as i32) + (r4[j] as i32)) + 20 * ((r2[j] as i32) + (r3[j] as i32))
            v = (v + 16) >> 5
            if v < 0
                v = 0
            else if v > 255
                v = 255
            if fy is 1
                v = (v + (r2[j] as i32) + 1) >> 1
            else if fy is 3
                v = (v + (r3[j] as i32) + 1) >> 1
            o[j] = v

-- Positions using the centre sample j (from the unclipped vertical half samples of
-- the columns around it): j itself, or j averaged with b (fx 2) or h (fy 2) nearby.
to middle (src u64, s u64, w u64, h u64, fx i32, fy i32, out ptr i32, vbuf ptr i32)
    if fx is 2 and fy is not 2
        across(src + (fy / 2) as u64 * s, s, w, h, 2, out)
    new n = w + 5
    new side = 2 + (fx / 2) as u64
    for each i in 0 until h
        new r0 = (src + i * s - 2 * s - 2) as ptr u8
        new r1 = r0 + s
        new r2 = r1 + s
        new r3 = r2 + s
        new r4 = r3 + s
        new r5 = r4 + s
        new row = vbuf + i * n
        for each c in 0 until n
            row[c] = (r0[c] as i32) + (r5[c] as i32) - 5 * ((r1[c] as i32) + (r4[c] as i32)) + 20 * ((r2[c] as i32) + (r3[c] as i32))
        new o = out + i * 16
        for each j in 0 until w
            new t = row[j] + row[j + 5] - 5 * (row[j + 1] + row[j + 4]) + 20 * (row[j + 2] + row[j + 3])
            new v = (t + 512) >> 10
            if v < 0
                v = 0
            else if v > 255
                v = 255
            if fx is 2
                if fy is not 2
                    v = (o[j] + v + 1) >> 1
            else
                new e = (row[j + side] + 16) >> 5
                if e < 0
                    e = 0
                else if e > 255
                    e = 255
                v = (e + v + 1) >> 1
            o[j] = v

-- A w x h chroma block, mv in eighth samples, into `out`.
-- wh: w | h << 8 | plane << 16 (0 Cb, 1 Cr) | out's row stride << 24
to chroma (pic ptr h264state.picture, x0 i64, y0 i64, wh u64, mvx i32, mvy i32, out ptr i32)
    new w = wh & 255
    new h = (wh >> 8) & 255
    new os = wh >> 24
    new width = (pic.alloc_w as i64) * 8
    new height = (pic.alloc_h as i64) * 8
    new pad = h264state.cpad as i64
    new xi = x0 + (mvx >> 3) as i64
    if xi < 0 - pad
        xi = 0 - pad
    else if xi > width + pad - w as i64 - 1
        xi = width + pad - w as i64 - 1
    new yi = y0 + (mvy >> 3) as i64
    if yi < 0 - pad
        yi = 0 - pad
    else if yi > height + pad - h as i64 - 1
        yi = height + pad - h as i64 - 1
    new fx = mvx & 7
    new fy = mvy & 7
    new p = pic.u
    if (wh >> 16) & 255 is 1
        p = pic.v
    new s = pic.cstride
    new ca = (8 - fx) * (8 - fy)
    new cb = fx * (8 - fy)
    new cc = (8 - fx) * fy
    new cd = fx * fy
    if w is 8 or w is 4
        new src = (p as i64 + yi * s as i64 + xi) as u64
        new wts = (ca | (cb << 8) | (cc << 16) | (cd << 24)) as u32
        new half u64 = 0
        if w is 4
            half = 1
        chroma_neon(src, s, out as u64, os * 4, h, wts, half)
        give
    for each i in 0 until h
        new r0 = (p as i64 + (yi + i as i64) * s as i64 + xi) as ptr u8
        new r1 = r0 + s
        new o = out + i * os
        for each j in 0 until w
            o[j] = (ca * (r0[j] as i32) + cb * (r0[j + 1] as i32) + cc * (r1[j] as i32) + cd * (r1[j + 1] as i32) + 32) >> 6

-- NEON: h rows of 8 chroma samples (4 with `half`), each the weighted sum of four
-- (wts = ca | cb << 8 | cc << 16 | cd << 24) rounded >> 6, from rows `s` bytes apart
-- into i32 rows `ob` bytes apart.
to chroma_neon (src u64, s u64, out u64, ob u64, h u64, wts u32, half u64)
    asm
        "dup v20.8b, {wts}"
        "lsr {wts}, {wts}, #8"
        "dup v21.8b, {wts}"
        "lsr {wts}, {wts}, #8"
        "dup v22.8b, {wts}"
        "lsr {wts}, {wts}, #8"
        "dup v23.8b, {wts}"
        "add x16, {src}, #1"
        "ld1 {v0.8b}, [{src}], {s}"
        "ld1 {v1.8b}, [x16], {s}"
        "1:"
        "ld1 {v2.8b}, [{src}], {s}"
        "ld1 {v3.8b}, [x16], {s}"
        "umull v4.8h, v0.8b, v20.8b"
        "umlal v4.8h, v1.8b, v21.8b"
        "umlal v4.8h, v2.8b, v22.8b"
        "umlal v4.8h, v3.8b, v23.8b"
        "rshrn v4.8b, v4.8h, #6"
        "uxtl v4.8h, v4.8b"
        "uxtl v5.4s, v4.4h"
        "uxtl2 v6.4s, v4.8h"
        "cbnz {half}, 2f"
        "st1 {v5.4s, v6.4s}, [{out}], {ob}"
        "b 3f"
        "2:"
        "st1 {v5.4s}, [{out}], {ob}"
        "3:"
        "mov v0.16b, v2.16b"
        "mov v1.16b, v3.16b"
        "subs {h}, {h}, #1"
        "b.ne 1b"

-- ---------------------------------------------------------------- one partition

to picture_of (d ptr h264state.decoder, lst u64, ref i32) gives ptr h264state.picture
    new slot = d.list[lst * 32 + ref as u64]
    if slot is 0
        give 0 as ptr h264state.picture
    give addr of d.pics[slot - 1]

to cdiv (a i32, b i32) gives i32
    new q = h264state.abs(a) / h264state.abs(b)
    if (a >= 0) is (b >= 0)
        give q
    give 0 - q

-- Implicit bi-prediction weights for refs (r0, r1): w1 in the low half, w0 in the high.
to implicit (d ptr h264state.decoder, r0 i32, r1 i32, w0 ptr i32, w1 ptr i32)
    deref w0 = 32
    deref w1 = 32
    new p0 = picture_of(d, 0, r0)
    new p1 = picture_of(d, 1, r1)
    new tb = h264state.clip(d.poc - p0.poc, -128, 127)
    new td = h264state.clip(p1.poc - p0.poc, -128, 127)
    if td is 0 or p0.ref is 2 or p1.ref is 2
        give
    new tx = cdiv(16384 + h264state.abs(cdiv(td, 2)), td)
    new dsf = h264state.clip((tb * tx + 32) >> 6, -1024, 1023)
    if (dsf >> 2) < -64 or (dsf >> 2) > 128
        give
    deref w1 = dsf >> 2
    deref w0 = 64 - (dsf >> 2)

-- The prediction of an inter macroblock from the motion stored for it (a reference
-- per 8x8 and list, a motion vector per 4x4 block), in as few blocks as give the
-- same samples.
to predict_mb (d ptr h264state.decoder, m ptr h264state.mbinfo)
    new refs [2] i32
    new mv [4] i32
    if same_refs(m) and same_motion(m, 0, 16)
        refs[0] = m.ref[0] as i32
        refs[1] = m.ref[4] as i32
        motion_of(m, 0, addr of mv[0])
        predict(d, 0, 0, 16, 16, addr of refs[0], addr of mv[0])
        give
    for each b8 in 0 until 4
        refs[0] = m.ref[b8] as i32
        refs[1] = m.ref[4 + b8] as i32
        new bx = (b8 % 2) * 8
        new by = (b8 / 2) * 8
        if same_motion(m, b8 * 4, 4)
            motion_of(m, b8 * 4, addr of mv[0])
            predict(d, bx, by, 8, 8, addr of refs[0], addr of mv[0])
            skip
        for each k in 0 until 4
            motion_of(m, b8 * 4 + k, addr of mv[0])
            predict(d, bx + (k % 2) * 4, by + (k / 2) * 4, 4, 4, addr of refs[0], addr of mv[0])

-- Do all four 8x8 blocks use the same references?
to same_refs (m ptr h264state.mbinfo) gives bool
    for each b8 in 1 until 4
        if m.ref[b8] is not m.ref[0] or m.ref[4 + b8] is not m.ref[4]
            give false
    give true

-- Do blocks first .. first + count - 1 (in decoding order) move alike in the lists
-- they use? (Their 8x8 blocks' references are the same.)
to same_motion (m ptr h264state.mbinfo, first u64, count u64) gives bool
    for each lst in 0 until 2
        if m.ref[lst * 4 + first / 4] < 0
            skip
        new k0 = (lst * 16 + first) * 2
        for each b in 1 until count
            new k = (lst * 16 + first + b) * 2
            if m.mv[k] is not m.mv[k0] or m.mv[k + 1] is not m.mv[k0 + 1]
                give false
    give true

to motion_of (m ptr h264state.mbinfo, blk u64, mv ptr i32)
    for each lst in 0 until 2
        mv[lst * 2] = m.mv[(lst * 16 + blk) * 2] as i32
        mv[lst * 2 + 1] = m.mv[(lst * 16 + blk) * 2 + 1] as i32

-- Predict the w x h luma block at (x, y) of the current macroblock (and its chroma)
-- from refs[0] / refs[1] (-1 = list not used) with motion vectors mv[0..3].
to predict (d ptr h264state.decoder, x u64, y u64, w u64, h u64, refs ptr i32, mv ptr i32)
    new mode u32 = 0
    if d.stype is 0 and d.p.weighted
        mode = 1
    if d.stype is 1
        mode = d.p.bipred
    new count u64 = 0
    new first u64 = 0
    for each lst in 0 until 2
        if refs[lst] >= 0
            if count is 0
                first = lst
            count += 1
    if count is 0
        give
    -- one list without weights: straight into the prediction
    new direct = count is 1 and mode is not 1
    new cx = ((d.mbx + x) / 2) as i64
    new cy = ((d.mby + y) / 2) as i64
    new cwh = (w / 2) | ((h / 2) << 8)
    for each lst in 0 until 2
        if refs[lst] < 0
            skip
        new pic = picture_of(d, lst, refs[lst])
        new mx = mv[lst * 2]
        new my = mv[lst * 2 + 1]
        if direct
            luma(pic, (d.mbx + x) as i64, (d.mby + y) as i64, w | (h << 8), mx, my, addr of d.pred_y[y * 16 + x], addr of d.vbuf[0])
            chroma(pic, cx, cy, cwh | (8 << 24), mx, my, addr of d.pred_c[(y / 2) * 8 + x / 2])
            chroma(pic, cx, cy, cwh | (1 << 16) | (8 << 24), mx, my, addr of d.pred_c[64 + (y / 2) * 8 + x / 2])
        else
            new base = lst * 256
            luma(pic, (d.mbx + x) as i64, (d.mby + y) as i64, w | (h << 8), mx, my, addr of d.tmp[base], addr of d.vbuf[0])
            chroma(pic, cx, cy, cwh | (16 << 24), mx, my, addr of d.tmp[512 + base])
            chroma(pic, cx, cy, cwh | (1 << 16) | (16 << 24), mx, my, addr of d.tmp[512 + base + 128])
    if direct
        give
    if mode is 0
        -- default bi-prediction: the rounded average
        for each i in 0 until h
            new a = addr of d.tmp[i * 16]
            new b = addr of d.tmp[256 + i * 16]
            new o = addr of d.pred_y[(y + i) * 16 + x]
            for each j in 0 until w
                o[j] = (a[j] + b[j] + 1) >> 1
        for each c in 0 until 2
            for each i in 0 until h / 2
                new a = addr of d.tmp[512 + c * 128 + i * 16]
                new b = addr of d.tmp[768 + c * 128 + i * 16]
                new o = addr of d.pred_c[c * 64 + (y / 2 + i) * 8 + x / 2]
                for each j in 0 until w / 2
                    o[j] = (a[j] + b[j] + 1) >> 1
        give
    -- weights
    new w0 i32 = 0
    new w1 i32 = 0
    new lw [2] i32
    new lo [2] i32
    new cw [4] i32
    new co [4] i32
    new ld u32 = d.lw_denom
    new cd u32 = d.cw_denom
    if mode is 1
        for each lst in 0 until 2
            if refs[lst] >= 0
                new r = refs[lst] as u64
                lw[lst] = d.w[lst].luma[r * 2]
                lo[lst] = d.w[lst].luma[r * 2 + 1]
                cw[lst * 2] = d.w[lst].cb[r * 2]
                co[lst * 2] = d.w[lst].cb[r * 2 + 1]
                cw[lst * 2 + 1] = d.w[lst].cr[r * 2]
                co[lst * 2 + 1] = d.w[lst].cr[r * 2 + 1]
    else if mode is 2 and count is 2
        implicit(d, refs[0], refs[1], addr of w0, addr of w1)
        lw[0] = w0
        lw[1] = w1
        lo[0] = 0
        lo[1] = 0
        for each k in 0 until 2
            cw[k] = w0
            cw[2 + k] = w1
            co[k] = 0
            co[2 + k] = 0
        ld = 5
        cd = 5
    if count is 1
        new f = first
        weigh_one(addr of d.tmp[f * 256], addr of d.pred_y[y * 16 + x], 16 | (w << 8) | (h << 16) | ((ld as u64) << 24), lw[f], lo[f])
        for each c in 0 until 2
            new g = 8 | ((w / 2) << 8) | ((h / 2) << 16) | ((cd as u64) << 24)
            weigh_one(addr of d.tmp[512 + f * 256 + c * 128], addr of d.pred_c[c * 64 + (y / 2) * 8 + x / 2], g, cw[f * 2 + c], co[f * 2 + c])
        give
    weigh_two(addr of d.tmp[0], addr of d.tmp[256], addr of d.pred_y[y * 16 + x], 16 | (w << 8) | (h << 16) | ((ld as u64) << 24), lw[0], lw[1], (lo[0] + lo[1] + 1) >> 1)
    for each c in 0 until 2
        new g = 8 | ((w / 2) << 8) | ((h / 2) << 16) | ((cd as u64) << 24)
        weigh_two(addr of d.tmp[512 + c * 128], addr of d.tmp[768 + c * 128], addr of d.pred_c[c * 64 + (y / 2) * 8 + x / 2], g, cw[c], cw[2 + c], (co[c] + co[2 + c] + 1) >> 1)

-- NEON weighting, 4 samples at a time (blocks a multiple of 4 wide): the rounding
-- shift right by a register (srshl by minus the shift) adds the same half as the
-- sums above, and smax/smin clamp to 0..255.
to weigh2_neon (a u64, b u64, out u64, g u64, w0 i32, w1 i32, o i32)
    asm
        "dup v16.4s, {w0}"
        "dup v17.4s, {w1}"
        "dup v18.4s, {o}"
        "ubfx x16, {g}, #24, #8"
        "add x16, x16, #1"
        "sub x16, xzr, x16"
        "dup v19.4s, w16"
        "movi v20.4s, #0"
        "movi v21.4s, #255"
        "ubfx x17, {g}, #8, #8"
        "lsr x17, x17, #2"
        "ubfx x4, {g}, #16, #8"
        "and x5, {g}, #255"
        "lsl x5, x5, #2"
        "1:"
        "mov x6, {a}"
        "mov x7, {b}"
        "mov x8, {out}"
        "mov x3, x17"
        "2:"
        "ld1 {v0.4s}, [x6], #16"
        "ld1 {v1.4s}, [x7], #16"
        "mul v0.4s, v0.4s, v16.4s"
        "mla v0.4s, v1.4s, v17.4s"
        "srshl v0.4s, v0.4s, v19.4s"
        "add v0.4s, v0.4s, v18.4s"
        "smax v0.4s, v0.4s, v20.4s"
        "smin v0.4s, v0.4s, v21.4s"
        "st1 {v0.4s}, [x8], #16"
        "subs x3, x3, #1"
        "b.ne 2b"
        "add {a}, {a}, #64"
        "add {b}, {b}, #64"
        "add {out}, {out}, x5"
        "subs x4, x4, #1"
        "b.ne 1b"

to weigh1_neon (src u64, out u64, g u64, wt i32, o i32)
    asm
        "dup v16.4s, {wt}"
        "dup v18.4s, {o}"
        "ubfx x16, {g}, #24, #8"
        "sub x16, xzr, x16"
        "dup v19.4s, w16"
        "movi v20.4s, #0"
        "movi v21.4s, #255"
        "ubfx x17, {g}, #8, #8"
        "lsr x17, x17, #2"
        "ubfx x4, {g}, #16, #8"
        "and x5, {g}, #255"
        "lsl x5, x5, #2"
        "1:"
        "mov x6, {src}"
        "mov x8, {out}"
        "mov x3, x17"
        "2:"
        "ld1 {v0.4s}, [x6], #16"
        "mul v0.4s, v0.4s, v16.4s"
        "srshl v0.4s, v0.4s, v19.4s"
        "add v0.4s, v0.4s, v18.4s"
        "smax v0.4s, v0.4s, v20.4s"
        "smin v0.4s, v0.4s, v21.4s"
        "st1 {v0.4s}, [x8], #16"
        "subs x3, x3, #1"
        "b.ne 2b"
        "add {src}, {src}, #64"
        "add {out}, {out}, x5"
        "subs x4, x4, #1"
        "b.ne 1b"

-- Explicit weighting of one prediction (8.4.2.3): src rows are 16 apart.
-- g: out's row stride | w << 8 | h << 16 | log2 denominator << 24
to weigh_one (src ptr i32, out ptr i32, g u64, wt i32, o i32)
    new os = g & 255
    new w = (g >> 8) & 255
    if w % 4 is 0
        weigh1_neon(src as u64, out as u64, g, wt, o)
        give
    new h = (g >> 16) & 255
    new denom = (g >> 24) as u32
    new round i32 = 0
    if denom >= 1
        round = (1 as i32) << (denom - 1)
    for each i in 0 until h
        new a = src + i * 16
        new r = out + i * os
        for each j in 0 until w
            new v = ((a[j] * wt + round) >> denom) + o
            if v < 0
                v = 0
            else if v > 255
                v = 255
            r[j] = v

-- Weighted bi-prediction (explicit or implicit), o the averaged offset.
to weigh_two (a ptr i32, b ptr i32, out ptr i32, g u64, w0 i32, w1 i32, o i32)
    new os = g & 255
    new w = (g >> 8) & 255
    if w % 4 is 0
        weigh2_neon(a as u64, b as u64, out as u64, g, w0, w1, o)
        give
    new h = (g >> 16) & 255
    new denom = (g >> 24) as u32
    new round = (1 as i32) << denom
    new sh = denom + 1
    for each i in 0 until h
        new pa = a + i * 16
        new pb = b + i * 16
        new r = out + i * os
        for each j in 0 until w
            new v = ((pa[j] * w0 + pb[j] * w1 + round) >> sh) + o
            if v < 0
                v = 0
            else if v > 255
                v = 255
            r[j] = v
