        "trn1 v22.16b, v14.16b, v15.16b"
        "trn2 v23.16b, v14.16b, v15.16b"
        "trn1 v24.8h, v16.8h, v18.8h"
        "trn2 v26.8h, v16.8h, v18.8h"
        "trn1 v25.8h, v17.8h, v19.8h"
        "trn2 v27.8h, v17.8h, v19.8h"
