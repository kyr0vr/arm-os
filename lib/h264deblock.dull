        "trn2 v30.8h, v20.8h, v22.8h"
        "trn1 v29.8h, v21.8h, v23.8h"
        "trn2 v31.8h, v21.8h, v23.8h"
        "trn1 v0.4s, v24.4s, v28.4s"
        "trn2 v4.4s, v24.4s, v28.4s"
        "trn1 v1.4s, v25.4s, v29.4s"
