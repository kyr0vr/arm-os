        "ld1 {v16.8b}, [x17], {stride}"
        "zip1 v6.2d, v6.2d, v16.2d"
        "ld1 {v7.8b}, [x16], {stride}"
        "ld1 {v16.8b}, [x17], {stride}"
        "zip1 v7.2d, v7.2d, v16.2d"
        "trn1 v16.16b, v0.16b, v1.16b"
        "trn2 v17.16b, v0.16b, v1.16b"
        "trn1 v18.16b, v2.16b, v3.16b"
