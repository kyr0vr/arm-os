        "trn1 v10.4s, v26.4s, v30.4s"
        "trn2 v14.4s, v26.4s, v30.4s"
        "trn1 v11.4s, v27.4s, v31.4s"
        "trn2 v15.4s, v27.4s, v31.4s"
        "ldrb w16, [{k}]"
        "dup v16.16b, w16"
        "ldrb w16, [{k}, #1]"
        "dup v17.16b, w16"
        "add x16, {k}, #16"
        "ld1 {v18.16b, v19.16b}, [x16]"
        "uabd v20.16b, v11.16b, v12.16b"
        "cmhi v20.16b, v16.16b, v20.16b"
        "uabd v21.16b, v10.16b, v11.16b"
        "cmhi v21.16b, v17.16b, v21.16b"
        "and v20.16b, v20.16b, v21.16b"
        "uabd v21.16b, v13.16b, v12.16b"
        "cmhi v21.16b, v17.16b, v21.16b"
        "and v20.16b, v20.16b, v21.16b"
