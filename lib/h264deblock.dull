        "trn1 v3.4s, v27.4s, v31.4s"
        "trn2 v7.4s, v27.4s, v31.4s"
        "sub x16, {s}, #4"
        "lsl x17, {stride}, #3"
        "add x17, x16, x17"
        "ext v16.16b, v0.16b, v0.16b, #8"
        "st1 {v0.8b}, [x16], {stride}"
        "st1 {v16.8b}, [x17], {stride}"
        "ext v16.16b, v1.16b, v1.16b, #8"
        "st1 {v1.8b}, [x16], {stride}"
        "st1 {v16.8b}, [x17], {stride}"
        "ext v16.16b, v2.16b, v2.16b, #8"
        "st1 {v2.8b}, [x16], {stride}"
        "st1 {v16.8b}, [x17], {stride}"
        "ext v16.16b, v3.16b, v3.16b, #8"
        "st1 {v3.8b}, [x16], {stride}"
        "st1 {v16.8b}, [x17], {stride}"
        "ext v16.16b, v4.16b, v4.16b, #8"
        "st1 {v4.8b}, [x16], {stride}"
        "st1 {v16.8b}, [x17], {stride}"
        "ext v16.16b, v5.16b, v5.16b, #8"
        "st1 {v5.8b}, [x16], {stride}"
        "st1 {v16.8b}, [x17], {stride}"
        "ext v16.16b, v6.16b, v6.16b, #8"
        "st1 {v6.8b}, [x16], {stride}"
        "st1 {v16.8b}, [x17], {stride}"
        "ext v16.16b, v7.16b, v7.16b, #8"
        "st1 {v7.8b}, [x16], {stride}"
        "st1 {v16.8b}, [x17], {stride}"

-- One edge: `n` lines starting at `s`, `along` apart, each filtered across with
-- `step`: p[-k * step] and q[k * step] (8.7.2).
-- np: lines | per << 8 (how many lines share one bS)
to edge (ss ptr h264state.slicestate, s ptr u8, along i64, step i64, np u64, bs ptr u32, qp i32, luma bool)
    new n = np & 255
    new per = np >> 8
    new shift u64 = 1
    if per is 4
        shift = 2
    new ia = qp + ss.alpha_off
    if ia < 0
        ia = 0
    else if ia > 51
        ia = 51
    new ib = qp + ss.beta_off
    if ib < 0
        ib = 0
    else if ib > 51
        ib = 51
    new alpha = h264tables.alpha[(ia + 12) as u64] as i32
    new beta = h264tables.beta[(ib + 12) as u64] as i32
    new tcs = (addr of h264tables.tc0[0]) + ((ia + 12) as u64) * 4
    if luma and n is 16 and bs[0] < 4 and bs[1] < 4 and bs[2] < 4 and bs[3] < 4
        -- all 16 lines at once
        new prm [48] u8
        prm[0] = alpha as u8
        prm[1] = beta as u8
        for each k in 0 until 16
            new b = bs[k >> 2]
            if b is not 0
                prm[16 + k] = tcs[b as u64] as u8
                prm[32 + k] = 0xFF
        if step is 1
            luma_columns_neon(s as u64, along as u64, addr of prm[0] as u64)
        else
            luma_rows_neon(s as u64, step as u64, addr of prm[0] as u64)
        give
    for each k in 0 until n
        new b = bs[k >> shift]
        if b is 0
            skip
        new tc0 = tcs[b as u64] as i32
        new base = s as i64 + k as i64 * along
        new p0 = ((base - step) as ptr u8)[0] as i32
        new q0 = (base as ptr u8)[0] as i32
        new d0 = p0 - q0
        if d0 < 0
            d0 = 0 - d0
        if d0 >= alpha
            skip
        new p1 = ((base - 2 * step) as ptr u8)[0] as i32
        new d1 = p1 - p0
        if d1 < 0
            d1 = 0 - d1
        if d1 >= beta
            skip
        new q1 = ((base + step) as ptr u8)[0] as i32
        new d2 = q1 - q0
        if d2 < 0
            d2 = 0 - d2
        if d2 >= beta
            skip
        new p2 i32 = 0
        new q2 i32 = 0
        new ap i32 = 0
        new aq i32 = 0
        if luma
            p2 = ((base - 3 * step) as ptr u8)[0] as i32
            q2 = ((base + 2 * step) as ptr u8)[0] as i32
            ap = p2 - p0
            if ap < 0
                ap = 0 - ap
            aq = q2 - q0
            if aq < 0
                aq = 0 - aq
        if b < 4
            new tc = tc0 + 1
            if luma
                tc = tc0
                if ap < beta
                    tc += 1
                if aq < beta
                    tc += 1
            new delta = (((q0 - p0) << 2) + (p1 - q1) + 4) >> 3
            if delta < 0 - tc
                delta = 0 - tc
            else if delta > tc
                delta = tc
            new np0 = p0 + delta
            if np0 < 0
                np0 = 0
            else if np0 > 255
                np0 = 255
            new nq0 = q0 - delta
            if nq0 < 0
                nq0 = 0
            else if nq0 > 255
                nq0 = 255
            ((base - step) as ptr u8)[0] = np0 as u8
            (base as ptr u8)[0] = nq0 as u8
            if luma
                if ap < beta
                    new t = (p2 + ((p0 + q0 + 1) >> 1) - (p1 << 1)) >> 1
                    if t < 0 - tc0
                        t = 0 - tc0
                    else if t > tc0
                        t = tc0
                    ((base - 2 * step) as ptr u8)[0] = (p1 + t) as u8
                if aq < beta
                    new t = (q2 + ((p0 + q0 + 1) >> 1) - (q1 << 1)) >> 1
                    if t < 0 - tc0
                        t = 0 - tc0
                    else if t > tc0
                        t = tc0
                    ((base + step) as ptr u8)[0] = (q1 + t) as u8
            skip
        -- bS 4
        new strong = d0 < ((alpha >> 2) + 2)
        if luma and ap < beta and strong
            new p3 = ((base - 4 * step) as ptr u8)[0] as i32
            ((base - step) as ptr u8)[0] = ((p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) >> 3) as u8
            ((base - 2 * step) as ptr u8)[0] = ((p2 + p1 + p0 + q0 + 2) >> 2) as u8
            ((base - 3 * step) as ptr u8)[0] = ((2 * p3 + 3 * p2 + p1 + p0 + q0 + 4) >> 3) as u8
        else
            ((base - step) as ptr u8)[0] = ((2 * p1 + p0 + q1 + 2) >> 2) as u8
        if luma and aq < beta and strong
            new q3 = ((base + 3 * step) as ptr u8)[0] as i32
            (base as ptr u8)[0] = ((p1 + 2 * p0 + 2 * q0 + 2 * q1 + q2 + 4) >> 3) as u8
            ((base + step) as ptr u8)[0] = ((p0 + q0 + q1 + q2 + 2) >> 2) as u8
            ((base + 2 * step) as ptr u8)[0] = ((2 * q3 + 3 * q2 + q1 + q0 + p0 + 4) >> 3) as u8
        else
            (base as ptr u8)[0] = ((2 * q1 + q0 + p1 + 2) >> 2) as u8

-- Deblock macroblock row `y` (the rows above it are done; its samples are not read
-- for prediction any more). Each macroblock goes by its own slice's settings.
to row (d ptr h264state.decoder, y u64)
    new w = d.s.mb_w as u64
    new pic = d.cur
    for each mbn in y * w until y * w + w
        new q = h264state.mb(d, mbn)
        if not q.avail
            skip
        new ss = h264state.slice_of(d, q)
        if ss.deblock_idc is 1
            skip
        new mx = (mbn % w) * 16
        new my = (mbn / w) * 16
        for each dir in 0 until 2
            for each e in 0 until 4
                if e > 0 and q.t8 and e % 2 is 1
                    skip
                new p = q
                if e is 0
                    if dir is 0 and mbn % w is 0
                        skip
                    if dir is 1 and mbn < w
                        skip
                    if dir is 0
                        p = h264state.mb(d, mbn - 1)
                    else
                        p = h264state.mb(d, mbn - w)
                    if ss.deblock_idc is 2 and p.slice is not q.slice
                        skip
                new bs [4] u32
                for each k in 0 until 4
                    new qb u64 = 0
                    new pb u64 = 0
                    if dir is 0
                        qb = h264state.blk_at[k * 4 + e] as u64
                        pb = h264state.blk_at[k * 4 + (e + 3) % 4] as u64
                    else
                        qb = h264state.blk_at[e * 4 + k] as u64
                        pb = h264state.blk_at[((e + 3) % 4) * 4 + k] as u64
                    bs[k] = strength(p, pb, q, qb, e is 0)
                if bs[0] | bs[1] | bs[2] | bs[3] is 0
                    skip
                new qpav = (p.qp + q.qp + 1) >> 1
                if dir is 0
                    new s = (pic.y as i64 + (my as i64) * pic.stride as i64 + (mx + e * 4) as i64) as ptr u8
                    edge(ss, s, pic.stride as i64, 1, 16 | (4 << 8), addr of bs[0], qpav, true)
                else
                    new s = (pic.y as i64 + ((my + e * 4) as i64) * pic.stride as i64 + mx as i64) as ptr u8
                    edge(ss, s, 1, pic.stride as i64, 16 | (4 << 8), addr of bs[0], qpav, true)
                if e % 2 is 0
                    for each c in 0 until 2
                        new plane = pic.u
                        if c is 1
                            plane = pic.v
                        new qpc = (p.qpc[c] + q.qpc[c] + 1) >> 1
                        new cx = mx / 2
                        new cy = my / 2
                        if dir is 0
                            new s = (plane as i64 + (cy as i64) * pic.cstride as i64 + (cx + e * 2) as i64) as ptr u8
                            edge(ss, s, pic.cstride as i64, 1, 8 | (2 << 8), addr of bs[0], qpc, false)
                        else
                            new s = (plane as i64 + ((cy + e * 2) as i64) * pic.cstride as i64 + cx as i64) as ptr u8
                            edge(ss, s, 1, pic.cstride as i64, 8 | (2 << 8), addr of bs[0], qpc, false)
