-- The deblocking filter (8.7): every macroblock's vertical edges, then its
-- horizontal ones, luma and chroma, with a strength (bS) for each 4-sample segment.

use h264state
use h264tables

to far (p ptr h264state.mbinfo, pl u64, pb u64, q ptr h264state.mbinfo, ql u64, qb u64) gives bool
    new dx = h264state.abs(p.mv[(pl * 16 + pb) * 2] as i32 - q.mv[(ql * 16 + qb) * 2] as i32)
    new dy = h264state.abs(p.mv[(pl * 16 + pb) * 2 + 1] as i32 - q.mv[(ql * 16 + qb) * 2 + 1] as i32)
    give dx >= 4 or dy >= 4

-- bS between block pb of P and block qb of Q.
to strength (p ptr h264state.mbinfo, pb u64, q ptr h264state.mbinfo, qb u64, mb_edge bool) gives u32
    if p.intra or q.intra
        if mb_edge
            give 4
        give 3
    if (p.nz >> pb as u32) & 1 is 1 or (q.nz >> qb as u32) & 1 is 1
        give 2
    new pr [2] u32
    new pl [2] u64
    new np u64 = 0
    new qr [2] u32
    new ql [2] u64
    new nq u64 = 0
    for each l in 0 until 2
        if p.ref[l * 4 + pb / 4] >= 0
            pr[np] = p.refpic[l * 4 + pb / 4]
            pl[np] = l
            np += 1
        if q.ref[l * 4 + qb / 4] >= 0
            qr[nq] = q.refpic[l * 4 + qb / 4]
            ql[nq] = l
            nq += 1
    if np is not nq
        give 1
    if np is 1
        if pr[0] is not qr[0]
            give 1
        if far(p, pl[0], pb, q, ql[0], qb)
            give 1
        give 0
    if np is 0
        give 0
    new straight = pr[0] is qr[0] and pr[1] is qr[1]
    new crossed = pr[0] is qr[1] and pr[1] is qr[0]
    if not straight and not crossed
        give 1
    if pr[0] is not pr[1]
        if straight
            if far(p, pl[0], pb, q, ql[0], qb) or far(p, pl[1], pb, q, ql[1], qb)
                give 1
            give 0
        if far(p, pl[0], pb, q, ql[1], qb) or far(p, pl[1], pb, q, ql[0], qb)
            give 1
        give 0
    new a = far(p, pl[0], pb, q, ql[0], qb) or far(p, pl[1], pb, q, ql[1], qb)
    new b = far(p, pl[0], pb, q, ql[1], qb) or far(p, pl[1], pb, q, ql[0], qb)
    if a and b
        give 1
    give 0

-- One edge: `n` lines starting at `s`, `along` apart, each filtered across with
-- `step`: p[-k * step] and q[k * step] (8.7.2).
-- np: lines | per << 8 (how many lines share one bS)
to edge (d ptr h264state.decoder, s ptr u8, along i64, step i64, np u64, bs ptr u32, qp i32, luma bool)
    new n = np & 255
    new per = np >> 8
    new shift u64 = 1
    if per is 4
        shift = 2
    new ia = qp + d.alpha_off
    if ia < 0
        ia = 0
    else if ia > 51
        ia = 51
    new ib = qp + d.beta_off
    if ib < 0
        ib = 0
    else if ib > 51
        ib = 51
    new alpha = h264tables.alpha[(ia + 12) as u64] as i32
    new beta = h264tables.beta[(ib + 12) as u64] as i32
    new tcs = (addr of h264tables.tc0[0]) + ((ia + 12) as u64) * 4
    for each k in 0 until n
        new b = bs[k >> shift]
        if b is 0
            skip
        new tc0 = tcs[b as u64] as i32
        new base = s as i64 + k as i64 * along
        new p0 = ((base - step) as ptr u8)[0] as i32
        new q0 = (base as ptr u8)[0] as i32
        new d0 = p0 - q0
        if d0 < 0
            d0 = 0 - d0
        if d0 >= alpha
            skip
        new p1 = ((base - 2 * step) as ptr u8)[0] as i32
        new d1 = p1 - p0
        if d1 < 0
            d1 = 0 - d1
        if d1 >= beta
            skip
        new q1 = ((base + step) as ptr u8)[0] as i32
        new d2 = q1 - q0
        if d2 < 0
            d2 = 0 - d2
        if d2 >= beta
            skip
        new p2 i32 = 0
        new q2 i32 = 0
        new ap i32 = 0
        new aq i32 = 0
        if luma
            p2 = ((base - 3 * step) as ptr u8)[0] as i32
            q2 = ((base + 2 * step) as ptr u8)[0] as i32
            ap = p2 - p0
            if ap < 0
                ap = 0 - ap
            aq = q2 - q0
            if aq < 0
                aq = 0 - aq
        if b < 4
            new tc = tc0 + 1
            if luma
                tc = tc0
                if ap < beta
                    tc += 1
                if aq < beta
                    tc += 1
            new delta = (((q0 - p0) << 2) + (p1 - q1) + 4) >> 3
            if delta < 0 - tc
                delta = 0 - tc
            else if delta > tc
                delta = tc
            new np0 = p0 + delta
            if np0 < 0
                np0 = 0
            else if np0 > 255
                np0 = 255
            new nq0 = q0 - delta
            if nq0 < 0
                nq0 = 0
            else if nq0 > 255
                nq0 = 255
            ((base - step) as ptr u8)[0] = np0 as u8
            (base as ptr u8)[0] = nq0 as u8
            if luma
                if ap < beta
                    new t = (p2 + ((p0 + q0 + 1) >> 1) - (p1 << 1)) >> 1
                    if t < 0 - tc0
                        t = 0 - tc0
                    else if t > tc0
                        t = tc0
                    ((base - 2 * step) as ptr u8)[0] = (p1 + t) as u8
                if aq < beta
                    new t = (q2 + ((p0 + q0 + 1) >> 1) - (q1 << 1)) >> 1
                    if t < 0 - tc0
                        t = 0 - tc0
                    else if t > tc0
                        t = tc0
                    ((base + step) as ptr u8)[0] = (q1 + t) as u8
            skip
        -- bS 4
        new strong = d0 < ((alpha >> 2) + 2)
        if luma and ap < beta and strong
            new p3 = ((base - 4 * step) as ptr u8)[0] as i32
            ((base - step) as ptr u8)[0] = ((p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4) >> 3) as u8
            ((base - 2 * step) as ptr u8)[0] = ((p2 + p1 + p0 + q0 + 2) >> 2) as u8
            ((base - 3 * step) as ptr u8)[0] = ((2 * p3 + 3 * p2 + p1 + p0 + q0 + 4) >> 3) as u8
        else
            ((base - step) as ptr u8)[0] = ((2 * p1 + p0 + q1 + 2) >> 2) as u8
        if luma and aq < beta and strong
            new q3 = ((base + 3 * step) as ptr u8)[0] as i32
            (base as ptr u8)[0] = ((p1 + 2 * p0 + 2 * q0 + 2 * q1 + q2 + 4) >> 3) as u8
            ((base + step) as ptr u8)[0] = ((p0 + q0 + q1 + q2 + 2) >> 2) as u8
            ((base + 2 * step) as ptr u8)[0] = ((2 * q3 + 3 * q2 + q1 + q0 + p0 + 4) >> 3) as u8
        else
            (base as ptr u8)[0] = ((2 * q1 + q0 + p1 + 2) >> 2) as u8

to picture (d ptr h264state.decoder)
    if d.deblock_idc is 1
        give
    new w = d.s.mb_w as u64
    new pic = d.cur
    for each mbn in 0 until d.mb_count
        new q = h264state.mb(d, mbn)
        new mx = (mbn % w) * 16
        new my = (mbn / w) * 16
        for each dir in 0 until 2
            for each e in 0 until 4
                if e > 0 and q.t8 and e % 2 is 1
                    skip
                new p = q
                if e is 0
                    if dir is 0 and mbn % w is 0
                        skip
                    if dir is 1 and mbn < w
                        skip
                    if dir is 0
                        p = h264state.mb(d, mbn - 1)
                    else
                        p = h264state.mb(d, mbn - w)
                    if d.deblock_idc is 2 and p.slice is not q.slice
                        skip
                new bs [4] u32
                for each k in 0 until 4
                    new qb u64 = 0
                    new pb u64 = 0
                    if dir is 0
                        qb = h264state.block_at(e, k)
                        pb = h264state.block_at((e + 3) % 4, k)
                    else
                        qb = h264state.block_at(k, e)
                        pb = h264state.block_at(k, (e + 3) % 4)
                    bs[k] = strength(p, pb, q, qb, e is 0)
                if bs[0] | bs[1] | bs[2] | bs[3] is 0
                    skip
                new qpav = (p.qp + q.qp + 1) >> 1
                if dir is 0
                    new s = (pic.y as i64 + (my as i64) * pic.stride as i64 + (mx + e * 4) as i64) as ptr u8
                    edge(d, s, pic.stride as i64, 1, 16 | (4 << 8), addr of bs[0], qpav, true)
                else
                    new s = (pic.y as i64 + ((my + e * 4) as i64) * pic.stride as i64 + mx as i64) as ptr u8
                    edge(d, s, 1, pic.stride as i64, 16 | (4 << 8), addr of bs[0], qpav, true)
                if e % 2 is 0
                    for each c in 0 until 2
                        new plane = pic.u
                        if c is 1
                            plane = pic.v
                        new qpc = (p.qpc[c] + q.qpc[c] + 1) >> 1
                        new cx = mx / 2
                        new cy = my / 2
                        if dir is 0
                            new s = (plane as i64 + (cy as i64) * pic.cstride as i64 + (cx + e * 2) as i64) as ptr u8
                            edge(d, s, pic.cstride as i64, 1, 8 | (2 << 8), addr of bs[0], qpc, false)
                        else
                            new s = (plane as i64 + ((cy + e * 2) as i64) * pic.cstride as i64 + cx as i64) as ptr u8
                            edge(d, s, 1, pic.cstride as i64, 8 | (2 << 8), addr of bs[0], qpc, false)
