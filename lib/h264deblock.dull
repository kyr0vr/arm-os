-- The deblocking filter (8.7): every macroblock's vertical edges, then its
-- horizontal ones, luma and chroma, with a strength (bS) for each 4-sample segment.

use h264state
use h264tables

to far (p ptr h264state.mbinfo, pl u64, pb u64, q ptr h264state.mbinfo, ql u64, qb u64) gives bool
    new kp = (pl * 16 + pb) * 2
    new kq = (ql * 16 + qb) * 2
    new dx = p.mv[kp] as i32 - q.mv[kq] as i32
    new dy = p.mv[kp + 1] as i32 - q.mv[kq + 1] as i32
    give dx >= 4 or dx <= -4 or dy >= 4 or dy <= -4

-- bS between block pb of P and block qb of Q (8.7.2.1). A list a block does not
-- use has picture id 0, so the two blocks use the same pictures when their id pairs
-- match either way round.
to strength (p ptr h264state.mbinfo, pb u64, q ptr h264state.mbinfo, qb u64, mb_edge bool) gives u32
    if p.intra or q.intra
        if mb_edge
            give 4
        give 3
    if (p.nz >> pb as u32) & 1 is 1 or (q.nz >> qb as u32) & 1 is 1
        give 2
    new p8 = pb / 4
    new q8 = qb / 4
    new pr0 = p.refpic[p8]
    new pr1 = p.refpic[4 + p8]
    new qr0 = q.refpic[q8]
    new qr1 = q.refpic[4 + q8]
    new straight = pr0 is qr0 and pr1 is qr1
    new crossed = pr0 is qr1 and pr1 is qr0
    if not straight and not crossed
        give 1
    if pr0 is 0 or pr1 is 0
        if pr0 is 0 and pr1 is 0
            give 0
        -- one list each
        new lp u64 = 0
        if pr0 is 0
            lp = 1
        new lq u64 = 0
        if qr0 is 0
            lq = 1
        if far(p, lp, pb, q, lq, qb)
            give 1
        give 0
    if pr0 is not pr1
        if straight
            if far(p, 0, pb, q, 0, qb) or far(p, 1, pb, q, 1, qb)
                give 1
            give 0
        if far(p, 0, pb, q, 1, qb) or far(p, 1, pb, q, 0, qb)
            give 1
        give 0
    -- both lists from the same picture: either pairing may hold
    if (far(p, 0, pb, q, 0, qb) or far(p, 1, pb, q, 1, qb)) and (far(p, 0, pb, q, 1, qb) or far(p, 1, pb, q, 0, qb))
        give 1
    give 0

-- NEON: the luma filter for bS 1-3 on 16 lines at once (8.7.2.3), for a horizontal
-- edge (rows above and below s are each 16 samples of the 16 lines) or a vertical
-- one (16 rows, each line's 8 samples, turned to columns and back). k: alpha, beta,
-- then from byte 16 each line's tc0, then 0xFF for each line to filter.
to luma_rows_neon (s u64, stride u64, k u64)
    asm
        "ldrb w16, [{k}]"
        "dup v16.16b, w16"
        "ldrb w16, [{k}, #1]"
        "dup v17.16b, w16"
        "add x16, {k}, #16"
        "ld1 {v18.16b, v19.16b}, [x16]"
        "mov x17, #3"
        "mul x17, x17, {stride}"
        "sub x16, {s}, x17"
        "ld1 {v0.16b}, [x16], {stride}"
        "ld1 {v1.16b}, [x16], {stride}"
        "ld1 {v2.16b}, [x16], {stride}"
        "ld1 {v3.16b}, [x16], {stride}"
        "ld1 {v4.16b}, [x16], {stride}"
        "ld1 {v5.16b}, [x16], {stride}"
        "uabd v20.16b, v2.16b, v3.16b"
        "cmhi v20.16b, v16.16b, v20.16b"
        "uabd v21.16b, v1.16b, v2.16b"
        "cmhi v21.16b, v17.16b, v21.16b"
        "and v20.16b, v20.16b, v21.16b"
        "uabd v21.16b, v4.16b, v3.16b"
        "cmhi v21.16b, v17.16b, v21.16b"
        "and v20.16b, v20.16b, v21.16b"
        "and v20.16b, v20.16b, v19.16b"
        "uabd v22.16b, v0.16b, v2.16b"
        "cmhi v22.16b, v17.16b, v22.16b"
        "and v22.16b, v22.16b, v20.16b"
        "uabd v23.16b, v5.16b, v3.16b"
        "cmhi v23.16b, v17.16b, v23.16b"
        "and v23.16b, v23.16b, v20.16b"
        "sub v24.16b, v18.16b, v22.16b"
        "sub v24.16b, v24.16b, v23.16b"
        "urhadd v25.16b, v2.16b, v3.16b"
        "usubl v26.8h, v3.8b, v2.8b"
        "shl v26.8h, v26.8h, #2"
        "usubl v27.8h, v1.8b, v4.8b"
        "add v26.8h, v26.8h, v27.8h"
        "srshr v26.8h, v26.8h, #3"
        "uxtl v27.8h, v24.8b"
        "smin v26.8h, v26.8h, v27.8h"
        "neg v27.8h, v27.8h"
        "smax v26.8h, v26.8h, v27.8h"
        "uxtl v28.8h, v2.8b"
        "add v28.8h, v28.8h, v26.8h"
        "sqxtun v30.8b, v28.8h"
        "uxtl v28.8h, v3.8b"
        "sub v28.8h, v28.8h, v26.8h"
        "sqxtun v31.8b, v28.8h"
        "uaddl v28.8h, v0.8b, v25.8b"
        "uxtl v29.8h, v1.8b"
        "shl v29.8h, v29.8h, #1"
        "sub v28.8h, v28.8h, v29.8h"
        "sshr v28.8h, v28.8h, #1"
        "uxtl v29.8h, v18.8b"
        "smin v28.8h, v28.8h, v29.8h"
        "neg v29.8h, v29.8h"
        "smax v28.8h, v28.8h, v29.8h"
        "uxtl v29.8h, v1.8b"
        "add v28.8h, v28.8h, v29.8h"
        "xtn v6.8b, v28.8h"
        "uaddl v28.8h, v5.8b, v25.8b"
        "uxtl v29.8h, v4.8b"
        "shl v29.8h, v29.8h, #1"
        "sub v28.8h, v28.8h, v29.8h"
        "sshr v28.8h, v28.8h, #1"
        "uxtl v29.8h, v18.8b"
        "smin v28.8h, v28.8h, v29.8h"
        "neg v29.8h, v29.8h"
        "smax v28.8h, v28.8h, v29.8h"
        "uxtl v29.8h, v4.8b"
        "add v28.8h, v28.8h, v29.8h"
        "xtn v7.8b, v28.8h"
        "usubl2 v26.8h, v3.16b, v2.16b"
        "shl v26.8h, v26.8h, #2"
        "usubl2 v27.8h, v1.16b, v4.16b"
        "add v26.8h, v26.8h, v27.8h"
        "srshr v26.8h, v26.8h, #3"
        "uxtl2 v27.8h, v24.16b"
        "smin v26.8h, v26.8h, v27.8h"
        "neg v27.8h, v27.8h"
        "smax v26.8h, v26.8h, v27.8h"
        "uxtl2 v28.8h, v2.16b"
        "add v28.8h, v28.8h, v26.8h"
        "sqxtun2 v30.16b, v28.8h"
        "uxtl2 v28.8h, v3.16b"
        "sub v28.8h, v28.8h, v26.8h"
        "sqxtun2 v31.16b, v28.8h"
        "uaddl2 v28.8h, v0.16b, v25.16b"
        "uxtl2 v29.8h, v1.16b"
        "shl v29.8h, v29.8h, #1"
        "sub v28.8h, v28.8h, v29.8h"
        "sshr v28.8h, v28.8h, #1"
        "uxtl2 v29.8h, v18.16b"
        "smin v28.8h, v28.8h, v29.8h"
        "neg v29.8h, v29.8h"
        "smax v28.8h, v28.8h, v29.8h"
        "uxtl2 v29.8h, v1.16b"
        "add v28.8h, v28.8h, v29.8h"
        "xtn2 v6.16b, v28.8h"
        "uaddl2 v28.8h, v5.16b, v25.16b"
        "uxtl2 v29.8h, v4.16b"
        "shl v29.8h, v29.8h, #1"
        "sub v28.8h, v28.8h, v29.8h"
        "sshr v28.8h, v28.8h, #1"
        "uxtl2 v29.8h, v18.16b"
        "smin v28.8h, v28.8h, v29.8h"
        "neg v29.8h, v29.8h"
        "smax v28.8h, v28.8h, v29.8h"
        "uxtl2 v29.8h, v4.16b"
        "add v28.8h, v28.8h, v29.8h"
        "xtn2 v7.16b, v28.8h"
        "bit v2.16b, v30.16b, v20.16b"
        "bit v3.16b, v31.16b, v20.16b"
        "bit v1.16b, v6.16b, v22.16b"
        "bit v4.16b, v7.16b, v23.16b"
        "sub x16, {s}, {stride}"
        "sub x16, x16, {stride}"
        "st1 {v1.16b}, [x16], {stride}"
        "st1 {v2.16b}, [x16], {stride}"
        "st1 {v3.16b}, [x16], {stride}"
        "st1 {v4.16b}, [x16], {stride}"

to luma_columns_neon (s u64, stride u64, k u64)
    asm
        "sub x16, {s}, #4"
        "lsl x17, {stride}, #3"
        "add x17, x16, x17"
        "ld1 {v0.8b}, [x16], {stride}"
        "ld1 {v16.8b}, [x17], {stride}"
        "zip1 v0.2d, v0.2d, v16.2d"
        "ld1 {v1.8b}, [x16], {stride}"
        "ld1 {v16.8b}, [x17], {stride}"
        "zip1 v1.2d, v1.2d, v16.2d"
        "ld1 {v2.8b}, [x16], {stride}"
        "ld1 {v16.8b}, [x17], {stride}"
        "zip1 v2.2d, v2.2d, v16.2d"
        "ld1 {v3.8b}, [x16], {stride}"
