        "uaddl2 v28.8h, v9.16b, v25.16b"
        "uxtl2 v29.8h, v10.16b"
        "shl v29.8h, v29.8h, #1"
        "sub v28.8h, v28.8h, v29.8h"
        "sshr v28.8h, v28.8h, #1"
        "uxtl2 v29.8h, v18.16b"
        "smin v28.8h, v28.8h, v29.8h"
        "neg v29.8h, v29.8h"
        "smax v28.8h, v28.8h, v29.8h"
        "uxtl2 v29.8h, v10.16b"
        "add v28.8h, v28.8h, v29.8h"
        "xtn2 v6.16b, v28.8h"
        "uaddl2 v28.8h, v14.16b, v25.16b"
        "uxtl2 v29.8h, v13.16b"
        "shl v29.8h, v29.8h, #1"
        "sub v28.8h, v28.8h, v29.8h"
