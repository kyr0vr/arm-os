        "neg v27.8h, v27.8h"
        "smax v26.8h, v26.8h, v27.8h"
        "uxtl2 v28.8h, v11.16b"
        "add v28.8h, v28.8h, v26.8h"
        "sqxtun2 v30.16b, v28.8h"
        "uxtl2 v28.8h, v12.16b"
