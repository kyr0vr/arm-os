-- Rebuilding pictures apart from parsing them, so other cores can do it: the parser
-- (lib/h264.dull) keeps every macroblock's coefficients and each slice's settings,
-- and lanes rebuild the picture row by row from those and the motion stored per
-- macroblock. With n lanes, lane i takes rows i, i + n, i + 2n ...: it rebuilds its
-- row as far as the parser and the row above have got (intra prediction looks up
-- and to the right), then deblocks the row above it, whose samples nothing reads
-- any more. With no lanes the same rows are rebuilt here once a picture is parsed.
--
-- Lanes run on helper cores (rt/app/helpers.dull): the app starts `lane` on each
-- with `lane_arg` and then calls `use_lanes`. Cores wait for each other by watching
-- counters in memory, with a dmb after each look and before each change. Between
-- macroblocks, and while they wait, lanes also take their part of side jobs the app
-- hands out with `start_job` (turning a picture into screen pixels, say).

use mem
use h264state
use h264mc
use h264recon
use h264deblock
use h264motion

fixed coef_size u64 = 408       -- i32s per macroblock: 256 luma, 16 luma DC, 8 chroma DC, 128 chroma AC

shape lanerec
    main  ptr h264state.decoder
    own   ptr h264state.decoder         -- the lane's own copy (current macroblock, scratch)
    index u64
    gone  bool                          -- the lane has stopped
    job_seen u64                        -- the last side job it did its part of
    idle  u64                           -- counter ticks spent waiting

-- ---------------------------------------------------------------- the parser's side

-- Where macroblock `a`'s coefficients go.
to point (d ptr h264state.decoder, a u64)
    new c = d.coef + a * coef_size
    d.luma = c
    d.luma8 = c
    d.dc = c + 256
    d.cdc = c + 272
    d.cac = c + 280

-- A slice header has been read: keep what rebuilding its macroblocks needs.
to snapshot (d ptr h264state.decoder)
    new ss = d.slices + (d.slice_no as u64) % h264state.max_slices
    ss.p = d.p
    ss.s = d.s
    ss.stype = d.stype
    ss.spatial = d.spatial
    ss.nref[0] = d.nref[0]
    ss.nref[1] = d.nref[1]
    ss.lw_denom = d.lw_denom
    ss.cw_denom = d.cw_denom
    ss.deblock_idc = d.deblock_idc
    ss.alpha_off = d.alpha_off
    ss.beta_off = d.beta_off
    ss.w[0] = d.w[0]
    ss.w[1] = d.w[1]
    for each i in 0 until 64
        ss.list[i] = d.list[i]
    dmb()

-- ---------------------------------------------------------------- pictures in flight
--
-- Each picture gets one of two jobs (its coefficients, slice settings, progress
-- counters and a copy of the decoder as it began), so the parser can go on to the
-- next picture while the lanes still rebuild this one. Lanes take pictures in
-- order, each once the one before it is complete, since its samples are references;
-- the parser waits only when both jobs are busy.

to job_of (d ptr h264state.decoder, n u64) gives ptr h264state.picjob
    give addr of d.jobs[n % 2]

-- A new picture (the current one, d.cur): its job, once the picture that last used
-- the job is complete, and the lanes told.
to begin (d ptr h264state.decoder)
    new n = d.gen + 1
    while d.completed + 2 < n
        dmb()
    dmb()
    new j = job_of(d, n)
    if d.mb_count > j.coef_mbs
        j.coef = mem.alloc(d.mb_count * coef_size * 4) as ptr i32
        j.coef_mbs = d.mb_count
    if j.slices as u64 is 0
        j.slices = mem.alloc(size_of(h264state.slicestate) * h264state.max_slices) as ptr h264state.slicestate
    new nrows = d.s.mb_h as u64
    if nrows > j.rows_cap
        j.rows_done = mem.alloc(nrows * 8) as ptr u64
        j.rows_cap = nrows
    for each y in 0 until nrows
        j.rows_done[y] = 0
    j.parsed = 0
    j.deblocked = 0
    j.number = n
    j.pic = d.cur
    d.cur.rebuilt = false
    d.coef = j.coef
    d.slices = j.slices
    d.job = j
    if d.lane_count > 0
        if j.snap as u64 is 0
            j.snap = mem.alloc(size_of(h264state.decoder)) as ptr h264state.decoder
        deref j.snap = deref d
    dmb()
    d.gen = n
    dmb()

-- Macroblocks below `count` are parsed.
to parsed (d ptr h264state.decoder, count u64)
    dmb()
    d.job.parsed = count

-- The picture is parsed: the lanes finish it, or with none it is rebuilt here.
to finish (d ptr h264state.decoder)
    new j = d.job
    dmb()
    j.parsed = d.mb_count
    dmb()
    if d.lane_count is 0
        if d.solo as u64 is 0
            d.solo = mem.alloc(size_of(h264state.decoder)) as ptr h264state.decoder
        deref d.solo = deref d
        rows(d, j, d.solo, 0, 1, 0)

-- Wait until every picture begun is complete (before a seek, or stopping the lanes).
to drain (d ptr h264state.decoder)
    while d.completed < d.gen
        dmb()
    dmb()

-- The last row is deblocked: fill the picture's borders, and it is complete.
to complete (d ptr h264state.decoder, j ptr h264state.picjob, w ptr h264state.decoder)
    new pic = j.pic
    new pw = (w.s.mb_w as u64) * 16
    new ph = (w.s.mb_h as u64) * 16
    pad_plane(pic.y, pic.stride, pw, ph, h264state.pad)
    pad_plane(pic.u, pic.cstride, pw / 2, ph / 2, h264state.cpad)
    pad_plane(pic.v, pic.cstride, pw / 2, ph / 2, h264state.cpad)
    dmb()
    pic.rebuilt = true
    dmb()
    d.completed = j.number
    dmb()

-- Copy the edge samples outwards into the border.
to pad_plane (p ptr u8, stride u64, w u64, h u64, border u64)
    for each y in 0 until h
        new row = p + y * stride
        for each k in 1 until border + 1
            ((row as i64 - k as i64) as ptr u8)[0] = row[0]
            row[w - 1 + k] = row[w - 1]
    for each k in 1 until border + 1
        new top = (p as i64 - (k * stride + border) as i64) as ptr u8
        new first = (p as i64 - border as i64) as ptr u8
        new bottom = p + (h - 1 + k) * stride - border
        new last = p + (h - 1) * stride - border
        for each x in 0 until w + 2 * border
            top[x] = first[x]
            bottom[x] = last[x]

-- ---------------------------------------------------------------- lanes

-- The address of `lane`, for helpers.start.
to lane_function gives u64
    new f u64 = 0
    asm
        "adrp {f}, h264par.lane"
        "add {f}, {f}, :lo12:h264par.lane"
    give f

-- The argument for the lane with number `i` (0 or 1).
to lane_arg (d ptr h264state.decoder, i u64) gives u64
    if d.lane_recs[i] is 0
        new l = mem.alloc(size_of(lanerec)) as ptr lanerec
        l.main = d
        l.own = mem.alloc(size_of(h264state.decoder)) as ptr h264state.decoder
        l.index = i
        d.lane_recs[i] = l as u64
    give d.lane_recs[i]

-- `n` lanes are running (before the first picture).
to use_lanes (d ptr h264state.decoder, n u64)
    d.lane_count = n
    dmb()

-- Stop the lanes (their cores go back to the kernel); the decoder rebuilds pictures
-- itself from then on.
to stop_lanes (d ptr h264state.decoder)
    if d.lane_count is 0
        give
    drain(d)
    d.quit = true
    dmb()
    for each i in 0 until d.lane_count
        new l = d.lane_recs[i] as ptr lanerec
        while not l.gone
            dmb()
    d.lane_count = 0
    dmb()

-- A helper core's work: rebuild this lane's rows of every picture until told to stop.
to lane (arg u64)
    new l = arg as ptr lanerec
    new d = l.main
    new seen = d.gen
    l.job_seen = d.job_gen
    repeat
        new t0 = read_sysreg(cntvct_el0)
        while d.gen is seen and not d.quit
            side(l as u64)
            dmb()
        waited(l as u64, t0)
        if d.quit
            l.gone = true
            dmb()
            give
        seen += 1
        -- the picture before must be complete: its samples are references
        new t1 = read_sysreg(cntvct_el0)
        while d.completed + 1 < seen
            side(l as u64)
            dmb()
        waited(l as u64, t1)
        dmb()
        new j = job_of(d, seen)
        deref l.own = deref j.snap
        rows(d, j, l.own, l.index, d.lane_count, l as u64)

-- Count the counter ticks since `t0` as waiting (lanes only).
to waited (lr u64, t0 u64)
    if lr is not 0
        new l = lr as ptr lanerec
        l.idle += read_sysreg(cntvct_el0) - t0

-- How many counter ticks lane `i` has spent waiting so far.
to idle_of (d ptr h264state.decoder, i u64) gives u64
    if i >= d.lane_count
        give 0
    give (d.lane_recs[i] as ptr lanerec).idle

-- ---------------------------------------------------------------- side jobs

-- Start `function(arg, part, parts)` for parts 0 .. parts-1: one on each lane now,
-- the last one here in `end_job` (which then waits for the lanes). `function` is the
-- address of a `to f (arg u64, part u64, parts u64)` of the app. With no lanes it
-- runs here, whole, at once.
to start_job (d ptr h264state.decoder, function u64, arg u64)
    if d.lane_count is 0
        call(function, arg, 0, 1)
        give
    d.job_fn = function
    d.job_arg = arg
    d.job_mine = true
    dmb()
    d.job_gen += 1
    dmb()

-- Do this core's part of the last job, then wait until the lanes have done theirs.
to end_job (d ptr h264state.decoder)
    if d.job_mine
        d.job_mine = false
        call(d.job_fn, d.job_arg, d.lane_count, d.lane_count + 1)
    for each i in 0 until d.lane_count
        new l = d.lane_recs[i] as ptr lanerec
        while l.job_seen is not d.job_gen
            dmb()
    dmb()

-- A lane's part of a new side job, if there is one (`lr`: its lanerec, 0 if none).
to side (lr u64)
    if lr is 0
        give
    new l = lr as ptr lanerec
    new d = l.main
    new g = d.job_gen
    if l.job_seen is g
        give
    dmb()
    call(d.job_fn, d.job_arg, l.index, d.lane_count + 1)
    dmb()
    l.job_seen = g

to call (function u64, arg u64, part u64, parts u64)
    asm
        "mov x0, {arg}"
        "mov x1, {part}"
        "mov x2, {parts}"
        "blr {function}"

-- ---------------------------------------------------------------- rebuilding

-- Rows first, first + step ... of the picture, each rebuilt and the one above it
-- deblocked (the last one deblocked too).
-- `lr`: the lane's lanerec, or 0.
to rows (d ptr h264state.decoder, j ptr h264state.picjob, w ptr h264state.decoder, first u64, step u64, lr u64)
    new h = w.s.mb_h as u64
    new y = first
    while y < h
        row(j, w, y, lr)
        if y >= 1
            new t0 = read_sysreg(cntvct_el0)
            while j.deblocked + 1 < y
                side(lr)
                dmb()
            waited(lr, t0)
            dmb()
            h264deblock.row(w, y - 1)
            dmb()
            j.deblocked = y
        if y + 1 is h
            dmb()
            h264deblock.row(w, y)
            dmb()
            j.deblocked = h
            complete(d, j, w)
        y += step

-- Rebuild macroblock row `y`, waiting for the parser and the row above.
to row (j ptr h264state.picjob, w ptr h264state.decoder, y u64, lr u64)
    new mw = w.s.mb_w as u64
    for each x in 0 until mw
        new a = y * mw + x
        side(lr)
        new t0 = read_sysreg(cntvct_el0)
        while j.parsed <= a
            side(lr)
            dmb()
        if y > 0
            new need = x + 2
            if need > mw
                need = mw
            while j.rows_done[y - 1] < need
                side(lr)
                dmb()
        waited(lr, t0)
        dmb()
        macroblock(w, a)
        dmb()
        j.rows_done[y] = x + 1

-- Rebuild macroblock `a` (prediction plus residual) in `w`, a lane's decoder.
to macroblock (w ptr h264state.decoder, a u64)
    new m = h264state.mb(w, a)
    if not m.avail or m.kind is h264state.k_pcm or m.kind is h264state.k_none
        give
    if m.slice is not w.slice_no
        apply(w, m.slice)
    new mw = w.s.mb_w as u64
    w.mba = a
    w.mbx = (a % mw) * 16
    w.mby = (a / mw) * 16
    point(w, a)
    if m.intra
        h264recon.intra(w, m)
    else
        w.done[0] = 0
        w.done[1] = 0
        w.spatial_done = false
        h264motion.derive(w, m)
        h264mc.predict_mb(w, m)
        h264recon.inter(w, m)

-- Take on the settings of slice `n`.
to apply (w ptr h264state.decoder, n u32)
    new ss = w.slices + (n as u64) % h264state.max_slices
    w.p = ss.p
    w.s = ss.s
    w.stype = ss.stype
    w.spatial = ss.spatial
    w.nref[0] = ss.nref[0]
    w.nref[1] = ss.nref[1]
    w.lw_denom = ss.lw_denom
    w.cw_denom = ss.cw_denom
    w.deblock_idc = ss.deblock_idc
    w.alpha_off = ss.alpha_off
    w.beta_off = ss.beta_off
    w.w[0] = ss.w[0]
    w.w[1] = ss.w[1]
    for each i in 0 until 64
        w.list[i] = ss.list[i]
    w.slice_no = n
