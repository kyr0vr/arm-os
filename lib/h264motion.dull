-- Motion of P and B macroblocks (8.4.1): partitions, motion vector prediction, P_Skip
-- and B direct prediction (spatial and temporal), then motion compensation.

use h264state
use h264mb
use h264mc

-- B macroblock types 1-21: partition shape (0 16x16, 1 16x8, 2 8x16) and the
-- prediction of each partition (1 L0, 2 L1, 3 both).
fixed b_shape [22] u8 = [0, 0, 0, 0, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2]
fixed b_pred0 [22] u8 = [0, 1, 2, 3, 1, 1, 2, 2, 1, 1, 2, 2, 1, 1, 2, 2, 3, 3, 3, 3, 3, 3]
fixed b_pred1 [22] u8 = [0, 0, 0, 0, 1, 1, 2, 2, 2, 2, 1, 1, 3, 3, 3, 3, 1, 1, 2, 2, 3, 3]
-- B sub-macroblock types 1-12: parts, width, height, prediction
fixed bs_count [13] u8 = [4, 1, 1, 1, 2, 2, 2, 2, 2, 2, 4, 4, 4]
fixed bs_w [13] u8 = [4, 8, 8, 8, 8, 4, 8, 4, 8, 4, 4, 4, 4]
fixed bs_h [13] u8 = [4, 8, 8, 8, 4, 8, 4, 8, 4, 8, 4, 4, 4]
fixed bs_pred [13] u8 = [0, 1, 2, 3, 1, 1, 2, 2, 3, 3, 1, 2, 3]
-- P sub-macroblock types 0-3
fixed ps_count [4] u8 = [1, 2, 2, 4]
fixed ps_w [4] u8 = [8, 8, 4, 4]
fixed ps_h [4] u8 = [8, 4, 8, 4]

to uses (pred u8, lst u64) gives bool
    give ((pred as u64) >> lst) & 1 is 1

-- ---------------------------------------------------------------- storing motion

-- A partition: x | y << 8 | w << 16 | h << 24 (in samples).
to rect (x u64, y u64, w u64, h u64) gives u64
    give x | (y << 8) | (w << 16) | (h << 24)

-- Store motion for the partition `r` of list `lst`: v holds mvx, mvy, mvdx, mvdy, ref.
to set_motion (d ptr h264state.decoder, m ptr h264state.mbinfo, r u64, lst u64, v ptr i32)
    new x = r & 255
    new y = (r >> 8) & 255
    new w = (r >> 16) & 255
    new h = (r >> 24) & 255
    new mvx = v[0]
    new mvy = v[1]
    new dx = v[2]
    new dy = v[3]
    new ref = v[4]
    new pid u32 = 0
    if ref >= 0
        new pic = h264mc.picture_of(d, lst, ref)
        if pic as u64 is not 0
            pid = pic.id
    new cx = cap(dx)
    new cy = cap(dy)
    new done = d.done[lst]
    for each by in y / 4 until (y + h) / 4
        for each bx in x / 4 until (x + w) / 4
            new blk = h264state.blk_at[by * 4 + bx] as u64
            new k = (lst * 16 + blk) * 2
            m.mv[k] = mvx as i16
            m.mv[k + 1] = mvy as i16
            m.mvd[k] = cx
            m.mvd[k + 1] = cy
            m.ref[lst * 4 + blk / 4] = ref as i8
            m.refpic[lst * 4 + blk / 4] = pid
            done = done | ((1 as u32) << blk as u32)
    d.done[lst] = done

-- The motion of 4x4 block `blk` (decoding order) with no mvd, as set_motion would
-- store it; `pid` is the id of reference `ref`'s picture.
to put (d ptr h264state.decoder, m ptr h264state.mbinfo, blk u64, lst u64, mvx i32, mvy i32, ref i32, pid u32)
    new k = (lst * 16 + blk) * 2
    m.mv[k] = mvx as i16
    m.mv[k + 1] = mvy as i16
    m.mvd[k] = 0
    m.mvd[k + 1] = 0
    m.ref[lst * 4 + blk / 4] = ref as i8
    m.refpic[lst * 4 + blk / 4] = pid
    d.done[lst] = d.done[lst] | ((1 as u32) << blk as u32)

to set_none (d ptr h264state.decoder, m ptr h264state.mbinfo, r u64, lst u64)
    new v [5] i32
    v[4] = -1
    set_motion(d, m, r, lst, addr of v[0])

to cap (v i32) gives u8
    new a = h264state.abs(v)
    if a > 255
        give 255
    give a as u8

-- ---------------------------------------------------------------- prediction

-- (available, ref, mv) of the neighbour at (x, y), for list `lst`.
to mv_of (d ptr h264state.decoder, m ptr h264state.mbinfo, lst u64, x i32, y i32, ref ptr i32, mv ptr i32) gives bool
    new blk u64 = 0
    new n = h264state.neighbor(d, x, y, addr of blk)
    deref ref = -1
    mv[0] = 0
    mv[1] = 0
    if n as u64 is 0
        give false
    if n as u64 is m as u64 and (d.done[lst] >> blk as u32) & 1 is 0
        give false
    if n.intra
        give true
    new r = n.ref[lst * 4 + blk / 4] as i32
    if r < 0
        give true
    deref ref = r
    mv[0] = n.mv[(lst * 16 + blk) * 2] as i32
    mv[1] = n.mv[(lst * 16 + blk) * 2 + 1] as i32
    give true

to median (a i32, b i32, c i32) gives i32
    new lo = a
    new hi = b
    if b < a
        lo = b
        hi = a
    if c < lo
        give lo
    if c > hi
        give hi
    give c

-- The predicted motion vector of a w-wide partition at (x, y) with reference `ref`;
-- shape 1 (16x8) and 2 (8x16) have their own rules for partition `part`.
-- r: the partition (see `rect`); rule: shape (1 16x8, 2 8x16) | partition << 8.
to mv_pred (d ptr h264state.decoder, m ptr h264state.mbinfo, lst u64, ref i32, r u64, rule u32, out ptr i32)
    new x = (r & 255) as i32
    new y = ((r >> 8) & 255) as i32
    new w = ((r >> 16) & 255) as i32
    new form = rule & 255
    new part = rule >> 8
    new ra i32 = 0
    new rb i32 = 0
    new rc i32 = 0
    new ma [2] i32
    new mb [2] i32
    new mc [2] i32
    new aa = mv_of(d, m, lst, x - 1, y, addr of ra, addr of ma[0])
    new ab = mv_of(d, m, lst, x, y - 1, addr of rb, addr of mb[0])
    new ac = mv_of(d, m, lst, x + w, y - 1, addr of rc, addr of mc[0])
    if not ac
        ac = mv_of(d, m, lst, x - 1, y - 1, addr of rc, addr of mc[0])
    if form is 1
        if part is 0 and rb is ref
            out[0] = mb[0]
            out[1] = mb[1]
            give
        if part is 1 and ra is ref
            out[0] = ma[0]
            out[1] = ma[1]
            give
    else if form is 2
        if part is 0 and ra is ref
            out[0] = ma[0]
            out[1] = ma[1]
            give
        if part is 1 and rc is ref
            out[0] = mc[0]
            out[1] = mc[1]
            give
    if not ab and not ac and aa
        out[0] = ma[0]
        out[1] = ma[1]
        give
    new same u32 = 0
    if ra is ref
        same += 1
    if rb is ref
        same += 1
    if rc is ref
        same += 1
    if same is 1
        if ra is ref
            out[0] = ma[0]
            out[1] = ma[1]
        else if rb is ref
            out[0] = mb[0]
            out[1] = mb[1]
        else
            out[0] = mc[0]
            out[1] = mc[1]
        give
    out[0] = median(ma[0], mb[0], mc[0])
    out[1] = median(ma[1], mb[1], mc[1])

-- ---------------------------------------------------------------- P_Skip

to p_skip (d ptr h264state.decoder, m ptr h264state.mbinfo)
    m.kind = h264state.k_skip
    new ra i32 = 0
    new rb i32 = 0
    new ma [2] i32
    new mb [2] i32
    mv_of(d, m, 0, -1, 0, addr of ra, addr of ma[0])
    mv_of(d, m, 0, 0, -1, addr of rb, addr of mb[0])
    new mv [4] i32
    new a = h264state.left_of(d, d.mba)
    new b = h264state.top_of(d, d.mba)
    if a as u64 is 0 or b as u64 is 0 or (ra is 0 and ma[0] is 0 and ma[1] is 0) or (rb is 0 and mb[0] is 0 and mb[1] is 0)
        mv[0] = 0
        mv[1] = 0
    else
        mv_pred(d, m, 0, 0, rect(0, 0, 16, 16), 0, addr of mv[0])
    new v [5] i32
    v[0] = mv[0]
    v[1] = mv[1]
    set_motion(d, m, rect(0, 0, 16, 16), 0, addr of v[0])

-- ---------------------------------------------------------------- B direct

-- The co-located block (in RefPicList1[0]): its reference index (-1 if intra), mv,
-- and the id of the picture it refers to.
to colocated (d ptr h264state.decoder, blk u64, mv ptr i32, pid ptr u32) gives i32
    new col = h264mc.picture_of(d, 1, 0)
    new cm = col.mbs + d.mba
    mv[0] = 0
    mv[1] = 0
    deref pid = 0
    if cm.intra
        give -1
    for each lst in 0 until 2
        new r = cm.ref[lst * 4 + blk / 4] as i32
        if r >= 0
            mv[0] = cm.mv[(lst * 16 + blk) * 2] as i32
            mv[1] = cm.mv[(lst * 16 + blk) * 2 + 1] as i32
            deref pid = cm.refpic[lst * 4 + blk / 4]
            give r
    give -1

to min_positive (a i32, b i32) gives i32
    if a >= 0 and b >= 0
        if a < b
            give a
        give b
    if a > b
        give a
    give b

to spatial_setup (d ptr h264state.decoder, m ptr h264state.mbinfo)
    if d.spatial_done
        give
    d.spatial_done = true
    -- neighbours of the whole macroblock, nothing inside it counts
    new saved0 = d.done[0]
    new saved1 = d.done[1]
    d.done[0] = 0
    d.done[1] = 0
    for each lst in 0 until 2
        new r [3] i32
        new mv [6] i32
        mv_of(d, m, lst, -1, 0, addr of r[0], addr of mv[0])
        mv_of(d, m, lst, 0, -1, addr of r[1], addr of mv[2])
        if not mv_of(d, m, lst, 16, -1, addr of r[2], addr of mv[4])
            mv_of(d, m, lst, -1, -1, addr of r[2], addr of mv[4])
        d.spatial_ref[lst] = min_positive(r[0], min_positive(r[1], r[2]))
    if d.spatial_ref[0] < 0 and d.spatial_ref[1] < 0
        d.spatial_ref[0] = 0
        d.spatial_ref[1] = 0
        for each k in 0 until 4
            d.spatial_mv[k] = 0
    else
        for each lst in 0 until 2
            if d.spatial_ref[lst] < 0
                d.spatial_mv[lst * 2] = 0
                d.spatial_mv[lst * 2 + 1] = 0
            else
                mv_pred(d, m, lst, d.spatial_ref[lst], rect(0, 0, 16, 16), 0, addr of d.spatial_mv[lst * 2])
    d.done[0] = saved0
    d.done[1] = saved1

fixed corner [4] u64 = [0, 5, 10, 15]

-- Fill in the motion of 8x8 block b8 by direct prediction (no samples yet).
to direct_motion (d ptr h264state.decoder, m ptr h264state.mbinfo, b8 u64)
    m.direct = m.direct | ((15 as u32) << (b8 * 4) as u32)
    if d.spatial
        spatial_setup(d, m)
        new col = h264mc.picture_of(d, 1, 0)
        new pids [2] u32
        for each lst in 0 until 2
            if d.spatial_ref[lst] >= 0
                new pic = h264mc.picture_of(d, lst, d.spatial_ref[lst])
                if pic as u64 is not 0
                    pids[lst] = pic.id
        for each k in 0 until 4
            new blk = b8 * 4 + k
            new cblk = blk
            if d.s.direct8
                cblk = corner[b8]
            new cmv [2] i32
            new pid u32 = 0
            new rc = colocated(d, cblk, addr of cmv[0], addr of pid)
            new zero = col.ref is 1 and rc is 0 and h264state.abs(cmv[0]) <= 1 and h264state.abs(cmv[1]) <= 1
            for each lst in 0 until 2
                new ref = d.spatial_ref[lst]
                new mvx i32 = 0
                new mvy i32 = 0
                if ref > 0 or (ref is 0 and not zero)
                    mvx = d.spatial_mv[lst * 2]
                    mvy = d.spatial_mv[lst * 2 + 1]
                put(d, m, blk, lst, mvx, mvy, ref, pids[lst])
        give
    -- temporal
    new ref1 = h264mc.picture_of(d, 1, 0)
    for each k in 0 until 4
        new blk = b8 * 4 + k
        new cblk = blk
        if d.s.direct8
            cblk = corner[b8]
        new cmv [2] i32
        new pid u32 = 0
        new rc = colocated(d, cblk, addr of cmv[0], addr of pid)
        new r0 i32 = 0
        if rc >= 0
            for each i in 0 until d.nref[0] as u64
                new p = h264mc.picture_of(d, 0, i as i32)
                if p as u64 is not 0 and p.id is pid
                    r0 = i as i32
                    stop
        new pic0 = h264mc.picture_of(d, 0, r0)
        new tb = h264state.clip(d.poc - pic0.poc, -128, 127)
        new td = h264state.clip(ref1.poc - pic0.poc, -128, 127)
        new m0x = cmv[0]
        new m0y = cmv[1]
        new m1x i32 = 0
        new m1y i32 = 0
        if td is not 0 and pic0.ref is not 2
            new tx = h264mc.cdiv(16384 + h264state.abs(h264mc.cdiv(td, 2)), td)
            new dsf = h264state.clip((tb * tx + 32) >> 6, -1024, 1023)
            m0x = (dsf * cmv[0] + 128) >> 8
            m0y = (dsf * cmv[1] + 128) >> 8
            m1x = m0x - cmv[0]
            m1y = m0y - cmv[1]
        new x = (h264state.blk_x[blk] * 4) as u64
        new y = (h264state.blk_y[blk] * 4) as u64
        new v [5] i32
        v[0] = m0x
        v[1] = m0y
        v[4] = r0
        set_motion(d, m, rect(x, y, 4, 4), 0, addr of v[0])
        v[0] = m1x
        v[1] = m1y
        v[4] = 0
        set_motion(d, m, rect(x, y, 4, 4), 1, addr of v[0])

-- ---------------------------------------------------------------- partitions
--
-- The parser (`inter`) reads only the syntax: partition and sub-partition types,
-- reference indexes and mvds, which it keeps in the macroblock's record (contexts of
-- later syntax depend on nothing else). The motion itself (`derive`) is worked out
-- when the macroblock is rebuilt, in the same order as the standard gives.

to part_xy (r u64) gives u64
    give h264state.blk_at[((r >> 8) & 255) / 4 * 4 + (r & 255) / 4] as u64

-- Read one (sub-)partition's mvd for list `lst` and keep it with its blocks.
to parse_mvd (d ptr h264state.decoder, m ptr h264state.mbinfo, lst u64, r u64)
    new x = r & 255
    new y = (r >> 8) & 255
    new w = (r >> 16) & 255
    new h = (r >> 24) & 255
    new dx = h264mb.mvd(d, lst, 0, x as i32, y as i32)
    new dy = h264mb.mvd(d, lst, 1, x as i32, y as i32)
    new cx = cap(dx)
    new cy = cap(dy)
    for each by in y / 4 until (y + h) / 4
        for each bx in x / 4 until (x + w) / 4
            new k = (lst * 16 + h264state.blk_at[by * 4 + bx] as u64) * 2
            m.mvd[k] = cx
            m.mvd[k + 1] = cy
            m.mvs[k] = dx as i16
            m.mvs[k + 1] = dy as i16

-- One (sub-)partition's motion vector from its kept mvd.
to derive_mv (d ptr h264state.decoder, m ptr h264state.mbinfo, lst u64, ref i32, r u64, rule u32)
    new k = (lst * 16 + part_xy(r)) * 2
    new dx = m.mvs[k] as i32
    new dy = m.mvs[k + 1] as i32
    new p [2] i32
    mv_pred(d, m, lst, ref, r, rule, addr of p[0])
    new v [5] i32
    v[0] = p[0] + dx
    v[1] = p[1] + dy
    v[2] = dx
    v[3] = dy
    v[4] = ref
    set_motion(d, m, r, lst, addr of v[0])

-- Where sub-partition s of 8x8 block b8 is, for sub-macroblock type `sub`.
to sub_rect (is_b bool, sub u64, b8 u64, s u64) gives u64
    new bx = (b8 % 2) * 8
    new by = (b8 / 2) * 8
    new count = ps_count[sub] as u64
    new w = ps_w[sub] as u64
    new h = ps_h[sub] as u64
    if is_b
        count = bs_count[sub] as u64
        w = bs_w[sub] as u64
        h = bs_h[sub] as u64
    new sx = bx
    new sy = by
    if count is 4
        sx = bx + (s % 2) * 4
        sy = by + (s / 2) * 4
    else if w is 8
        sy = by + s * h
    else
        sx = bx + s * w
    give rect(sx, sy, w, h)

to sub_count (is_b bool, sub u64) gives u64
    if is_b
        give bs_count[sub] as u64
    give ps_count[sub] as u64

-- Partition p of a 16x16, 16x8 or 8x16 macroblock (form 0, 1, 2).
to big_rect (form u32, p u64) gives u64
    if form is 0
        give rect(0, 0, 16, 16)
    if form is 1
        give rect(0, p * 8, 16, 8)
    give rect(p * 8, 0, 8, 16)

to form_of (is_b bool, mtype i32) gives u32
    if is_b
        give b_shape[mtype as u64] as u32
    give mtype as u32

to pred_of (is_b bool, mtype i32, p u64) gives u8
    if not is_b
        give 1
    if p is 0
        give b_pred0[mtype as u64]
    give b_pred1[mtype as u64]

-- A P or B macroblock that is not skipped and not intra: its syntax. Gives true if
-- the 8x8 transform may be used (no partitions smaller than 8x8).
to inter (d ptr h264state.decoder, m ptr h264state.mbinfo, mtype i32) gives bool
    new is_b = d.stype is 1
    m.kind = h264state.k_p
    m.btype = -1
    m.mtype = mtype
    if is_b
        m.kind = h264state.k_b
        m.btype = mtype
    for each k in 0 until 8
        m.ref[k] = -1
    if is_b and mtype is 0                              -- B_Direct_16x16
        m.direct = 0xFFFF
        give d.s.direct8
    new lists u64 = 1
    if is_b
        lists = 2
    if (not is_b and mtype is 3) or (is_b and mtype is 22)
        for each b8 in 0 until 4
            if is_b
                m.subs[b8] = h264mb.b_sub(d) as u8
            else
                m.subs[b8] = h264mb.p_sub(d) as u8
            if is_b and m.subs[b8] is 0
                m.direct = m.direct | ((15 as u32) << (b8 * 4) as u32)
        for each lst in 0 until lists
            for each b8 in 0 until 4
                new sub = m.subs[b8] as u64
                new pred u8 = 1
                if is_b
                    pred = bs_pred[sub]
                if (not is_b or sub is not 0) and uses(pred, lst)
                    m.ref[lst * 4 + b8] = h264mb.ref_idx(d, m, lst, ((b8 % 2) * 8) as i32, ((b8 / 2) * 8) as i32) as i8
        for each lst in 0 until lists
            for each b8 in 0 until 4
                new sub = m.subs[b8] as u64
                if is_b and sub is 0
                    skip
                new pred u8 = 1
                if is_b
                    pred = bs_pred[sub]
                if uses(pred, lst)
                    for each s in 0 until sub_count(is_b, sub)
                        parse_mvd(d, m, lst, sub_rect(is_b, sub, b8, s))
        new ok = true
        for each b8 in 0 until 4
            new sub = m.subs[b8] as u64
            if is_b
                if sub is 0
                    if not d.s.direct8
                        ok = false
                else if bs_w[sub] < 8 or bs_h[sub] < 8
                    ok = false
            else if sub is not 0
                ok = false
        give ok
    -- 16x16, 16x8, 8x16
    new form = form_of(is_b, mtype)
    new count u64 = 2
    if form is 0
        count = 1
    for each lst in 0 until lists
        for each p in 0 until count
            if uses(pred_of(is_b, mtype, p), lst)
                new r = big_rect(form, p)
                new x = r & 255
                new y = (r >> 8) & 255
                new ref = h264mb.ref_idx(d, m, lst, x as i32, y as i32)
                for each by in y / 4 until (y + ((r >> 24) & 255)) / 4
                    for each bx in x / 4 until (x + ((r >> 16) & 255)) / 4
                        m.ref[lst * 4 + h264state.blk_at[by * 4 + bx] as u64 / 4] = ref as i8
    for each lst in 0 until lists
        for each p in 0 until count
            if uses(pred_of(is_b, mtype, p), lst)
                parse_mvd(d, m, lst, big_rect(form, p))
    give true

-- The motion of a P or B macroblock (also skipped ones) from its syntax, before its
-- samples are predicted. d.done starts empty.
to derive (d ptr h264state.decoder, m ptr h264state.mbinfo)
    new is_b = d.stype is 1
    if m.kind is h264state.k_skip
        if is_b
            for each b8 in 0 until 4
                direct_motion(d, m, b8)
        else
            p_skip(d, m)
        give
    new mtype = m.mtype
    if is_b and mtype is 0
        for each b8 in 0 until 4
            direct_motion(d, m, b8)
        give
    new lists u64 = 1
    if is_b
        lists = 2
    if (not is_b and mtype is 3) or (is_b and mtype is 22)
        -- direct sub-blocks get their motion first (it does not depend on order)
        for each b8 in 0 until 4
            if is_b and m.subs[b8] is 0
                new saved0 = d.done[0]
                new saved1 = d.done[1]
                direct_motion(d, m, b8)
                d.done[0] = saved0
                d.done[1] = saved1
        for each lst in 0 until lists
            for each b8 in 0 until 4
                new sub = m.subs[b8] as u64
                if is_b and sub is 0
                    d.done[lst] = d.done[lst] | ((15 as u32) << (b8 * 4) as u32)
                    skip
                new pred u8 = 1
                if is_b
                    pred = bs_pred[sub]
                for each s in 0 until sub_count(is_b, sub)
                    new r = sub_rect(is_b, sub, b8, s)
                    if uses(pred, lst)
                        derive_mv(d, m, lst, m.ref[lst * 4 + b8] as i32, r, 0)
                    else
                        set_none(d, m, r, lst)
        give
    new form = form_of(is_b, mtype)
    new count u64 = 2
    if form is 0
        count = 1
    for each lst in 0 until lists
        for each p in 0 until count
            new r = big_rect(form, p)
            if uses(pred_of(is_b, mtype, p), lst)
                derive_mv(d, m, lst, m.ref[lst * 4 + part_xy(r) / 4] as i32, r, form | ((p as u32) << 8))
            else
                set_none(d, m, r, lst)
