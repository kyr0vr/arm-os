-- Turning a parsed macroblock into samples (8.3, 8.5): intra prediction, scaling,
-- the inverse transforms, adding the residual to the prediction.

use h264state
use h264tables

-- ---------------------------------------------------------------- samples

to luma_ptr (d ptr h264state.decoder, x i64, y i64) gives ptr u8
    give (d.cur.y as i64 + y * d.cur.stride as i64 + x) as ptr u8

to chroma_ptr (d ptr h264state.decoder, c u64, x i64, y i64) gives ptr u8
    new p = d.cur.u
    if c is 1
        p = d.cur.v
    give (p as i64 + y * d.cur.cstride as i64 + x) as ptr u8

-- ---------------------------------------------------------------- scaling and transforms

to scale4 (d ptr h264state.decoder, list u64, qp i32, r u64) gives i32
    new m = (qp % 6) as u64
    give (d.p.scale4[list * 16 + r] as i32) * (h264tables.norm4[m * 16 + r] as i32)

-- Dequantize 16 coefficients (raster) with scaling list `list`; the DC is kept as it
-- is when `keep_dc` (it was scaled separately).
to dequant4 (d ptr h264state.decoder, c ptr i32, list u64, qp i32, keep_dc bool)
    new q6 = qp / 6
    for each r in 0 until 16
        if r is 0 and keep_dc
            skip
        if c[r] is 0
            skip
        new ls = scale4(d, list, qp, r)
        if qp >= 24
            c[r] = (c[r] * ls) << (q6 - 4) as u32
        else
            c[r] = (c[r] * ls + ((1 as i32) << (3 - q6) as u32)) >> (4 - q6) as u32

to dequant8 (d ptr h264state.decoder, c ptr i32, list u64, qp i32)
    new q6 = qp / 6
    new m = (qp % 6) as u64
    for each r in 0 until 64
        if c[r] is 0
            skip
        new ls = (d.p.scale8[list * 64 + r] as i32) * (h264tables.norm8[m * 64 + r] as i32)
        if qp >= 36
            c[r] = (c[r] * ls) << (q6 - 6) as u32
        else
            c[r] = (c[r] * ls + ((1 as i32) << (5 - q6) as u32)) >> (6 - q6) as u32

-- The 4x4 inverse transform, in place, with the final (x + 32) >> 6.
to idct4 (c ptr i32)
    new t [16] i32
    for each i in 0 until 4
        new a = c[i * 4]
        new b = c[i * 4 + 1]
        new cc = c[i * 4 + 2]
        new e = c[i * 4 + 3]
        new e0 = a + cc
        new e1 = a - cc
        new e2 = (b >> 1) - e
        new e3 = b + (e >> 1)
        t[i * 4] = e0 + e3
        t[i * 4 + 1] = e1 + e2
        t[i * 4 + 2] = e1 - e2
        t[i * 4 + 3] = e0 - e3
    for each j in 0 until 4
        new a = t[j]
        new b = t[4 + j]
        new cc = t[8 + j]
        new e = t[12 + j]
        new g0 = a + cc
        new g1 = a - cc
        new g2 = (b >> 1) - e
        new g3 = b + (e >> 1)
        c[j] = (g0 + g3 + 32) >> 6
        c[4 + j] = (g1 + g2 + 32) >> 6
        c[8 + j] = (g1 - g2 + 32) >> 6
        c[12 + j] = (g0 - g3 + 32) >> 6

-- One 8-point pass of the 8x8 transform over s[0], s[step], ... s[7 * step].
to pass8 (s ptr i32, step u64)
    new v [8] i32
    for each k in 0 until 8
        v[k] = s[k * step]
    new a0 = v[0] + v[4]
    new a4 = v[0] - v[4]
    new a2 = (v[2] >> 1) - v[6]
    new a6 = v[2] + (v[6] >> 1)
    new b0 = a0 + a6
    new b2 = a4 + a2
    new b4 = a4 - a2
    new b6 = a0 - a6
    new a1 = 0 - v[3] + v[5] - v[7] - (v[7] >> 1)
    new a3 = v[1] + v[7] - v[3] - (v[3] >> 1)
    new a5 = 0 - v[1] + v[7] + v[5] + (v[5] >> 1)
    new a7 = v[3] + v[5] + v[1] + (v[1] >> 1)
    new b1 = a1 + (a7 >> 2)
    new b7 = a7 - (a1 >> 2)
    new b3 = a3 + (a5 >> 2)
    new b5 = (a3 >> 2) - a5
    s[0] = b0 + b7
    s[step] = b2 + b5
    s[2 * step] = b4 + b3
    s[3 * step] = b6 + b1
    s[4 * step] = b6 - b1
    s[5 * step] = b4 - b3
    s[6 * step] = b2 - b5
    s[7 * step] = b0 - b7

to idct8 (c ptr i32)
    for each i in 0 until 8
        pass8(c + i * 8, 1)
    for each j in 0 until 8
        pass8(c + j, 8)
    for each r in 0 until 64
        c[r] = (c[r] + 32) >> 6

-- Add a w x w residual (row stride w) to the prediction (row stride `ps`) into the
-- picture at `dst`.
to add_block (dst ptr u8, stride u64, pred ptr i32, ps u64, res ptr i32, w u64)
    if w is 8
        add8(dst as u64, stride, pred as u64, ps * 4, res as u64)
        give
    if w is 4
        add4(dst as u64, stride, pred as u64, ps * 4, res as u64)
        give
    for each y in 0 until w
        new o = dst + y * stride
        new p = pred + y * ps
        if res as u64 is 0
            for each x in 0 until w
                new v = p[x]
                if v < 0
                    v = 0
                else if v > 255
                    v = 255
                o[x] = v as u8
        else
            new r = res + y * w
            for each x in 0 until w
                new v = p[x] + r[x]
                if v < 0
                    v = 0
                else if v > 255
                    v = 255
                o[x] = v as u8

-- NEON add_block for 8 x 8 and 4 x 4: pred rows `pb` bytes apart, res (if not 0)
-- rows packed, the sums clamped to 0..255 by saturating narrowing.
to add8 (dst u64, stride u64, pred u64, pb u64, res u64)
    asm
        "mov x17, #8"
        "1:"
        "ld1 {v0.4s, v1.4s}, [{pred}], {pb}"
        "cbz {res}, 2f"
        "ld1 {v2.4s, v3.4s}, [{res}], #32"
        "add v0.4s, v0.4s, v2.4s"
        "add v1.4s, v1.4s, v3.4s"
        "2:"
        "sqxtn v0.4h, v0.4s"
        "sqxtn2 v0.8h, v1.4s"
        "sqxtun v0.8b, v0.8h"
        "st1 {v0.8b}, [{dst}], {stride}"
        "subs x17, x17, #1"
        "b.ne 1b"

to add4 (dst u64, stride u64, pred u64, pb u64, res u64)
    asm
        "mov x17, #4"
        "1:"
        "ld1 {v0.4s}, [{pred}], {pb}"
        "cbz {res}, 2f"
        "ld1 {v2.4s}, [{res}], #16"
        "add v0.4s, v0.4s, v2.4s"
        "2:"
        "sqxtn v0.4h, v0.4s"
        "sqxtun v0.8b, v0.8h"
        "umov w16, v0.s[0]"
        "str w16, [{dst}]"
        "add {dst}, {dst}, {stride}"
        "subs x17, x17, #1"
        "b.ne 1b"

-- ---------------------------------------------------------------- intra prediction

-- Is luma sample (x, y) relative to the macroblock available for intra prediction of
-- the block in decoding position `order` (4x4 blocks: 0-15, 8x8: 0-3 x 4)?
to luma_avail (d ptr h264state.decoder, m ptr h264state.mbinfo, x i32, y i32, order u64, unit u64) gives bool
    new blk u64 = 0
    new n = h264state.neighbor(d, x, y, addr of blk)
    if n as u64 is 0
        give false
    if n as u64 is m as u64
        give blk / unit < order
    if d.p.constrained and not n.intra
        give false
    give true

-- Neighbouring samples for a 4x4 / 8x8 block: top[0..2n-1] (with top-right),
-- left[0..n-1], corner; flags say which exist.
-- g: bx | by << 8 | n << 16 | order << 24 (unit is always 1: order counts 4x4 blocks)
to fetch (d ptr h264state.decoder, m ptr h264state.mbinfo, g u64, top ptr i32, left ptr i32, corner ptr i32) gives u32
    new bx = g & 255
    new by = (g >> 8) & 255
    new n = (g >> 16) & 255
    new order = (g >> 24) & 255
    new unit u64 = 1
    new x = bx as i32
    new y = by as i32
    new flags u32 = 0
    new px = d.mbx as i64 + bx as i64
    new py = d.mby as i64 + by as i64
    if luma_avail(d, m, x, y - 1, order, unit)
        flags = flags | 1
        new p = luma_ptr(d, px, py - 1)
        for each i in 0 until n
            top[i] = p[i] as i32
        if luma_avail(d, m, x + n as i32, y - 1, order, unit)
            for each i in n until 2 * n
                top[i] = p[i] as i32
        else
            for each i in n until 2 * n
                top[i] = top[n - 1]
    if luma_avail(d, m, x - 1, y, order, unit)
        flags = flags | 2
        for each i in 0 until n
            left[i] = luma_ptr(d, px - 1, py + i as i64)[0] as i32
    if luma_avail(d, m, x - 1, y - 1, order, unit)
        flags = flags | 4
        deref corner = luma_ptr(d, px - 1, py - 1)[0] as i32
    give flags

-- One sample of an angular mode, from the edge samples: e(-1) is the corner,
-- e(i >= 0) top[i], e(-2 - i) left[i].
to edge (top ptr i32, left ptr i32, corner i32, i i32) gives i32
    if i >= 0
        give top[i as u64]
    if i is -1
        give corner
    give left[(-2 - i) as u64]

-- Intra NxN prediction (n = 4 or 8) of `mode` into out (row stride 16).
to angular (mode u8, n i32, top ptr i32, left ptr i32, corner i32, flags u32, out ptr i32)
    new last = n - 1
    for each yy in 0 until n as u64
        for each xx in 0 until n as u64
            new x = xx as i32
            new y = yy as i32
            new v i32 = 0
            if mode is 0
                v = top[xx]
            else if mode is 1
                v = left[yy]
            else if mode is 3
                if x is last and y is last
                    v = (top[(2 * n - 2) as u64] + 3 * top[(2 * n - 1) as u64] + 2) >> 2
                else
                    v = (top[(x + y) as u64] + 2 * top[(x + y + 1) as u64] + top[(x + y + 2) as u64] + 2) >> 2
            else if mode is 4
                if x > y
                    v = (edge(top, left, corner, x - y - 2) + 2 * edge(top, left, corner, x - y - 1) + edge(top, left, corner, x - y) + 2) >> 2
                else if x < y
                    v = (edge(top, left, corner, -2 - (y - x - 2)) + 2 * edge(top, left, corner, -2 - (y - x - 1)) + edge(top, left, corner, -2 - (y - x)) + 2) >> 2
                else
                    v = (top[0] + 2 * corner + left[0] + 2) >> 2
            else if mode is 5
                new z = 2 * x - y
                if z >= 0 and z % 2 is 0
                    v = (edge(top, left, corner, x - (y >> 1) - 1) + edge(top, left, corner, x - (y >> 1)) + 1) >> 1
                else if z >= 0
                    v = (edge(top, left, corner, x - (y >> 1) - 2) + 2 * edge(top, left, corner, x - (y >> 1) - 1) + edge(top, left, corner, x - (y >> 1)) + 2) >> 2
                else if z is -1
                    v = (left[0] + 2 * corner + top[0] + 2) >> 2
                else if n is 4
                    v = (edge(top, left, corner, -2 - (y - 1)) + 2 * edge(top, left, corner, -2 - (y - 2)) + edge(top, left, corner, -2 - (y - 3)) + 2) >> 2
                else
                    v = (edge(top, left, corner, -2 - (y - 2 * x - 1)) + 2 * edge(top, left, corner, -2 - (y - 2 * x - 2)) + edge(top, left, corner, -2 - (y - 2 * x - 3)) + 2) >> 2
            else if mode is 6
                new z = 2 * y - x
                if z >= 0 and z % 2 is 0
                    v = (edge(top, left, corner, -2 - (y - (x >> 1) - 1)) + edge(top, left, corner, -2 - (y - (x >> 1))) + 1) >> 1
                else if z >= 0
                    v = (edge(top, left, corner, -2 - (y - (x >> 1) - 2)) + 2 * edge(top, left, corner, -2 - (y - (x >> 1) - 1)) + edge(top, left, corner, -2 - (y - (x >> 1))) + 2) >> 2
                else if z is -1
                    v = (left[0] + 2 * corner + top[0] + 2) >> 2
                else if n is 4
                    v = (edge(top, left, corner, x - 1) + 2 * edge(top, left, corner, x - 2) + edge(top, left, corner, x - 3) + 2) >> 2
                else
                    v = (edge(top, left, corner, x - 2 * y - 1) + 2 * edge(top, left, corner, x - 2 * y - 2) + edge(top, left, corner, x - 2 * y - 3) + 2) >> 2
            else if mode is 7
                new i = x + (y >> 1)
                if y % 2 is 0
                    v = (top[i as u64] + top[(i + 1) as u64] + 1) >> 1
                else
                    v = (top[i as u64] + 2 * top[(i + 1) as u64] + top[(i + 2) as u64] + 2) >> 2
            else if mode is 8
                new z = x + 2 * y
                new lim = 2 * n - 3
                new i = y + (x >> 1)
                if z < lim and z % 2 is 0
                    v = (left[i as u64] + left[(i + 1) as u64] + 1) >> 1
                else if z < lim
                    v = (left[i as u64] + 2 * left[(i + 1) as u64] + left[(i + 2) as u64] + 2) >> 2
                else if z is lim
                    v = (left[(n - 2) as u64] + 3 * left[(n - 1) as u64] + 2) >> 2
                else
                    v = left[(n - 1) as u64]
            out[yy * 16 + xx] = v
    if mode is 2
        new sum i32 = 0
        new v i32 = 128
        new shift u32 = 3
        if n is 8
            shift = 4
        if flags & 3 is 3
            for each i in 0 until n as u64
                sum += top[i] + left[i]
            v = (sum + (n as i32)) >> shift as u32
        else if flags & 2 is 2
            for each i in 0 until n as u64
                sum += left[i]
            v = (sum + (n as i32) / 2) >> (shift - 1) as u32
        else if flags & 1 is 1
            for each i in 0 until n as u64
                sum += top[i]
            v = (sum + (n as i32) / 2) >> (shift - 1) as u32
        for each yy in 0 until n as u64
            for each xx in 0 until n as u64
                out[yy * 16 + xx] = v

-- The reference sample filter of 8x8 intra prediction (8.3.2.2.1).
to filter8 (top ptr i32, left ptr i32, corner ptr i32, flags u32)
    new t [16] i32
    new l [8] i32
    new c = deref corner
    new have_top = flags & 1 is 1
    new have_left = flags & 2 is 2
    new have_corner = flags & 4 is 4
    if have_top
        if have_corner
            t[0] = (c + 2 * top[0] + top[1] + 2) >> 2
        else
            t[0] = (3 * top[0] + top[1] + 2) >> 2
        for each x in 1 until 15
            t[x] = (top[x - 1] + 2 * top[x] + top[x + 1] + 2) >> 2
        t[15] = (top[14] + 3 * top[15] + 2) >> 2
    if have_corner
        if have_top and have_left
            deref corner = (top[0] + 2 * c + left[0] + 2) >> 2
        else if have_top
            deref corner = (3 * c + top[0] + 2) >> 2
        else if have_left
            deref corner = (3 * c + left[0] + 2) >> 2
    if have_left
        if have_corner
            l[0] = (c + 2 * left[0] + left[1] + 2) >> 2
        else
            l[0] = (3 * left[0] + left[1] + 2) >> 2
        for each y in 1 until 7
            l[y] = (left[y - 1] + 2 * left[y] + left[y + 1] + 2) >> 2
        l[7] = (left[6] + 3 * left[7] + 2) >> 2
    if have_top
        for each x in 0 until 16
            top[x] = t[x]
    if have_left
        for each y in 0 until 8
            left[y] = l[y]

to pred16 (d ptr h264state.decoder, m ptr h264state.mbinfo, out ptr i32)
    new a = h264state.left_of(d, d.mba)
    new b = h264state.top_of(d, d.mba)
    new c = h264state.topleft_of(d, d.mba)
    new have_top = b as u64 is not 0 and not (d.p.constrained and not b.intra)
    new have_left = a as u64 is not 0 and not (d.p.constrained and not a.intra)
    new top [16] i32
    new left [16] i32
    new px = d.mbx as i64
    new py = d.mby as i64
    if have_top
        new p = luma_ptr(d, px, py - 1)
        for each i in 0 until 16
            top[i] = p[i] as i32
    if have_left
        for each i in 0 until 16
            left[i] = luma_ptr(d, px - 1, py + i as i64)[0] as i32
    new mode = m.i16mode
    if mode is 3
        new pp = luma_ptr(d, px - 1, py - 1)[0] as i32
        new hs i32 = 0
        new vs i32 = 0
        for each x in 0 until 8
            new t2 = pp
            if x < 7
                t2 = top[6 - x]
            hs += (x as i32 + 1) * (top[8 + x] - t2)
            new l2 = pp
            if x < 7
                l2 = left[6 - x]
            vs += (x as i32 + 1) * (left[8 + x] - l2)
        new aa = 16 * (left[15] + top[15])
        new bb = (5 * hs + 32) >> 6
        new cc = (5 * vs + 32) >> 6
        for each y in 0 until 16
            for each x in 0 until 16
                out[y * 16 + x] = h264state.clip1((aa + bb * (x as i32 - 7) + cc * (y as i32 - 7) + 16) >> 5)
        give
    for each y in 0 until 16
        for each x in 0 until 16
            new v i32 = 128
            if mode is 0
                v = top[x]
            else if mode is 1
                v = left[y]
            out[y * 16 + x] = v
    if mode is 2
        new sum i32 = 0
        new v i32 = 128
        if have_top and have_left
            for each i in 0 until 16
                sum += top[i] + left[i]
            v = (sum + 16) >> 5
        else if have_left
            for each i in 0 until 16
                sum += left[i]
            v = (sum + 8) >> 4
        else if have_top
            for each i in 0 until 16
                sum += top[i]
            v = (sum + 8) >> 4
        for each k in 0 until 256
            out[k] = v

to predc (d ptr h264state.decoder, m ptr h264state.mbinfo, c u64, out ptr i32)
    new a = h264state.left_of(d, d.mba)
    new b = h264state.top_of(d, d.mba)
    new have_top = b as u64 is not 0 and not (d.p.constrained and not b.intra)
    new have_left = a as u64 is not 0 and not (d.p.constrained and not a.intra)
    new top [8] i32
    new left [8] i32
    new px = (d.mbx / 2) as i64
    new py = (d.mby / 2) as i64
    if have_top
        new p = chroma_ptr(d, c, px, py - 1)
        for each i in 0 until 8
            top[i] = p[i] as i32
    if have_left
        for each i in 0 until 8
            left[i] = chroma_ptr(d, c, px - 1, py + i as i64)[0] as i32
    new mode = m.cmode
    if mode is 0
        for each by in 0 until 2
            for each bx in 0 until 2
                new st i32 = 0
                new sl i32 = 0
                for each i in 0 until 4
                    st += top[bx * 4 + i]
                    sl += left[by * 4 + i]
                new v i32 = 128
                if (bx is 0 and by is 0) or (bx is 1 and by is 1)
                    if have_top and have_left
                        v = (st + sl + 4) >> 3
                    else if have_left
                        v = (sl + 2) >> 2
                    else if have_top
                        v = (st + 2) >> 2
                else if bx is 1
                    if have_top
                        v = (st + 2) >> 2
                    else if have_left
                        v = (sl + 2) >> 2
                else
                    if have_left
                        v = (sl + 2) >> 2
                    else if have_top
                        v = (st + 2) >> 2
                for each y in 0 until 4
                    for each x in 0 until 4
                        out[(by * 4 + y) * 8 + bx * 4 + x] = v
        give
    if mode is 3
        new pp = chroma_ptr(d, c, px - 1, py - 1)[0] as i32
        new hs i32 = 0
        new vs i32 = 0
        for each x in 0 until 4
            new t2 = pp
            if x < 3
                t2 = top[2 - x]
            hs += (x as i32 + 1) * (top[4 + x] - t2)
            new l2 = pp
            if x < 3
                l2 = left[2 - x]
            vs += (x as i32 + 1) * (left[4 + x] - l2)
        new aa = 16 * (left[7] + top[7])
        new bb = (34 * hs + 32) >> 6
        new cc = (34 * vs + 32) >> 6
        for each y in 0 until 8
            for each x in 0 until 8
                out[y * 8 + x] = h264state.clip1((aa + bb * (x as i32 - 3) + cc * (y as i32 - 3) + 16) >> 5)
        give
    for each y in 0 until 8
        for each x in 0 until 8
            if mode is 1
                out[y * 8 + x] = left[y]
            else
                out[y * 8 + x] = top[x]

-- ---------------------------------------------------------------- whole macroblocks

-- Luma DC of an Intra 16x16 macroblock: inverse Hadamard and scaling, into d.dc.
to luma_dc (d ptr h264state.decoder, qp i32)
    new t [16] i32
    for each i in 0 until 4
        new a = d.dc[i * 4]
        new b = d.dc[i * 4 + 1]
        new c = d.dc[i * 4 + 2]
        new e = d.dc[i * 4 + 3]
        t[i * 4] = a + b + c + e
        t[i * 4 + 1] = a + b - c - e
        t[i * 4 + 2] = a - b - c + e
        t[i * 4 + 3] = a - b + c - e
    new ls = scale4(d, 0, qp, 0)
    new q6 = qp / 6
    for each j in 0 until 4
        new a = t[j]
        new b = t[4 + j]
        new c = t[8 + j]
        new e = t[12 + j]
        new f [4] i32
        f[0] = a + b + c + e
        f[1] = a + b - c - e
        f[2] = a - b - c + e
        f[3] = a - b + c - e
        for each i in 0 until 4
            new v = f[i]
            if qp >= 36
                v = (v * ls) << (q6 - 6) as u32
            else
                v = (v * ls + ((1 as i32) << (5 - q6) as u32)) >> (6 - q6) as u32
            d.dc[i * 4 + j] = v

-- Chroma of a macroblock: DC (2x2 transform) and AC; `pred` holds the prediction of
-- both planes (8x8 each); `inter` picks the inter scaling lists.
to chroma (d ptr h264state.decoder, m ptr h264state.mbinfo, pred ptr i32, inter bool)
    if m.cbp >> 4 is 0
        -- no residual: the prediction is the picture
        for each c in 0 until 2
            new dst = chroma_ptr(d, c, (d.mbx / 2) as i64, (d.mby / 2) as i64)
            add_block(dst, d.cur.cstride, pred + c * 64, 8, 0 as ptr i32, 8)
        give
    for each c in 0 until 2
        new qpc = m.qpc[c]
        new list = 1 + c
        if inter
            list = 4 + c
        new dc = addr of d.cdc[c * 4]
        new f [4] i32
        f[0] = dc[0] + dc[1] + dc[2] + dc[3]
        f[1] = dc[0] - dc[1] + dc[2] - dc[3]
        f[2] = dc[0] + dc[1] - dc[2] - dc[3]
        f[3] = dc[0] - dc[1] - dc[2] + dc[3]
        new ls = scale4(d, list, qpc, 0)
        new block [16] i32
        for each blk in 0 until 4
            new src = addr of d.cac[(c * 4 + blk) * 16]
            for each k in 0 until 16
                block[k] = src[k]
            block[0] = ((f[blk] * ls) << (qpc / 6) as u32) >> 5
            dequant4(d, addr of block[0], list, qpc, true)
            idct4(addr of block[0])
            new bx = (blk % 2) * 4
            new by = (blk / 2) * 4
            new dst = chroma_ptr(d, c, (d.mbx / 2 + bx) as i64, (d.mby / 2 + by) as i64)
            add_block(dst, d.cur.cstride, pred + c * 64 + by * 8 + bx, 8, addr of block[0], 4)

-- An intra macroblock (not PCM).
to intra (d ptr h264state.decoder, m ptr h264state.mbinfo)
    new qp = m.qp
    new pred [256] i32
    if m.kind is h264state.k_i16
        pred16(d, m, addr of pred[0])
        luma_dc(d, qp)
        for each blk in 0 until 16
            new c = addr of d.luma[blk * 16]
            new bx = (h264state.blk_x[blk] * 4) as u64
            new by = (h264state.blk_y[blk] * 4) as u64
            c[0] = d.dc[(by / 4) * 4 + bx / 4]
            dequant4(d, c, 0, qp, true)
            idct4(c)
            add_block(luma_ptr(d, (d.mbx + bx) as i64, (d.mby + by) as i64), d.cur.stride, addr of pred[by * 16 + bx], 16, c, 4)
    else if m.t8
        for each b8 in 0 until 4
            new bx = (b8 % 2) * 8
            new by = (b8 / 2) * 8
            new top [16] i32
            new left [8] i32
            new corner i32 = 0
            new flags = fetch(d, m, bx | (by << 8) | (8 << 16) | ((b8 * 4) << 24), addr of top[0], addr of left[0], addr of corner)
            filter8(addr of top[0], addr of left[0], addr of corner, flags)
            angular(m.modes[b8 * 4], 8, addr of top[0], addr of left[0], corner, flags, addr of pred[0])
            new res = 0 as ptr i32
            if ((m.cbp as u64) >> b8) & 1 is 1
                res = addr of d.luma8[b8 * 64]
                dequant8(d, res, 0, qp)
                idct8(res)
            add_block(luma_ptr(d, (d.mbx + bx) as i64, (d.mby + by) as i64), d.cur.stride, addr of pred[0], 16, res, 8)
    else
        for each blk in 0 until 16
            new bx = (h264state.blk_x[blk] * 4) as u64
            new by = (h264state.blk_y[blk] * 4) as u64
            new top [8] i32
            new left [4] i32
            new corner i32 = 0
            new flags = fetch(d, m, bx | (by << 8) | (4 << 16) | (blk << 24), addr of top[0], addr of left[0], addr of corner)
            angular(m.modes[blk], 4, addr of top[0], addr of left[0], corner, flags, addr of pred[0])
            new res = 0 as ptr i32
            if (m.nz >> blk as u32) & 1 is 1
                res = addr of d.luma[blk * 16]
                dequant4(d, res, 0, qp, false)
                idct4(res)
            add_block(luma_ptr(d, (d.mbx + bx) as i64, (d.mby + by) as i64), d.cur.stride, addr of pred[0], 16, res, 4)
    new cpred [128] i32
    predc(d, m, 0, addr of cpred[0])
    predc(d, m, 1, addr of cpred[64])
    chroma(d, m, addr of cpred[0], false)

-- An inter macroblock: d.pred_y / d.pred_c hold the prediction.
to inter (d ptr h264state.decoder, m ptr h264state.mbinfo)
    new qp = m.qp
    new skipped = m.kind is h264state.k_skip
    if m.t8 and not skipped
        for each b8 in 0 until 4
            new bx = (b8 % 2) * 8
            new by = (b8 / 2) * 8
            new res = 0 as ptr i32
            if ((m.cbp as u64) >> b8) & 1 is 1
                res = addr of d.luma8[b8 * 64]
                dequant8(d, res, 1, qp)
                idct8(res)
            add_block(luma_ptr(d, (d.mbx + bx) as i64, (d.mby + by) as i64), d.cur.stride, addr of d.pred_y[by * 16 + bx], 16, res, 8)
    else
        for each blk in 0 until 16
            new bx = (h264state.blk_x[blk] * 4) as u64
            new by = (h264state.blk_y[blk] * 4) as u64
            new res = 0 as ptr i32
            if not skipped and (m.nz >> blk as u32) & 1 is 1
                res = addr of d.luma[blk * 16]
                dequant4(d, res, 3, qp, false)
                idct4(res)
            add_block(luma_ptr(d, (d.mbx + bx) as i64, (d.mby + by) as i64), d.cur.stride, addr of d.pred_y[by * 16 + bx], 16, res, 4)
    if skipped
        for each c in 0 until 2
            for each blk in 0 until 4
                new bx = (blk % 2) * 4
                new by = (blk / 2) * 4
                new dst = chroma_ptr(d, c, (d.mbx / 2 + bx) as i64, (d.mby / 2 + by) as i64)
                add_block(dst, d.cur.cstride, addr of d.pred_c[c * 64 + by * 8 + bx], 8, 0 as ptr i32, 4)
        give
    chroma(d, m, addr of d.pred_c[0], true)
